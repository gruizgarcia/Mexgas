    SHIFT lv RIGHT DELETING TRAILING space.
    rv_text = lv.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->UPDATE_TEXT
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BELNR                       TYPE        ZFID_NOPER
* | [--->] IV_GJAHR                       TYPE        GJAHR
* | [--->] IV_BUKRS                       TYPE        BUKRS
* | [--->] IV_UUID                        TYPE        ZUUID
* | [--->] IV_TDOBJECT                    TYPE        TDOBJECT(optional)
* | [<---] EV_SUCCESS                     TYPE        FLAG
* | [<---] EV_MESSAGE                     TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD update_text.
    DATA: lw_header    TYPE thead,
          lw_line      TYPE tline,
          lt_lines     TYPE STANDARD TABLE OF tline,
          lv_documento TYPE tdobname,
          lv_subrc     TYPE sy-subrc,
          lv_line      TYPE string.

    CLEAR: ev_success, ev_message.

    "---- Validaciones mínimas
    IF iv_bukrs IS INITIAL OR iv_belnr IS INITIAL OR
       iv_gjahr IS INITIAL OR iv_uuid IS INITIAL.
      ev_message = 'Error: parámetros obligatorios vacíos (BUKRS, BELNR, GJAHR, UUID)'.
      RETURN.
    ENDIF.

    " Nombre del texto
    CONCATENATE iv_bukrs iv_belnr iv_gjahr INTO lv_documento.
    CONDENSE lv_documento.

    " Cabecera del texto (misma lógica que el FM)
    IF iv_tdobject IS INITIAL.
      lw_header-tdobject = 'BELEG'.
      lw_header-tdid     = 'YUUD'.
      lw_header-tdname   = lv_documento.
    ELSE.
      lw_header-tdobject = iv_tdobject.
      lw_header-tdid     = 'ZUUI'.
      lw_header-tdname   = iv_belnr.
    ENDIF.
    lw_header-tdspras  = sy-langu.

    " Línea única con el UUID
    CLEAR lw_line.
    lw_line-tdformat = 'ST'.
    lw_line-tdline   = iv_uuid.
    APPEND lw_line TO lt_lines.

    " Guardar texto
    CALL FUNCTION 'SAVE_TEXT'
      EXPORTING
        client          = sy-mandt
        header          = lw_header
        insert          = 'X'
        savemode_direct = 'X'
      TABLES
        lines           = lt_lines
      EXCEPTIONS
        id              = 1
        language        = 2
        name            = 3
        object          = 4
        OTHERS          = 5.

    lv_subrc = sy-subrc.
    CONCATENATE 'IV_BELNR:' iv_belnr INTO lv_line SEPARATED BY space.

    IF lv_subrc = 0.
      CALL FUNCTION 'COMMIT_TEXT'.
      ev_success = abap_true.
      CONCATENATE 'Texto guardado:' lv_line INTO ev_message SEPARATED BY space.
    ELSE.
      CASE lv_subrc.
        WHEN 1.  ev_message = 'Error: ID de texto no válido.'.
        WHEN 2.  ev_message = 'Error: idioma no válido.'.
        WHEN 3.  ev_message = 'Error: nombre de texto no válido.'.
        WHEN 4.  ev_message = 'Error: objeto de texto no válido.'.
        WHEN OTHERS.
          ev_message = 'Error desconocido al guardar el texto.'.
      ENDCASE.

      " Añade contexto
      CONCATENATE ev_message lv_line
                  INTO ev_message SEPARATED BY cl_abap_char_utilities=>newline.
      CONCATENATE 'Año:'   iv_gjahr INTO lv_line SEPARATED BY space.
      CONCATENATE ev_message lv_line INTO ev_message SEPARATED BY cl_abap_char_utilities=>newline.
      CONCATENATE 'Bukrs:' iv_bukrs INTO lv_line SEPARATED BY space.
      CONCATENATE ev_message lv_line INTO ev_message SEPARATED BY cl_abap_char_utilities=>newline.
      CONCATENATE 'UUID:'  iv_uuid  INTO lv_line SEPARATED BY space.
      CONCATENATE ev_message lv_line INTO ev_message SEPARATED BY cl_abap_char_utilities=>newline.
    ENDIF.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->UPSERT_TABLE_Z_FROM_XML
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_XML_TIMB                    TYPE        STRING
* | [--->] IV_BUKRS                       TYPE        BUKRS
* | [--->] IV_BELNR                       TYPE        ZDOCTO_EKA
* | [--->] IV_GJAHR                       TYPE        GJAHR
* | [<---] EV_SUCCESS                     TYPE        ABAP_BOOL
* | [<---] EV_MESSAGE                     TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD upsert_table_z_from_xml.
* ============================
*  Inserta/actualiza HEAD/DET desde un XML timbrado (STRING)
*  y regresa sólo:
*     ev_success (X / ' ')
*     ev_message  ('Insert Completo' / 'Error Insert')
*
*  IMPORTING iv_xml_timb TYPE string
*            iv_bukrs    TYPE bukrs
*            iv_belnr    TYPE zdocto_eka   " o char30/belnr_d según tu DDIC
*            iv_gjahr    TYPE gjahr
*  EXPORTING ev_success  TYPE abap_bool
*            ev_message  TYPE string
* ============================
    TYPE-POOLS: abap.    " MATCH_RESULT / MATCH_RESULT_TAB

    DATA lv_has_error TYPE abap_bool VALUE abap_false.

    "---- 0) Validación mínima
    IF iv_xml_timb IS INITIAL OR iv_bukrs IS INITIAL OR iv_belnr IS INITIAL OR iv_gjahr IS INITIAL.
      ev_success = abap_false.
      ev_message = 'Error Insert'.
      RETURN.
    ENDIF.

    "---- 1) HEAD existente o nuevo
    DATA: ls_head   TYPE zcfdi_head_40,
          lv_exists TYPE c VALUE ' '.
    SELECT SINGLE * INTO ls_head
      FROM zcfdi_head_40
      WHERE bukrs = iv_bukrs
        AND belnr = iv_belnr
        AND gjahr = iv_gjahr.
    IF sy-subrc = 0.
      lv_exists = 'X'.
    ELSE.
      CLEAR ls_head.
      ls_head-mandt = sy-mandt.
      ls_head-bukrs = iv_bukrs.
      ls_head-belnr = iv_belnr.
      ls_head-gjahr = iv_gjahr.
    ENDIF.

    "---- 2) Limpieza segura del XML
    DATA lv_xml TYPE string.
    lv_xml = iv_xml_timb.
    IF lv_xml IS NOT INITIAL.
      IF lv_xml CS cl_abap_char_utilities=>cr_lf.
        REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf   IN lv_xml WITH ''.
      ENDIF.
      IF lv_xml CS cl_abap_char_utilities=>newline.
        REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>newline IN lv_xml WITH ''.
      ENDIF.
      IF lv_xml CS '#'.
        REPLACE ALL OCCURRENCES OF '#' IN lv_xml WITH ''.
      ENDIF.
    ENDIF.

    DATA lv_off_root TYPE i.
    FIND FIRST OCCURRENCE OF '<cfdi:Comprobante' IN lv_xml MATCH OFFSET lv_off_root.
    IF sy-subrc = 0 AND lv_off_root > 0.
      lv_xml = lv_xml+lv_off_root.
    ENDIF.

    "---- 3) Helpers
    FIELD-SYMBOLS: <fh>   TYPE any,
                   <fxml> TYPE xstring.

    DEFINE set_always. " Asigna si viene valor
      ASSIGN COMPONENT &1 OF STRUCTURE ls_head TO <fh>.
      IF sy-subrc = 0 AND <fh> IS ASSIGNED AND &2 IS NOT INITIAL.
        <fh> = &2.
      ENDIF.
    END-OF-DEFINITION.

    DEFINE set_if_empty. " Asigna si está vacío
      ASSIGN COMPONENT &1 OF STRUCTURE ls_head TO <fh>.
      IF sy-subrc = 0 AND <fh> IS ASSIGNED.
        IF <fh> IS INITIAL AND &2 IS NOT INITIAL.
          <fh> = &2.
        ENDIF.
      ENDIF.
    END-OF-DEFINITION.

    DATA: v_block     TYPE string,
          v_val1      TYPE string,
          gv_pat_tag  TYPE string,
          gv_pat_attr TYPE string,
          gv_off      TYPE i,
          gv_len      TYPE i.

    DEFINE get_attr. " Atributo de la 1a etiqueta &1
      CLEAR: v_block, &3, gv_pat_tag, gv_pat_attr, gv_off, gv_len.
      CONCATENATE '<' &1 '[^>]*>' INTO gv_pat_tag.
      FIND FIRST OCCURRENCE OF REGEX gv_pat_tag IN lv_xml MATCH OFFSET gv_off MATCH LENGTH gv_len.
      IF sy-subrc = 0 AND gv_len > 0.
        v_block = lv_xml+gv_off(gv_len).
        CONCATENATE &2 '="([^"]*)"' INTO gv_pat_attr.
        FIND REGEX gv_pat_attr IN v_block SUBMATCHES &3.
        IF sy-subrc <> 0.
          CONCATENATE &2 '=''' '([^'']*)' '''' INTO gv_pat_attr.
          FIND REGEX gv_pat_attr IN v_block SUBMATCHES &3.
        ENDIF.
      ENDIF.
    END-OF-DEFINITION.

    "---- 4) HEAD desde Comprobante/Emisor/Receptor/Impuestos/TFD
    ASSIGN COMPONENT 'XML_TIMB' OF STRUCTURE ls_head TO <fxml>.
    IF sy-subrc = 0 AND <fxml> IS ASSIGNED AND <fxml> IS INITIAL AND lv_xml IS NOT INITIAL.
      DATA lx_xml TYPE xstring.
      CALL FUNCTION 'ECATT_CONV_STRING_TO_XSTRING'
        EXPORTING
          im_string   = lv_xml
          im_encoding = 'UTF-8'
        IMPORTING
          ex_xstring  = lx_xml
        EXCEPTIONS
          OTHERS      = 1.
      IF sy-subrc = 0.
        <fxml> = lx_xml.
      ENDIF.
    ENDIF.

    " --- Comprobante
    get_attr 'cfdi:Comprobante' 'Version'           v_val1. set_if_empty 'VERSION'        v_val1.
    get_attr 'cfdi:Comprobante' 'Serie'             v_val1. set_always  'SERIE_XML'      v_val1.
    get_attr 'cfdi:Comprobante' 'Folio'             v_val1. set_if_empty 'FOLIO_XML'      v_val1.
    get_attr 'cfdi:Comprobante' 'LugarExpedicion'   v_val1. set_if_empty 'LUGAR_EXP'      v_val1.
    get_attr 'cfdi:Comprobante' 'TipoDeComprobante' v_val1.
    IF v_val1 IS NOT INITIAL.
      DATA lv_tc_char TYPE char1.
      lv_tc_char = v_val1+0(1).
      set_if_empty 'TIPO_COMP' lv_tc_char.
    ENDIF.
    get_attr 'cfdi:Comprobante' 'SubTotal'          v_val1. set_if_empty 'SUBTOTAL'       v_val1.
    get_attr 'cfdi:Comprobante' 'Descuento'         v_val1. set_if_empty 'DESCUENTO'      v_val1.
    get_attr 'cfdi:Comprobante' 'Total'             v_val1. set_if_empty 'TOTAL'          v_val1.
    get_attr 'cfdi:Comprobante' 'Moneda'            v_val1.
    IF v_val1 IS NOT INITIAL.
      set_if_empty 'WAERS' v_val1.
      set_if_empty 'MONEDAXML' v_val1.
    ENDIF.
    get_attr 'cfdi:Comprobante' 'TipoCambio'        v_val1.
    IF v_val1 IS NOT INITIAL.
      set_always 'TIPO_CAMBIO'    v_val1.
      set_always 'TIPOCAMBIOXML'  v_val1.
    ENDIF.
    get_attr 'cfdi:Comprobante' 'MetodoPago'        v_val1. set_if_empty 'METODO_PAGO'    v_val1.
    get_attr 'cfdi:Comprobante' 'FormaPago'         v_val1.
    IF v_val1 IS NOT INITIAL.
      DATA lv_fp TYPE string.
      lv_fp = v_val1.
      IF strlen( lv_fp ) >= 2.
        lv_fp = lv_fp+0(2).
      ENDIF.
      set_always 'FORMA_PAGO' lv_fp.
    ENDIF.
    get_attr 'cfdi:Comprobante' 'Exportacion'       v_val1. set_if_empty 'EXPORTACION'    v_val1.
    get_attr 'cfdi:Comprobante' 'NoCertificado'     v_val1. set_if_empty 'NOCERTIFICADO'  v_val1.
    get_attr 'cfdi:Comprobante' 'Fecha'             v_val1.
    IF v_val1 IS NOT INITIAL.
      set_if_empty 'FECHAFACT' v_val1.
      DATA lv_y   TYPE string.
      DATA lv_m   TYPE string.
      DATA lv_d   TYPE string.
      DATA lv_h   TYPE string.
      DATA lv_min TYPE string.
      DATA lv_s   TYPE string.
      FIND REGEX '([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})'
           IN v_val1 SUBMATCHES lv_y lv_m lv_d lv_h lv_min lv_s.
      IF sy-subrc = 0.
        DATA lv_bldat_str TYPE string.
        DATA lv_uzeit_str TYPE string.
        CONCATENATE lv_y lv_m lv_d INTO lv_bldat_str.
        CONCATENATE lv_h lv_min lv_s INTO lv_uzeit_str.
        set_if_empty 'BLDAT' lv_bldat_str.
        set_if_empty 'UZEIT' lv_uzeit_str.
      ENDIF.
    ENDIF.

    " === Forzar tipo de cambio = 1.00 si Moneda = MXN
    DATA lv_mon_xml TYPE string.
    DATA lv_tc_num  TYPE p LENGTH 9 DECIMALS 5.
    DATA lv_tc_str  TYPE string.
    CLEAR: lv_tc_num, lv_tc_str.
    get_attr 'cfdi:Comprobante' 'Moneda' lv_mon_xml.
    IF lv_mon_xml IS INITIAL.
      lv_mon_xml = ls_head-waers.
    ENDIF.
    TRANSLATE lv_mon_xml TO UPPER CASE.
    CONDENSE lv_mon_xml NO-GAPS.
    IF lv_mon_xml = 'MXN'.
      lv_tc_num = '1'.
      lv_tc_str = |{ CONV decfloat34( lv_tc_num ) DECIMALS = 2 }|.
      REPLACE ALL OCCURRENCES OF ',' IN lv_tc_str WITH '.'.  " texto con punto
      set_always 'TIPO_CAMBIO'   lv_tc_num.  " numérico 1.00000
      set_always 'TIPOCAMBIOXML' lv_tc_str.  " texto '1.00'
    ENDIF.

    " --- Emisor / Receptor
    get_attr 'cfdi:Emisor'   'Rfc'           v_val1. set_if_empty 'RFC_EMISOR'     v_val1.
    get_attr 'cfdi:Emisor'   'Nombre'        v_val1. set_if_empty 'NOMBRE_EMISOR'  v_val1.
    get_attr 'cfdi:Emisor'   'RegimenFiscal' v_val1. set_if_empty 'REGIMEN_FISCAL' v_val1.

    get_attr 'cfdi:Receptor' 'Rfc'                   v_val1. set_if_empty 'RFC_RECEPTOR'          v_val1.
    get_attr 'cfdi:Receptor' 'Nombre'                v_val1. set_if_empty 'NOMBRE_RECEPTOR'       v_val1.
    get_attr 'cfdi:Receptor' 'UsoCFDI'               v_val1. set_if_empty 'USO_CFDI'              v_val1.
    get_attr 'cfdi:Receptor' 'RegimenFiscalReceptor' v_val1. set_if_empty 'REGIMENFISCALRECEPTOR' v_val1.

    " --- Impuestos globales
    CLEAR v_val1.
    FIND REGEX '<cfdi:Impuestos[^>]*TotalImpuestosTrasladados="([^"]+)"'
         IN lv_xml SUBMATCHES v_val1. set_if_empty 'TOTAL_IVA' v_val1.
    CLEAR v_val1.
    FIND REGEX '<cfdi:Impuestos[^>]*TotalImpuestosRetenidos="([^"]+)"'
         IN lv_xml SUBMATCHES v_val1. set_if_empty 'TOTAL_RET' v_val1.

    " --- TFD (IGNORING CASE) + FECHA/HORA timbrado
    DATA lv_uuid_tfd  TYPE string.
    DATA lv_sello_sat TYPE string.
    DATA lv_sello_cfd TYPE string.
    DATA lv_pac_rfc   TYPE string.
    DATA lv_nocersat  TYPE string.
    DATA lv_ver_tfd   TYPE string.
    DATA lv_fecha_tfd TYPE string.

    FIND REGEX 'TimbreFiscalDigital[^>]*UUID="([^"]+)"'
         IN lv_xml SUBMATCHES lv_uuid_tfd IGNORING CASE.
    FIND REGEX 'TimbreFiscalDigital[^>]*SelloSAT="([^"]+)"'
         IN lv_xml SUBMATCHES lv_sello_sat IGNORING CASE.
    FIND REGEX 'TimbreFiscalDigital[^>]*SelloCFD="([^"]+)"'
         IN lv_xml SUBMATCHES lv_sello_cfd IGNORING CASE.
    FIND REGEX 'TimbreFiscalDigital[^>]*RfcProvCertif="([^"]+)"'
         IN lv_xml SUBMATCHES lv_pac_rfc IGNORING CASE.
    FIND REGEX 'TimbreFiscalDigital[^>]*NoCertificadoSAT="([^"]+)"'
         IN lv_xml SUBMATCHES lv_nocersat IGNORING CASE.
    FIND REGEX 'TimbreFiscalDigital[^>]*Version="([^"]+)"'
         IN lv_xml SUBMATCHES lv_ver_tfd IGNORING CASE.
    FIND REGEX 'TimbreFiscalDigital[^>]*FechaTimbrado="([^"]+)"'
         IN lv_xml SUBMATCHES lv_fecha_tfd IGNORING CASE.

    set_if_empty 'UUID'             lv_uuid_tfd.
    set_if_empty 'SELLO_SAT'        lv_sello_sat.
    set_if_empty 'SELLO_CFD'        lv_sello_cfd.
    set_if_empty 'RFCPROVCERTIF'    lv_pac_rfc.
    set_if_empty 'NOCERTIFICADOSAT' lv_nocersat.
    set_if_empty 'FECHATIMBRADOS'   lv_fecha_tfd.

    IF lv_fecha_tfd IS NOT INITIAL.
      DATA lv_ty TYPE string.
      DATA lv_tm TYPE string.
      DATA lv_td TYPE string.
      DATA lv_th TYPE string.
      DATA lv_tn TYPE string.
      DATA lv_ts TYPE string.
      FIND REGEX '([0-9]{4})-?([0-9]{2})-?([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})'
           IN lv_fecha_tfd SUBMATCHES lv_ty lv_tm lv_td lv_th lv_tn lv_ts.
      IF sy-subrc = 0.
        DATA lv_fechat TYPE string.
        DATA lv_horat  TYPE string.
        CONCATENATE lv_ty lv_tm lv_td INTO lv_fechat.
        CONCATENATE lv_th lv_tn lv_ts INTO lv_horat.
        set_always 'FECHA_TIMBRADO' lv_fechat.
        set_always 'HORA_TIMBRADO'  lv_horat.
      ENDIF.
    ENDIF.

    " --- CadenaOriginal (varias variantes)
    DATA lv_cad_attr     TYPE string.
    DATA lv_cad_tag      TYPE string.
    DATA lv_cad_pat      TYPE string.
    DATA lv_cadena_final TYPE string.
    CLEAR: lv_cad_attr, lv_cad_tag, lv_cad_pat.
    FIND REGEX ' CadenaOriginal="([^"]*)"'      IN lv_xml SUBMATCHES lv_cad_attr IGNORING CASE.
    IF lv_cad_attr IS INITIAL.
      FIND REGEX ' OriginalString="([^"]*)"'    IN lv_xml SUBMATCHES lv_cad_attr IGNORING CASE.
    ENDIF.
    IF lv_cad_attr IS INITIAL.
      FIND REGEX ' CadenaOriginalTFD="([^"]*)"' IN lv_xml SUBMATCHES lv_cad_attr IGNORING CASE.
    ENDIF.
    IF lv_cad_attr IS INITIAL.
      FIND REGEX '<[A-Za-z0-9_:-]*CadenaOriginal[^>]*>([^<]+)</[A-Za-z0-9_:-]*CadenaOriginal>'
           IN lv_xml SUBMATCHES lv_cad_tag IGNORING CASE.
    ENDIF.
    IF lv_cad_attr IS INITIAL AND lv_cad_tag IS INITIAL.
      FIND REGEX '<[A-Za-z0-9_:-]*OriginalString[^>]*>([^<]+)</[A-Za-z0-9_:-]*OriginalString>'
           IN lv_xml SUBMATCHES lv_cad_tag IGNORING CASE.
    ENDIF.
    IF lv_cad_attr IS INITIAL AND lv_cad_tag IS INITIAL.
      FIND REGEX '(\|\|1\.[01]\|.{1,500}\|\|)' IN lv_xml SUBMATCHES lv_cad_pat.
    ENDIF.
    IF lv_cad_attr IS NOT INITIAL.
      lv_cadena_final = lv_cad_attr.
    ELSEIF lv_cad_tag IS NOT INITIAL.
      lv_cadena_final = lv_cad_tag.
    ELSE.
      lv_cadena_final = lv_cad_pat.
    ENDIF.
    set_if_empty 'CADENA_ORIGINAL' lv_cadena_final.

    "---- 4.1) VBRK/VBFA: VKORG, VTWEG, SPART, KUNNR, FACTURA, PEDIDOCTE, TIPO_DOC
    DATA lv_belnr10 TYPE vbrk-vbeln.
    DATA ls_vbrk    TYPE vbrk.
    DATA lv_pedido  TYPE vbak-vbeln.

    lv_belnr10 = iv_belnr.
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = lv_belnr10
      IMPORTING
        output = lv_belnr10.

    SELECT SINGLE * INTO ls_vbrk FROM vbrk WHERE vbeln = lv_belnr10.
    IF sy-subrc = 0.
      set_always 'VKORG'   ls_vbrk-vkorg.
      set_always 'VTWEG'   ls_vbrk-vtweg.
      set_always 'SPART'   ls_vbrk-spart.
      set_always 'FACTURA' lv_belnr10.

      DATA lv_kunnr10 TYPE kunnr.
      lv_kunnr10 = ls_vbrk-kunag.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = lv_kunnr10
        IMPORTING
          output = lv_kunnr10.
      set_always 'KUNNR' lv_kunnr10.

      FIELD-SYMBOLS <fv> TYPE any.
      ASSIGN COMPONENT 'VBELN_VA' OF STRUCTURE ls_vbrk TO <fv>.
      CLEAR lv_pedido.
      IF sy-subrc = 0 AND <fv> IS ASSIGNED AND <fv> IS NOT INITIAL.
        lv_pedido = <fv>.
        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
          EXPORTING
            input  = lv_pedido
          IMPORTING
            output = lv_pedido.
      ELSE.
        SELECT SINGLE vbeln INTO lv_pedido
          FROM vbfa
          WHERE vbelv   = lv_belnr10
            AND vbtyp_n = 'M'
            AND vbtyp_v = 'C'.
        IF sy-subrc = 0.
          CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
            EXPORTING
              input  = lv_pedido
            IMPORTING
              output = lv_pedido.
        ENDIF.
      ENDIF.
      IF lv_pedido IS NOT INITIAL.
        set_always 'PEDIDOCTE' lv_pedido.
      ENDIF.

      " Derivar TIPO_DOC si sigue vacío
      DATA lv_tipodoc TYPE ztip_docto.
      CLEAR lv_tipodoc.
      ASSIGN COMPONENT 'TIPO_COMP' OF STRUCTURE ls_head TO <fh>.
      IF sy-subrc = 0 AND <fh> IS ASSIGNED.
        DATA lv_tipoc TYPE char1.
        lv_tipoc = <fh>.
        CASE lv_tipoc.
          WHEN 'I'. lv_tipodoc = 'FA'.
          WHEN 'E'. lv_tipodoc = 'NC'.
          WHEN 'T'. lv_tipodoc = 'TR'.
          WHEN 'N'. lv_tipodoc = 'NO'.
          WHEN 'P'. lv_tipodoc = 'PA'.
        ENDCASE.
        IF lv_tipodoc IS NOT INITIAL.
          set_if_empty 'TIPO_DOC' lv_tipodoc.
        ENDIF.
      ENDIF.
    ENDIF.

    "---- 4.2) QR SAT — firma real de ZMFCFDI40_QR
    DATA lv_tt6        TYPE string.
    DATA lv_tt6_padded TYPE string.
    DATA lv_fe8        TYPE string.
    DATA lv_qr         TYPE string.
    DATA lv_totdf      TYPE decfloat34.
    DATA lv_extranjero TYPE c LENGTH 1.
    CLEAR: lv_tt6, lv_tt6_padded, lv_fe8, lv_qr, lv_totdf, lv_extranjero.

    IF ls_head-total IS NOT INITIAL.
      lv_totdf = CONV decfloat34( ls_head-total ).
      lv_tt6   = |{ lv_totdf DECIMALS = 6 }|.
      REPLACE ALL OCCURRENCES OF ',' IN lv_tt6 WITH '.'. " SAT usa punto
    ENDIF.

    lv_tt6_padded = lv_tt6.
    WHILE lv_tt6_padded IS NOT INITIAL AND strlen( lv_tt6_padded ) < 17.
      CONCATENATE '0' lv_tt6_padded INTO lv_tt6_padded.
    ENDWHILE.

    lv_fe8 = ls_head-sello_cfd.
    IF lv_fe8 IS NOT INITIAL.
      REPLACE ALL OCCURRENCES OF REGEX '[[:space:]]+' IN lv_fe8 WITH ''.
      DATA lv_len TYPE i.
      DATA lv_off8 TYPE i.
      lv_len = strlen( lv_fe8 ).
      IF lv_len >= 8.
        lv_off8 = lv_len - 8.
        lv_fe8  = lv_fe8+lv_off8(8).
      ENDIF.
    ENDIF.

    CLEAR lv_extranjero.
    IF ls_head-rfc_receptor = 'XEXX010101000' OR ls_head-rfc_receptor = 'XAXX010101000'.
      lv_extranjero = 'X'.
    ENDIF.

    " Variables tipadas explícitamente para coincidir con la interfaz del FM
    DATA lv_puuid       TYPE char36.
    DATA lv_rfc_emisor  TYPE char13.
    DATA lv_rfc_recept  TYPE char13.
    DATA lv_ptotal      TYPE c LENGTH 17.
    DATA lv_fe8_c       TYPE c LENGTH 8.
    DATA lv_purl        TYPE string.

    lv_puuid      = ls_head-uuid.
    lv_rfc_emisor = ls_head-rfc_emisor.
    lv_rfc_recept = ls_head-rfc_receptor.
    IF lv_tt6_padded IS NOT INITIAL.
      lv_ptotal = lv_tt6_padded.
    ELSE.
      lv_ptotal = lv_tt6.
    ENDIF.
    lv_fe8_c = lv_fe8.

    CALL FUNCTION 'ZMFCFDI40_QR'
      EXPORTING
        puuid        = lv_puuid
        rfc_emisor   = lv_rfc_emisor
        rfc_receptor = lv_rfc_recept
        pextranjero  = lv_extranjero
        ptotal       = lv_ptotal        " <- CHAR(17) con ceros a la izquierda
        pselloemisor = lv_fe8_c         " <- CHAR(8) últimos 8 del sello CFD
      IMPORTING
        purl         = lv_purl
      EXCEPTIONS
        OTHERS       = 1.

    IF lv_purl IS INITIAL
       AND ls_head-uuid         IS NOT INITIAL
       AND ls_head-rfc_emisor   IS NOT INITIAL
       AND ls_head-rfc_receptor IS NOT INITIAL
       AND lv_tt6               IS NOT INITIAL
       AND lv_fe8               IS NOT INITIAL.
      lv_qr = |https://verificacfdi.facturaelectronica.sat.gob.mx/default.aspx| &&
              |?id={ ls_head-uuid }| &&
              |&re={ ls_head-rfc_emisor }| &&
              |&rr={ ls_head-rfc_receptor }| &&
              |&tt={ lv_tt6 }| &&
              |&fe={ lv_fe8 }|.
    ELSE.
      lv_qr = lv_purl.
    ENDIF.
    IF lv_qr IS NOT INITIAL.
      set_always 'QR' lv_qr.
    ENDIF.

    "=== Status por UUID
    IF ls_head-status IS INITIAL.
      ls_head-status = COND char1( WHEN ls_head-uuid IS INITIAL THEN 'E' ELSE 'T' ).
    ENDIF.

    "---- 5) Persistir HEAD
    IF lv_exists = 'X'.
      MODIFY zcfdi_head_40 FROM ls_head.
      IF sy-subrc <> 0.
        lv_has_error = abap_true.
      ENDIF.
    ELSE.
      INSERT zcfdi_head_40 FROM ls_head.
      IF sy-subrc <> 0.
        lv_has_error = abap_true.
      ENDIF.
    ENDIF.

    "---- 6) DETALLE: borrar e insertar por <cfdi:Concepto>
    DELETE FROM zcfdi_det_40
      WHERE bukrs = iv_bukrs
        AND belnr = iv_belnr
        AND gjahr = iv_gjahr.

    DATA: lt_conc      TYPE match_result_tab,
          ls_conc      TYPE match_result,
          lt_close_all TYPE match_result_tab,
          ls_close     TYPE match_result.

    FIND ALL OCCURRENCES OF REGEX '<cfdi:Concepto\b[^>]*>' IN lv_xml RESULTS lt_conc.
    FIND ALL OCCURRENCES OF REGEX '</cfdi:Concepto>'        IN lv_xml RESULTS lt_close_all.

    DATA: ls_det        TYPE zcfdi_det_40,
          lv_buzei      TYPE i VALUE 0,
          lv_end_off    TYPE i,
          lv_off_s      TYPE i,
          lv_len_s      TYPE i,
          lv_open       TYPE string,
          lv_conc_block TYPE string.

    FIELD-SYMBOLS <fd> TYPE any.
    DATA v TYPE string.

    DEFINE map_attr.
      CLEAR v.
      CONCATENATE ' ' &1 '="([^"]*)"' INTO gv_pat_attr.
      FIND REGEX gv_pat_attr IN lv_open SUBMATCHES v.
      IF sy-subrc <> 0.
        CONCATENATE ' ' &1 '=''' '([^'']*)' '''' INTO gv_pat_attr.
        FIND REGEX gv_pat_attr IN lv_open SUBMATCHES v.
      ENDIF.
      IF v IS NOT INITIAL.
        ASSIGN COMPONENT &2 OF STRUCTURE ls_det TO <fd>.
        IF sy-subrc = 0 AND <fd> IS ASSIGNED. <fd> = v. ENDIF.
      ENDIF.
    END-OF-DEFINITION.

    DATA: lt_tr  TYPE match_result_tab,
          ls_tr  TYPE match_result,
          lv_tr  TYPE string,
          v_imp  TYPE string,
          v_base TYPE string,
          v_tipo TYPE string,
          v_tasa TYPE string,
          v_iva  TYPE string.

    DATA lv_cnt_ins TYPE i VALUE 0.

    LOOP AT lt_conc INTO ls_conc.
      CLEAR: ls_det, lv_end_off, lv_open, lv_conc_block.

      " Llaves y POS
      ls_det-bukrs = iv_bukrs.
      ls_det-belnr = iv_belnr.
      ls_det-gjahr = iv_gjahr.
      lv_buzei = lv_buzei + 10.
      ASSIGN COMPONENT 'BUZEI' OF STRUCTURE ls_det TO <fd>.
      IF sy-subrc = 0 AND <fd> IS ASSIGNED. <fd> = lv_buzei. ENDIF.
      ASSIGN COMPONENT 'POSNR' OF STRUCTURE ls_det TO <fd>.
      IF sy-subrc = 0 AND <fd> IS ASSIGNED AND <fd> IS INITIAL. <fd> = lv_buzei. ENDIF.

      " Apertura del concepto
      lv_off_s = ls_conc-offset.
      lv_len_s = ls_conc-length.
      lv_open  = lv_xml+lv_off_s(lv_len_s).

      " Bloque completo (hasta cierre siguiente)
      lv_end_off = 0.
      LOOP AT lt_close_all INTO ls_close.
        IF ls_close-offset > ls_conc-offset.
          lv_end_off = ls_close-offset + ls_close-length.
          EXIT.
        ENDIF.
      ENDLOOP.
      IF lv_end_off > 0.
        lv_off_s  = ls_conc-offset.
        lv_len_s  = lv_end_off - ls_conc-offset.
        IF lv_len_s > 0.
          lv_conc_block = lv_xml+lv_off_s(lv_len_s).
        ELSE.
          lv_conc_block = lv_open.
        ENDIF.
      ELSE.
        lv_conc_block = lv_open.
      ENDIF.

      " Atributos del concepto
      map_attr 'ClaveProdServ'    'CLAVEPRODSERV'.
      map_attr 'NoIdentificacion' 'NOIDENTIFICACION'.
      map_attr 'ClaveUnidad'      'CLAVEUNIDAD'.
      map_attr 'Cantidad'         'CANTIDAD'.
      map_attr 'Descripcion'      'DESCRIPCION'.
      map_attr 'ValorUnitario'    'VALOR_UNITARIO'.
      map_attr 'Importe'          'IMPORTE'.
      map_attr 'ObjetoImp'        'OBJETOIMP'.

      " Impuestos (solo IVA=002)
      CLEAR lt_tr.
      FIND ALL OCCURRENCES OF REGEX '<cfdi:Traslado\b[^>]*/>' IN lv_conc_block RESULTS lt_tr.
      IF lt_tr IS INITIAL.
        FIND ALL OCCURRENCES OF REGEX '<cfdi:Traslado\b[^>]*>' IN lv_conc_block RESULTS lt_tr.
      ENDIF.

      LOOP AT lt_tr INTO ls_tr.
        CLEAR: lv_tr, v_imp, v_base, v_tipo, v_tasa, v_iva.
        lv_off_s = ls_tr-offset.
        lv_len_s = ls_tr-length.
        lv_tr    = lv_conc_block+lv_off_s(lv_len_s).

        FIND REGEX ' Impuesto="([^"]*)"' IN lv_tr SUBMATCHES v_imp.
        IF sy-subrc = 0 AND v_imp = '002'.
          FIND REGEX ' Base="([^"]*)"'       IN lv_tr SUBMATCHES v_base.
          FIND REGEX ' TipoFactor="([^"]*)"' IN lv_tr SUBMATCHES v_tipo.
          FIND REGEX ' TasaOCuota="([^"]*)"' IN lv_tr SUBMATCHES v_tasa.
          FIND REGEX ' Importe="([^"]*)"'    IN lv_tr SUBMATCHES v_iva.
          ASSIGN COMPONENT 'BASE'        OF STRUCTURE ls_det TO <fd>.
          IF sy-subrc = 0 AND <fd> IS ASSIGNED AND v_base IS NOT INITIAL. <fd> = v_base. ENDIF.
          ASSIGN COMPONENT 'IMPUESTO'    OF STRUCTURE ls_det TO <fd>.
          IF sy-subrc = 0 AND <fd> IS ASSIGNED. <fd> = '002'. ENDIF.
          ASSIGN COMPONENT 'TIPOFACTOR'  OF STRUCTURE ls_det TO <fd>.
          IF sy-subrc = 0 AND <fd> IS ASSIGNED AND v_tipo IS NOT INITIAL. <fd> = v_tipo. ENDIF.
          ASSIGN COMPONENT 'TASAOCUOTA'  OF STRUCTURE ls_det TO <fd>.
          IF sy-subrc = 0 AND <fd> IS ASSIGNED AND v_tasa IS NOT INITIAL. <fd> = v_tasa. ENDIF.
          ASSIGN COMPONENT 'IVA_IMPORTE' OF STRUCTURE ls_det TO <fd>.
          IF sy-subrc = 0 AND <fd> IS ASSIGNED AND v_iva  IS NOT INITIAL. <fd> = v_iva.  ENDIF.
          EXIT. " primer IVA del concepto
        ENDIF.
      ENDLOOP.

      INSERT zcfdi_det_40 FROM ls_det.
      IF sy-subrc = 0.
        lv_cnt_ins = lv_cnt_ins + 1.
      ELSE.
        lv_has_error = abap_true.
      ENDIF.
    ENDLOOP.

    "---- 7) Mensaje único de salida
    IF lv_has_error = abap_false AND lv_cnt_ins > 0.
      ev_success = abap_true.
      ev_message = 'Insert Completo'.
    ELSE.
      ev_success = abap_false.
      ev_message = 'Error Insert'.
    ENDIF.

  ENDMETHOD.
ENDCLASS.