  " Aquí NO agregamos nada más.
  " Será un nodo válido <cfdi:Complemento/> sin contenido.
  " No rompe PAC, no rompe XML, y te permite compilar.
  " ------------------------------------------------------------

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_CFDI40_NAST->BUILD_CONCEPTOS
* +-------------------------------------------------------------------------------------------------+
* | [<-->] CT_XML                         TYPE        ANY TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD build_conceptos.

    "-------------------------------------------------------------
    " Decimales de la moneda (TCURX)
    "-------------------------------------------------------------
    DATA lv_curr_dec TYPE i VALUE 2.
    FIELD-SYMBOLS: <fs_head>  TYPE any,
                   <fs_waers> TYPE any.
    READ TABLE mt_head INDEX 1 ASSIGNING <fs_head>.
    IF sy-subrc = 0.
      ASSIGN COMPONENT 'WAERS' OF STRUCTURE <fs_head> TO <fs_waers>.
      IF <fs_waers> IS ASSIGNED AND <fs_waers> IS NOT INITIAL.
        SELECT SINGLE currdec INTO lv_curr_dec FROM tcurx WHERE currkey = <fs_waers>.
        IF sy-subrc <> 0 OR lv_curr_dec IS INITIAL.
          lv_curr_dec = 2.
        ENDIF.
      ENDIF.
    ENDIF.

    "-------------------------------------------------------------
    " Si no hay detalle, NO emitas <cfdi:Conceptos> para evitar error 203
    "-------------------------------------------------------------
    IF mt_det IS INITIAL.
      RETURN. "Sin conceptos => no serializamos el nodo
    ENDIF.

    "-------------------------------------------------------------
    " Caches para MLAN/KONV
    "-------------------------------------------------------------
    DATA: lv_last_vbeln TYPE vbrk-vbeln,
          lv_last_knumv TYPE konv-knumv.

    TYPES: BEGIN OF ty_mlan_cache,
             matnr TYPE matnr,
             taxm1 TYPE mlan-taxm1,
           END OF ty_mlan_cache.
    DATA: lt_mlan_cache TYPE HASHED TABLE OF ty_mlan_cache WITH UNIQUE KEY matnr,
          ls_mlan_cache TYPE ty_mlan_cache.

    TYPES: BEGIN OF ty_konv,
             kbetr TYPE konv-kbetr,
             kawrt TYPE konv-kawrt,
             kwert TYPE konv-kwert,
             krech TYPE konv-krech,
             kinak TYPE konv-kinak,
             kstat TYPE konv-kstat,
           END OF ty_konv.
    DATA: lt_konv_pos TYPE STANDARD TABLE OF ty_konv,
          ls_konv_pos TYPE ty_konv.

    "-------------------------------------------------------------
    " Field-symbols genéricos para el detalle
    "-------------------------------------------------------------
    FIELD-SYMBOLS:
      <d>         TYPE any,
      <f_qty>     TYPE any,   <f_unit>   TYPE any,   <f_amt>     TYPE any,
      <f_desc>    TYPE any,   <f_clvps>  TYPE any,   <f_clvuni>  TYPE any,
      <f_posnr>   TYPE any,   <f_vbeln>  TYPE any,   <f_matnr>   TYPE any,
      <f_kpein>   TYPE any,   <f_impiva> TYPE any,   <f_tasa>    TYPE any,
      <f_ivaperc> TYPE any,   <f_objimp> TYPE any.

    DATA: lv_qty    TYPE decfloat34,
          lv_unit   TYPE decfloat34,
          lv_amt_in TYPE decfloat34,
          lv_kpein  TYPE decfloat34,
          lv_base_p TYPE p LENGTH 16 DECIMALS 2,
          lv_iva_p  TYPE p LENGTH 16 DECIMALS 2,
          lv_rate   TYPE decfloat34,
          lv_rate6  TYPE string,
          lv_tipof  TYPE string,
          lv_objimp TYPE string.

    DATA: lv_qty_s  TYPE string,
          lv_unit_s TYPE string,
          lv_base_s TYPE string,
          lv_iva_s  TYPE string.

    DATA: lv_attr     TYPE string,
          lv_attr_imp TYPE string.

    "-------------------------------------------------------------
    " Serialización
    "-------------------------------------------------------------
    me->append_line( EXPORTING iv_line = '<cfdi:Conceptos>' CHANGING ct_xml = ct_xml ).

    LOOP AT mt_det ASSIGNING <d>.

      UNASSIGN: <f_qty>,<f_unit>,<f_amt>,<f_desc>,<f_clvps>,<f_clvuni>,<f_posnr>,
                <f_vbeln>,<f_matnr>,<f_kpein>,<f_impiva>,<f_tasa>,<f_ivaperc>,<f_objimp>.

      ASSIGN COMPONENT 'CANTIDAD'       OF STRUCTURE <d> TO <f_qty>.
      IF <f_qty> IS NOT ASSIGNED.
        ASSIGN COMPONENT 'FKIMG' OF STRUCTURE <d> TO <f_qty>.
      ENDIF.

      ASSIGN COMPONENT 'VALOR_UNITARIO' OF STRUCTURE <d> TO <f_unit>.
      IF <f_unit> IS NOT ASSIGNED.
        ASSIGN COMPONENT 'VALOR_UNIT' OF STRUCTURE <d> TO <f_unit>.
      ENDIF.
      IF <f_unit> IS NOT ASSIGNED.
        ASSIGN COMPONENT 'PUNIT' OF STRUCTURE <d> TO <f_unit>.
      ENDIF.
      IF <f_unit> IS NOT ASSIGNED.
        ASSIGN COMPONENT 'KBETR' OF STRUCTURE <d> TO <f_unit>.
      ENDIF.

      ASSIGN COMPONENT 'IMPORTE'        OF STRUCTURE <d> TO <f_amt>.
      IF <f_amt> IS NOT ASSIGNED.
        ASSIGN COMPONENT 'DMBTR' OF STRUCTURE <d> TO <f_amt>.
      ENDIF.

      ASSIGN COMPONENT 'DESCRIPCION'      OF STRUCTURE <d> TO <f_desc>.
      ASSIGN COMPONENT 'CLAVE_PROD_SERV'  OF STRUCTURE <d> TO <f_clvps>.
      ASSIGN COMPONENT 'CLAVE_UNIDAD'     OF STRUCTURE <d> TO <f_clvuni>.
      ASSIGN COMPONENT 'POSNR'            OF STRUCTURE <d> TO <f_posnr>.
      ASSIGN COMPONENT 'VBELN'            OF STRUCTURE <d> TO <f_vbeln>.
      ASSIGN COMPONENT 'MATNR'            OF STRUCTURE <d> TO <f_matnr>.
      ASSIGN COMPONENT 'KPEIN'            OF STRUCTURE <d> TO <f_kpein>.
      ASSIGN COMPONENT 'IMPORTE_IVA'      OF STRUCTURE <d> TO <f_impiva>.
      ASSIGN COMPONENT 'TASAOCUOTA'       OF STRUCTURE <d> TO <f_tasa>.
      IF <f_tasa> IS NOT ASSIGNED.
        ASSIGN COMPONENT 'TASA' OF STRUCTURE <d> TO <f_tasa>.
      ENDIF.
      ASSIGN COMPONENT 'IVA_PORCENTAJE'   OF STRUCTURE <d> TO <f_ivaperc>.
      ASSIGN COMPONENT 'OBJETOIMP'        OF STRUCTURE <d> TO <f_objimp>.

      "--------------------------
      " Cálculos base/IVA/rate
      "--------------------------
      CLEAR: lv_qty, lv_unit, lv_amt_in, lv_kpein.
      IF <f_qty>  IS ASSIGNED AND <f_qty>  IS NOT INITIAL. lv_qty    = CONV decfloat34( <f_qty>  ). ENDIF.
      IF <f_unit> IS ASSIGNED AND <f_unit> IS NOT INITIAL. lv_unit   = CONV decfloat34( <f_unit> ). ENDIF.
      IF <f_amt>  IS ASSIGNED AND <f_amt>  IS NOT INITIAL. lv_amt_in = CONV decfloat34( <f_amt>  ). ENDIF.
      IF <f_kpein> IS ASSIGNED AND <f_kpein> IS NOT INITIAL. lv_kpein = CONV decfloat34( <f_kpein> ). ENDIF.
      IF lv_kpein > 0. lv_unit = lv_unit / lv_kpein. ENDIF.

      lv_base_p = lv_qty * lv_unit.
      IF lv_base_p = 0 AND lv_amt_in > 0.
        lv_base_p = lv_amt_in.
      ENDIF.

      lv_tipof  = 'Tasa'.
      lv_objimp = '02'.
      lv_rate   = 0.
      lv_iva_p  = 0.

      " Respetar ObjetoImp si viene
      IF <f_objimp> IS ASSIGNED AND <f_objimp> IS NOT INITIAL.
        lv_objimp = <f_objimp>.
      ENDIF.

      " Prioridad: IVA_PORCENTAJE -> Tasa -> Importe IVA -> KONV
      IF <f_ivaperc> IS ASSIGNED AND <f_ivaperc> IS NOT INITIAL.
        lv_rate = CONV decfloat34( <f_ivaperc> ).
      ELSEIF <f_tasa> IS ASSIGNED AND <f_tasa> IS NOT INITIAL.
        lv_rate = CONV decfloat34( <f_tasa> ).
      ENDIF.
      IF lv_rate > 1 AND lv_rate <= 100.
        lv_rate = lv_rate / 100. "16 -> 0.16
      ENDIF.
      IF lv_rate < 0.
        lv_rate = 0.
      ENDIF.

      " Exento por MLAN o explícito '01'
      DATA(lv_exento) = abap_false.
      IF lv_objimp = '01'.
        lv_exento = abap_true.
      ELSEIF <f_matnr> IS ASSIGNED AND <f_matnr> IS NOT INITIAL.
        ls_mlan_cache-matnr = <f_matnr>.
        READ TABLE lt_mlan_cache INTO ls_mlan_cache WITH TABLE KEY matnr = ls_mlan_cache-matnr.
        IF sy-subrc <> 0.
          DATA lv_matnr_db TYPE matnr.
          lv_matnr_db = <f_matnr>.
          CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
            EXPORTING
              input  = lv_matnr_db
            IMPORTING
              output = lv_matnr_db.
          SELECT SINGLE taxm1
                 INTO ls_mlan_cache-taxm1
                 FROM mlan
                 WHERE matnr = lv_matnr_db
                   AND aland = 'MX'.
          IF sy-subrc = 0.
            INSERT ls_mlan_cache INTO TABLE lt_mlan_cache.
          ENDIF.
        ENDIF.
        IF ls_mlan_cache-taxm1 = '0' OR ls_mlan_cache-taxm1 IS INITIAL.
          lv_exento = abap_true.
        ENDIF.
      ENDIF.

      IF lv_exento = abap_true.
        lv_objimp = '01'.
        lv_tipof  = 'Exento'.
        CLEAR: lv_rate, lv_iva_p.
      ELSE.
        IF lv_rate > 0.
          lv_iva_p = lv_base_p * lv_rate.
        ELSEIF <f_impiva> IS ASSIGNED AND <f_impiva> IS NOT INITIAL AND lv_base_p > 0.
          lv_iva_p = CONV decfloat34( <f_impiva> ).
          IF lv_iva_p < 0.
            lv_iva_p = - lv_iva_p.
          ENDIF.
          lv_rate  = CONV decfloat34( lv_iva_p ) / CONV decfloat34( lv_base_p ).
        ELSE.
          " Fallback a KONV (MWST/ZIVA/ZIV0) por posición
          REFRESH lt_konv_pos.
          IF <f_vbeln> IS ASSIGNED AND <f_vbeln> IS NOT INITIAL AND
             <f_posnr> IS ASSIGNED AND <f_posnr> IS NOT INITIAL.

            IF lv_last_vbeln IS INITIAL OR lv_last_vbeln <> <f_vbeln>.
              SELECT SINGLE knumv INTO lv_last_knumv FROM vbrk WHERE vbeln = <f_vbeln>.
              lv_last_vbeln = <f_vbeln>.
            ENDIF.

            IF lv_last_knumv IS NOT INITIAL.
              SELECT kbetr kawrt kwert krech kinak kstat
                FROM konv INTO TABLE lt_konv_pos
                WHERE knumv = lv_last_knumv
                  AND kposn = <f_posnr>
                  AND ( kschl = 'MWST' OR kschl = 'ZIVA' OR kschl = 'ZIV0' ).
            ENDIF.

            IF sy-subrc = 0 AND lt_konv_pos IS NOT INITIAL.
              DELETE lt_konv_pos WHERE kinak = 'X' OR kstat = 'X'.
              IF lt_konv_pos IS NOT INITIAL.
                SORT lt_konv_pos BY kbetr DESCENDING.
                READ TABLE lt_konv_pos INDEX 1 INTO ls_konv_pos.
                IF sy-subrc = 0
                   AND ls_konv_pos-kbetr IS NOT INITIAL
                   AND ls_konv_pos-krech = 'B'.
                  lv_rate = ls_konv_pos-kbetr / 100.
                ELSE.
                  DATA(lv_kw) = CONV decfloat34( 0 ).
                  DATA(lv_ka) = CONV decfloat34( 0 ).
                  LOOP AT lt_konv_pos INTO ls_konv_pos.
                    IF ls_konv_pos-kawrt IS NOT INITIAL.
                      lv_ka = lv_ka + CONV decfloat34( ls_konv_pos-kawrt ).
                    ENDIF.
                    IF ls_konv_pos-kwert IS NOT INITIAL.
                      lv_kw = lv_kw + CONV decfloat34( ls_konv_pos-kwert ).
                    ENDIF.
                  ENDLOOP.
                  IF lv_ka <> 0.
                    lv_rate = lv_kw / lv_ka.
                  ENDIF.
                ENDIF.
              ENDIF.
            ENDIF.

            IF lv_rate > 0.
              lv_iva_p = lv_base_p * lv_rate.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.

      "--------------------------
      " Strings CFDI (puntos, decimales)
      "--------------------------
      lv_qty_s  = |{ CONV decfloat34( lv_qty )     DECIMALS = 6 }|.
      REPLACE ALL OCCURRENCES OF ',' IN lv_qty_s  WITH '.'.
      lv_unit_s = |{ CONV decfloat34( lv_unit )    DECIMALS = 6 }|.
      REPLACE ALL OCCURRENCES OF ',' IN lv_unit_s WITH '.'.
      lv_base_s = |{ CONV decfloat34( lv_base_p )  DECIMALS = lv_curr_dec }|.
      REPLACE ALL OCCURRENCES OF ',' IN lv_base_s WITH '.'.
      lv_iva_s  = |{ CONV decfloat34( lv_iva_p  )  DECIMALS = lv_curr_dec }|.
      REPLACE ALL OCCURRENCES OF ',' IN lv_iva_s  WITH '.'.
      lv_rate6  = |{ CONV decfloat34( lv_rate )    DECIMALS = 6 }|.
      REPLACE ALL OCCURRENCES OF ',' IN lv_rate6  WITH '.'.

      "--------------------------
      " Concepto
      "--------------------------
      CLEAR lv_attr.
      IF <f_clvps> IS ASSIGNED AND <f_clvps> IS NOT INITIAL.
        me->add_attr( EXPORTING i_name = 'ClaveProdServ' i_val = <f_clvps> CHANGING cv_attr = lv_attr ).
      ELSE.
        me->add_attr( EXPORTING i_name = 'ClaveProdServ' i_val = '01010101' CHANGING cv_attr = lv_attr ).
      ENDIF.

      IF <f_clvuni> IS ASSIGNED AND <f_clvuni> IS NOT INITIAL.
        me->add_attr( EXPORTING i_name = 'ClaveUnidad' i_val = <f_clvuni> CHANGING cv_attr = lv_attr ).
      ELSE.
        me->add_attr( EXPORTING i_name = 'ClaveUnidad' i_val = 'E48' CHANGING cv_attr = lv_attr ).
      ENDIF.

      me->add_attr( EXPORTING i_name = 'Cantidad'      i_val = lv_qty_s  CHANGING cv_attr = lv_attr ).

      IF <f_desc> IS ASSIGNED AND <f_desc> IS NOT INITIAL.
        me->add_attr( EXPORTING i_name = 'Descripcion' i_val = <f_desc>  CHANGING cv_attr = lv_attr ).
      ELSE.
        me->add_attr( EXPORTING i_name = 'Descripcion' i_val = 'SERVICIO' CHANGING cv_attr = lv_attr ).
      ENDIF.

      me->add_attr( EXPORTING i_name = 'ValorUnitario' i_val = lv_unit_s CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'Importe'       i_val = lv_base_s CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'ObjetoImp'     i_val = lv_objimp CHANGING cv_attr = lv_attr ).

      me->append_line( EXPORTING iv_line = |<cfdi:Concepto { lv_attr }>| CHANGING ct_xml = ct_xml ).

      "--------------------------
      " Impuestos por concepto
      " Sólo si ObjetoImp='02' y base>0
      " (0% válido: TipoFactor='Tasa' con TasaOCuota=0.000000)
      "--------------------------
      IF lv_objimp = '02' AND lv_base_p > 0.
        me->append_line( EXPORTING iv_line = '<cfdi:Impuestos>' CHANGING ct_xml = ct_xml ).
        me->append_line( EXPORTING iv_line = '<cfdi:Traslados>' CHANGING ct_xml = ct_xml ).

        CLEAR lv_attr_imp.
        me->add_attr( EXPORTING i_name = 'Base'       i_val = lv_base_s CHANGING cv_attr = lv_attr_imp ).
        me->add_attr( EXPORTING i_name = 'Impuesto'   i_val = '002'     CHANGING cv_attr = lv_attr_imp ).
        me->add_attr( EXPORTING i_name = 'TipoFactor' i_val = 'Tasa'    CHANGING cv_attr = lv_attr_imp ).
        me->add_attr( EXPORTING i_name = 'TasaOCuota' i_val = lv_rate6  CHANGING cv_attr = lv_attr_imp ).
        me->add_attr( EXPORTING i_name = 'Importe'    i_val = lv_iva_s  CHANGING cv_attr = lv_attr_imp ).

        me->append_line( EXPORTING iv_line = |<cfdi:Traslado { lv_attr_imp }/>| CHANGING ct_xml = ct_xml ).
        me->append_line( EXPORTING iv_line = '</cfdi:Traslados>' CHANGING ct_xml = ct_xml ).
        me->append_line( EXPORTING iv_line = '</cfdi:Impuestos>' CHANGING ct_xml = ct_xml ).
      ENDIF.

      me->append_line( EXPORTING iv_line = '</cfdi:Concepto>' CHANGING ct_xml = ct_xml ).

    ENDLOOP.

    me->append_line( EXPORTING iv_line = '</cfdi:Conceptos>' CHANGING ct_xml = ct_xml ).

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->BUILD_CONCEPTOS_IXML
* +-------------------------------------------------------------------------------------------------+
* | [<-->] CO_PARENT                      TYPE REF TO IF_IXML_ELEMENT
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD build_conceptos_ixml.

  FIELD-SYMBOLS <d> TYPE any.

  " Crear nodo padre <cfdi:Conceptos> dentro de <cfdi:Comprobante>
  DATA(lo_conceptos) = co_parent->get_owner_document( )->create_simple_element(
                          name   = 'cfdi:Conceptos'
                          parent = co_parent ).

  "==============================================================
  "  LOOP EXACTO SOBRE mt_det (MISMA LÓGICA QUE TU CÓDIGO ORIGINAL)
  "==============================================================

  LOOP AT mt_det ASSIGNING <d>.

    "----------------------------------------------------------
    " Recuperación de campos (misma lógica que tu método actual)
    "----------------------------------------------------------
    FIELD-SYMBOLS:
      <f_qty>    TYPE any,
      <f_unit>   TYPE any,
      <f_amt>    TYPE any,
      <f_tasa>   TYPE any,
      <f_kpein>  TYPE any,
      <f_matnr>  TYPE any,
      <f_ivap>   TYPE any,
      <f_ivapct> TYPE any,
      <f_objimp> TYPE any.

    UNASSIGN: <f_qty>,<f_unit>,<f_amt>,<f_tasa>,
              <f_kpein>,<f_matnr>,<f_ivap>,<f_ivapct>,<f_objimp>.

    " CANTIDAD
    ASSIGN COMPONENT 'CANTIDAD' OF STRUCTURE <d> TO <f_qty>.
    IF <f_qty> IS NOT ASSIGNED.
      ASSIGN COMPONENT 'FKIMG' OF STRUCTURE <d> TO <f_qty>.
    ENDIF.

    " VALOR UNITARIO
    ASSIGN COMPONENT 'VALOR_UNITARIO' OF STRUCTURE <d> TO <f_unit>.
    IF <f_unit> IS NOT ASSIGNED.
      ASSIGN COMPONENT 'VALOR_UNIT' OF STRUCTURE <d> TO <f_unit>.
    ENDIF.
    IF <f_unit> IS NOT ASSIGNED.
      ASSIGN COMPONENT 'PUNIT' OF STRUCTURE <d> TO <f_unit>.
    ENDIF.
    IF <f_unit> IS NOT ASSIGNED.
      ASSIGN COMPONENT 'KBETR' OF STRUCTURE <d> TO <f_unit>.
    ENDIF.

    " IMPORTE
    ASSIGN COMPONENT 'IMPORTE' OF STRUCTURE <d> TO <f_amt>.
    IF <f_amt> IS NOT ASSIGNED.
      ASSIGN COMPONENT 'DMBTR' OF STRUCTURE <d> TO <f_amt>.
    ENDIF.

    " TASA IVA
    ASSIGN COMPONENT 'TASAOCUOTA' OF STRUCTURE <d> TO <f_tasa>.
    IF <f_tasa> IS NOT ASSIGNED.
      ASSIGN COMPONENT 'TASA' OF STRUCTURE <d> TO <f_tasa>.
    ENDIF.

    " IVA IMPORTE
    ASSIGN COMPONENT 'IMPORTE_IVA'    OF STRUCTURE <d> TO <f_ivap>.
    ASSIGN COMPONENT 'IVA_PORCENTAJE' OF STRUCTURE <d> TO <f_ivapct>.
    ASSIGN COMPONENT 'KPEIN'          OF STRUCTURE <d> TO <f_kpein>.
    ASSIGN COMPONENT 'OBJETOIMP'      OF STRUCTURE <d> TO <f_objimp>.

    " MATERIAL (para exentos por MLAN, si aplica luego)
    ASSIGN COMPONENT 'MATNR' OF STRUCTURE <d> TO <f_matnr>.

    "----------------------------------------------------------
    " CÁLCULOS EXACTOS COMO TU LÓGICA ORIGINAL
    "----------------------------------------------------------
    DATA: lv_qty     TYPE decfloat34 VALUE 0,
          lv_unitp   TYPE decfloat34 VALUE 0,
          lv_amt_in  TYPE decfloat34 VALUE 0,
          lv_tasa    TYPE decfloat34 VALUE 0,
          lv_kpein   TYPE decfloat34 VALUE 0,
          lv_base    TYPE decfloat34 VALUE 0,
          lv_impto   TYPE decfloat34 VALUE 0,
          lv_objimp  TYPE string.

    " Cantidad
    IF <f_qty> IS ASSIGNED AND <f_qty> IS NOT INITIAL.
      lv_qty = <f_qty>.
    ENDIF.

    " Unitario
    IF <f_unit> IS ASSIGNED AND <f_unit> IS NOT INITIAL.
      lv_unitp = <f_unit>.
    ENDIF.

    " KPEIN → division
    IF <f_kpein> IS ASSIGNED AND <f_kpein> IS NOT INITIAL.
      lv_kpein = <f_kpein>.
      IF lv_kpein > 0.
        lv_unitp = lv_unitp / lv_kpein.
      ENDIF.
    ENDIF.

    " Importe de línea
    IF <f_amt> IS ASSIGNED AND <f_amt> IS NOT INITIAL.
      lv_amt_in = <f_amt>.
    ENDIF.

    " Base = qty * unit, o importe directo
    lv_base = lv_qty * lv_unitp.
    IF lv_base = 0 AND lv_amt_in > 0.
      lv_base = lv_amt_in.
    ENDIF.

    " Tasa desde IVA_PORCENTAJE o TASAOCUOTA
    IF <f_ivapct> IS ASSIGNED AND <f_ivapct> IS NOT INITIAL.
      lv_tasa = <f_ivapct>.
    ELSEIF <f_tasa> IS ASSIGNED AND <f_tasa> IS NOT INITIAL.
      lv_tasa = <f_tasa>.
    ENDIF.

    " Normalizar porcentaje
    IF lv_tasa > 1 AND lv_tasa <= 100.
      lv_tasa = lv_tasa / 100.
    ENDIF.

    IF lv_tasa < 0.
      lv_tasa = 0.
    ENDIF.

    " IVA importe
    IF lv_tasa > 0.
      lv_impto = lv_base * lv_tasa.
    ELSEIF <f_ivap> IS ASSIGNED AND <f_ivap> IS NOT INITIAL.
      lv_impto = <f_ivap>.
    ENDIF.

    " OBJETO IMP (01 exento, 02 gravado)
    lv_objimp = COND string(
                   WHEN <f_objimp> IS ASSIGNED AND <f_objimp> IS NOT INITIAL THEN <f_objimp>
                   WHEN lv_tasa = 0 THEN '01'
                   ELSE '02'
                ).

    "==========================================================
    "        🔵 CREACIÓN DEL XML iXML (YA NO STRING)
    "==========================================================

    " Crear <cfdi:Concepto>
    DATA(lo_concepto) = co_parent->get_owner_document( )->create_simple_element(
                          name   = 'cfdi:Concepto'
                          parent = lo_conceptos ).

    lo_concepto->set_attribute( name ='Cantidad'      value = |{ lv_qty }| ).
    lo_concepto->set_attribute( name ='ValorUnitario' value = |{ lv_unitp }| ).
    lo_concepto->set_attribute( name ='Importe'       value = |{ lv_base }| ).
    lo_concepto->set_attribute( name ='ObjetoImp'     value = lv_objimp ).

    "----------------------------------------------------------
    " Impuestos por concepto → solo si OBJETOIMP = 02 (gravado)
    "----------------------------------------------------------
    IF lv_objimp = '02'.

      DATA(lo_imp) = co_parent->get_owner_document( )->create_simple_element(
                       name   = 'cfdi:Impuestos'
                       parent = lo_concepto ).

      DATA(lo_trs) = co_parent->get_owner_document( )->create_simple_element(
                       name   = 'cfdi:Traslados'
                       parent = lo_imp ).

      DATA(lo_tr) = co_parent->get_owner_document( )->create_simple_element(
                      name   = 'cfdi:Traslado'
                      parent = lo_trs ).

      lo_tr->set_attribute( name ='Base'
                            value = |{ lv_base }| ).

      lo_tr->set_attribute( name ='Impuesto'
                            value = '002' ).    " IVA

      lo_tr->set_attribute( name ='TipoFactor'
                            value = 'Tasa' ).

      lo_tr->set_attribute( name ='TasaOCuota'
                            value = |{ lv_tasa DECIMALS = 6 }| ).

      lo_tr->set_attribute( name ='Importe'
                            value = |{ lv_impto DECIMALS = 2 }| ).

    ENDIF.

  ENDLOOP.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_CFDI40_NAST->BUILD_IMPUESTOS_TOTALES
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEAD                        TYPE        ZET_HEAD_40
* | [--->] IV_VERSION                     TYPE        CHAR4
* | [<-->] CT_XML                         TYPE        ANY TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD build_impuestos_totales.
    " Acumular por tasa (incluye tasa 0% con Base, exentos fuera)
    TYPES: BEGIN OF ty_tot,
             tasa6     TYPE string,
             base_p    TYPE p LENGTH 16 DECIMALS 2,
             importe_p TYPE p LENGTH 16 DECIMALS 2,
           END OF ty_tot.
    DATA: lt_tot TYPE HASHED TABLE OF ty_tot WITH UNIQUE KEY tasa6,
          ls_tot TYPE ty_tot.

    " decimales de moneda
    DATA lv_curr_dec TYPE i VALUE 2.
    FIELD-SYMBOLS: <fs_head>  TYPE any, <fs_waers> TYPE any.
    READ TABLE mt_head INDEX 1 ASSIGNING <fs_head>.
    IF sy-subrc = 0.
      ASSIGN COMPONENT 'WAERS' OF STRUCTURE <fs_head> TO <fs_waers>.
      IF <fs_waers> IS ASSIGNED AND <fs_waers> IS NOT INITIAL.
        SELECT SINGLE currdec INTO lv_curr_dec FROM tcurx WHERE currkey = <fs_waers>.
        IF sy-subrc <> 0 OR lv_curr_dec IS INITIAL. lv_curr_dec = 2. ENDIF.
      ENDIF.
    ENDIF.

    " caches
    DATA: lv_last_vbeln TYPE vbrk-vbeln, lv_last_knumv TYPE konv-knumv.
    TYPES: BEGIN OF ty_mlan_cache, matnr TYPE matnr, taxm1 TYPE mlan-taxm1, END OF ty_mlan_cache.
    DATA: lt_mlan_cache TYPE HASHED TABLE OF ty_mlan_cache WITH UNIQUE KEY matnr,
          ls_mlan_cache TYPE ty_mlan_cache.

    TYPES: BEGIN OF ty_konv, kbetr TYPE konv-kbetr, kawrt TYPE konv-kawrt, kwert TYPE konv-kwert, krech TYPE konv-krech, kinak TYPE konv-kinak, kstat TYPE konv-kstat, END OF ty_konv.
    DATA: lt_konv_pos TYPE STANDARD TABLE OF ty_konv, ls_konv_pos TYPE ty_konv.

    FIELD-SYMBOLS:
      <d>        TYPE any,
      <f_qty>    TYPE any,   <f_unit>   TYPE any,   <f_amt>    TYPE any,
      <f_posnr>  TYPE any,   <f_vbeln>  TYPE any,   <f_matnr>  TYPE any,
      <f_kpein>  TYPE any,   <f_impiva> TYPE any,   <f_tasa>   TYPE any,
      <f_ivapct> TYPE any,   <f_objimp> TYPE any.

    DATA: lv_qty    TYPE decfloat34,
          lv_unit   TYPE decfloat34,
          lv_amt_in TYPE decfloat34,
          lv_kpein  TYPE decfloat34,
          lv_base_p TYPE p LENGTH 16 DECIMALS 2,
          lv_iva_p  TYPE p LENGTH 16 DECIMALS 2,
          lv_rate   TYPE decfloat34,
          lv_rate6  TYPE string.

    LOOP AT mt_det ASSIGNING <d>.
      UNASSIGN: <f_qty>,<f_unit>,<f_amt>,<f_posnr>,<f_vbeln>,<f_matnr>,<f_kpein>,
      <f_impiva>,<f_tasa>,<f_ivapct>,<f_objimp>.
      ASSIGN COMPONENT 'CANTIDAD'       OF STRUCTURE <d> TO <f_qty>.
      IF <f_qty>  IS NOT ASSIGNED. ASSIGN COMPONENT 'FKIMG' OF STRUCTURE <d> TO <f_qty>. ENDIF.
      ASSIGN COMPONENT 'VALOR_UNITARIO' OF STRUCTURE <d> TO <f_unit>.
      IF <f_unit> IS NOT ASSIGNED. ASSIGN COMPONENT 'VALOR_UNIT' OF STRUCTURE <d> TO <f_unit>. ENDIF.
      IF <f_unit> IS NOT ASSIGNED. ASSIGN COMPONENT 'PUNIT' OF STRUCTURE <d> TO <f_unit>. ENDIF.
      IF <f_unit> IS NOT ASSIGNED. ASSIGN COMPONENT 'KBETR' OF STRUCTURE <d> TO <f_unit>. ENDIF.
      ASSIGN COMPONENT 'IMPORTE'        OF STRUCTURE <d> TO <f_amt>.
      IF <f_amt>  IS NOT ASSIGNED. ASSIGN COMPONENT 'DMBTR' OF STRUCTURE <d> TO <f_amt>.  ENDIF.
      ASSIGN COMPONENT 'POSNR'          OF STRUCTURE <d> TO <f_posnr>.
      ASSIGN COMPONENT 'VBELN'          OF STRUCTURE <d> TO <f_vbeln>.
      ASSIGN COMPONENT 'MATNR'          OF STRUCTURE <d> TO <f_matnr>.
      ASSIGN COMPONENT 'KPEIN'          OF STRUCTURE <d> TO <f_kpein>.
      ASSIGN COMPONENT 'IMPORTE_IVA'    OF STRUCTURE <d> TO <f_impiva>.
      ASSIGN COMPONENT 'TASAOCUOTA'     OF STRUCTURE <d> TO <f_tasa>.
      ASSIGN COMPONENT 'IVA_PORCENTAJE' OF STRUCTURE <d> TO <f_ivapct>.
      ASSIGN COMPONENT 'OBJETOIMP'      OF STRUCTURE <d> TO <f_objimp>.

      CLEAR: lv_qty, lv_unit, lv_amt_in, lv_kpein.
      IF <f_qty>  IS ASSIGNED AND <f_qty>  IS NOT INITIAL. lv_qty  = <f_qty>.  ENDIF.
      IF <f_unit> IS ASSIGNED AND <f_unit> IS NOT INITIAL. lv_unit = <f_unit>. ENDIF.
      IF <f_amt>  IS ASSIGNED AND <f_amt>  IS NOT INITIAL. lv_amt_in = <f_amt>. ENDIF.
      IF <f_kpein> IS ASSIGNED AND <f_kpein> IS NOT INITIAL. lv_kpein = <f_kpein>. ENDIF.
      IF lv_kpein > 0. lv_unit = lv_unit / lv_kpein. ENDIF.

      lv_base_p = lv_qty * lv_unit.
      IF lv_base_p = 0 AND lv_amt_in > 0. lv_base_p = lv_amt_in. ENDIF.
      IF lv_base_p = 0. CONTINUE. ENDIF.

      " exento explícito o por MLAN => no suma
      IF <f_objimp> IS ASSIGNED AND <f_objimp> = '01'. CONTINUE. ENDIF.
      DATA(lv_exento) = abap_false.
      IF <f_matnr> IS ASSIGNED AND <f_matnr> IS NOT INITIAL.
        ls_mlan_cache-matnr = <f_matnr>.
        READ TABLE lt_mlan_cache INTO ls_mlan_cache WITH TABLE KEY matnr = ls_mlan_cache-matnr.
        IF sy-subrc <> 0.
          DATA lv_matnr_db TYPE matnr.
          lv_matnr_db = <f_matnr>.
          CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT' EXPORTING input = lv_matnr_db IMPORTING output = lv_matnr_db.
          SELECT SINGLE taxm1 INTO ls_mlan_cache-taxm1 FROM mlan WHERE matnr = lv_matnr_db AND aland = 'MX'.
          IF sy-subrc = 0. INSERT ls_mlan_cache INTO TABLE lt_mlan_cache. ENDIF.
        ENDIF.
        IF ls_mlan_cache-taxm1 = '0' OR ls_mlan_cache-taxm1 IS INITIAL. lv_exento = abap_true. ENDIF.
      ENDIF.
      IF lv_exento = abap_true. CONTINUE. ENDIF.

      " tasa: IVA_PORCENTAJE > TASA > KONV > IMporteIVA/base
      CLEAR: lv_rate, lv_iva_p.
      IF <f_ivapct> IS ASSIGNED AND <f_ivapct> IS NOT INITIAL.
        lv_rate = CONV decfloat34( <f_ivapct> ).
      ELSEIF <f_tasa> IS ASSIGNED AND <f_tasa> IS NOT INITIAL.
        lv_rate = CONV decfloat34( <f_tasa> ).
      ENDIF.
      IF lv_rate > 1 AND lv_rate <= 100. lv_rate = lv_rate / 100. ENDIF.
      IF lv_rate < 0. lv_rate = 0. ENDIF.

      IF lv_rate = 0.
        REFRESH lt_konv_pos.
        IF <f_vbeln> IS ASSIGNED AND <f_vbeln> IS NOT INITIAL AND <f_posnr> IS ASSIGNED AND <f_posnr> IS NOT INITIAL.
          IF lv_last_vbeln IS INITIAL OR lv_last_vbeln <> <f_vbeln>.
            SELECT SINGLE knumv INTO lv_last_knumv FROM vbrk WHERE vbeln = <f_vbeln>.
            lv_last_vbeln = <f_vbeln>.
          ENDIF.
          IF lv_last_knumv IS NOT INITIAL.
            SELECT kbetr kawrt kwert krech kinak kstat
              FROM konv INTO TABLE lt_konv_pos
              WHERE knumv = lv_last_knumv
                AND kposn = <f_posnr>
                AND ( kschl = 'MWST' OR kschl = 'ZIVA' OR kschl = 'ZIV0' ).
          ENDIF.
          IF sy-subrc = 0 AND lt_konv_pos IS NOT INITIAL.
            DELETE lt_konv_pos WHERE kinak = 'X' OR kstat = 'X'.
            IF lt_konv_pos IS NOT INITIAL.
              SORT lt_konv_pos BY kbetr DESCENDING.
              READ TABLE lt_konv_pos INDEX 1 INTO ls_konv_pos.
              IF sy-subrc = 0 AND ls_konv_pos-kbetr IS NOT INITIAL AND ls_konv_pos-krech = 'B'.
                lv_rate = ls_konv_pos-kbetr / 100.
              ELSE.
                DATA(lv_kw) = CONV decfloat34( 0 ).
                DATA(lv_ka) = CONV decfloat34( 0 ).
                LOOP AT lt_konv_pos INTO ls_konv_pos.
                  IF ls_konv_pos-kawrt IS NOT INITIAL. lv_ka = lv_ka + CONV decfloat34( ls_konv_pos-kawrt ). ENDIF.
                  IF ls_konv_pos-kwert IS NOT INITIAL. lv_kw = lv_kw + CONV decfloat34( ls_konv_pos-kwert ). ENDIF.
                ENDLOOP.
                IF lv_ka <> 0. lv_rate = lv_kw / lv_ka. ENDIF.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.

      IF lv_rate > 0.
        lv_iva_p = lv_base_p * lv_rate.
      ELSEIF <f_impiva> IS ASSIGNED AND <f_impiva> IS NOT INITIAL.
        lv_iva_p = CONV decfloat34( <f_impiva> ).
        IF lv_iva_p < 0. lv_iva_p = - lv_iva_p. ENDIF.
      ELSE.
        CLEAR lv_iva_p.
      ENDIF.

      lv_rate6 = |{ CONV decfloat34( lv_rate ) DECIMALS = 6 }|.
      REPLACE ALL OCCURRENCES OF ',' IN lv_rate6 WITH '.'.

      CLEAR ls_tot.
      ls_tot-tasa6     = lv_rate6.     " incluye '0.000000' para 0%
      ls_tot-base_p    = lv_base_p.
      ls_tot-importe_p = lv_iva_p.
      COLLECT ls_tot INTO lt_tot.
    ENDLOOP.

    IF lt_tot IS NOT INITIAL.
      DATA lv_tot_tras TYPE p LENGTH 16 DECIMALS 2 VALUE 0.
      LOOP AT lt_tot INTO ls_tot.
        lv_tot_tras = lv_tot_tras + ls_tot-importe_p.
      ENDLOOP.

      " armar nodo de impuestos totales
      DATA lv_attr TYPE string.
      CLEAR lv_attr.
      IF lv_tot_tras > 0.
        DATA(lv_tot_s) = |{ CONV decfloat34( lv_tot_tras ) DECIMALS = lv_curr_dec }|.
        REPLACE ALL OCCURRENCES OF ',' IN lv_tot_s WITH '.'.
        me->add_attr( EXPORTING i_name = 'TotalImpuestosTrasladados' i_val = lv_tot_s CHANGING cv_attr = lv_attr ).
      ENDIF.

      me->append_line( EXPORTING iv_line = |<cfdi:Impuestos { lv_attr }>| CHANGING ct_xml = ct_xml ).
      me->append_line( EXPORTING iv_line = '<cfdi:Traslados>' CHANGING ct_xml = ct_xml ).

      LOOP AT lt_tot INTO ls_tot.
        " Base e Importe por tasa
        DATA lv_base_s TYPE string.
        DATA lv_imp_s  TYPE string.
        lv_base_s = |{ CONV decfloat34( ls_tot-base_p ) DECIMALS = lv_curr_dec }|.
        lv_imp_s  = |{ CONV decfloat34( ls_tot-importe_p ) DECIMALS = lv_curr_dec }|.
        REPLACE ALL OCCURRENCES OF ',' IN lv_base_s WITH '.'.
        REPLACE ALL OCCURRENCES OF ',' IN lv_imp_s  WITH '.'.

        CLEAR lv_attr.
        me->add_attr( EXPORTING i_name = 'Base'       i_val = lv_base_s     CHANGING cv_attr = lv_attr ).
        me->add_attr( EXPORTING i_name = 'Impuesto'   i_val = '002'         CHANGING cv_attr = lv_attr ).
        me->add_attr( EXPORTING i_name = 'TipoFactor' i_val = 'Tasa'        CHANGING cv_attr = lv_attr ).
        me->add_attr( EXPORTING i_name = 'TasaOCuota' i_val = ls_tot-tasa6  CHANGING cv_attr = lv_attr ).
        me->add_attr( EXPORTING i_name = 'Importe'    i_val = lv_imp_s      CHANGING cv_attr = lv_attr ).

        me->append_line( EXPORTING iv_line = |<cfdi:Traslado { lv_attr }/>| CHANGING ct_xml = ct_xml ).
      ENDLOOP.

      me->append_line( EXPORTING iv_line = '</cfdi:Traslados>' CHANGING ct_xml = ct_xml ).
      me->append_line( EXPORTING iv_line = '</cfdi:Impuestos>' CHANGING ct_xml = ct_xml ).
    ENDIF.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->BUILD_IMPUESTOS_TOTALES_IXML
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEAD                        TYPE        ZET_HEAD_40
* | [<-->] CO_PARENT                      TYPE REF TO IF_IXML_ELEMENT
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD build_impuestos_totales_ixml.

    " Si no hay IVA, no generamos nodo de impuestos totales
    IF mv_tras_total_p IS INITIAL.
      RETURN.
    ENDIF.

    DATA: lo_imps TYPE REF TO if_ixml_element,
          lo_trs  TYPE REF TO if_ixml_element,
          lo_tr   TYPE REF TO if_ixml_element.

    " Nodo <cfdi:Impuestos> colgado del comprobante
    lo_imps = co_parent->get_owner_document( )->create_simple_element(
                name   = 'cfdi:Impuestos'
                parent = co_parent ).

    lo_imps->set_attribute(
      name  = 'TotalImpuestosTrasladados'
      value = |{ mv_tras_total_p DECIMALS = 2 }| ).

    " Nodo <cfdi:Traslados>
    lo_trs = co_parent->get_owner_document( )->create_simple_element(
               name   = 'cfdi:Traslados'
               parent = lo_imps ).

    " Nodo <cfdi:Traslado>
    lo_tr = co_parent->get_owner_document( )->create_simple_element(
              name   = 'cfdi:Traslado'
              parent = lo_trs ).

    " Calculamos la tasa efectiva: IVA / SubTotal
    DATA: lv_sub  TYPE decfloat34,
          lv_iva  TYPE decfloat34,
          lv_tasa TYPE decfloat34.

    lv_sub  = CONV decfloat34( mv_subtotal_p ).
    lv_iva  = CONV decfloat34( mv_tras_total_p ).
    IF lv_sub > 0.
      lv_tasa = lv_iva / lv_sub.
    ELSE.
      lv_tasa = 0.
    ENDIF.

    lo_tr->set_attribute( name = 'Base'
                          value = |{ mv_subtotal_p DECIMALS = 2 }| ).
    lo_tr->set_attribute( name = 'Impuesto'
                          value = '002' ).   " IVA
    lo_tr->set_attribute( name = 'TipoFactor'
                          value = 'Tasa' ).
    lo_tr->set_attribute( name = 'TasaOCuota'
                          value = |{ lv_tasa DECIMALS = 6 }| ).
    lo_tr->set_attribute( name = 'Importe'
                          value = |{ mv_tras_total_p DECIMALS = 2 }| ).

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->BUILD_QR_URL
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_UUID                        TYPE        STRING
* | [--->] IV_RFC_EMISOR                  TYPE        STRING
* | [--->] IV_RFC_RECEPTOR                TYPE        STRING
* | [--->] IV_TOTAL                       TYPE        DECFLOAT34
* | [--->] IV_SELLO_CFD                   TYPE        STRING
* | [<---] EV_URL                         TYPE        STRING
* | [<---] EV_TT                          TYPE        STRING
* | [<---] EV_FE                          TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD build_qr_url.
    DATA: lv_re     TYPE string,
          lv_rr     TYPE string,
          lv_total6 TYPE string,
          lv_int    TYPE string,
          lv_dec    TYPE string,
          lv_tt     TYPE string,
          lv_fe     TYPE string,
          lv_off    TYPE i,
          lv_sello  TYPE string.


    lv_re      = iv_rfc_emisor.
    lv_rr       = iv_rfc_receptor.
    lv_sello   = iv_sello_cfd.

    " RFC en mayúsculas (recomendado por el SAT)
    TRANSLATE lv_re TO UPPER CASE.
    TRANSLATE lv_rr TO UPPER CASE.

    " Total con 6 decimales y punto como separador
    IF iv_total < 0.
      lv_total6 = |{ CONV decfloat34( - iv_total ) DECIMALS = 6 }|.
    ELSE.
      lv_total6 = |{ CONV decfloat34( iv_total ) DECIMALS = 6 }|.
    ENDIF.
    REPLACE ALL OCCURRENCES OF ',' IN lv_total6 WITH '.'.

    SPLIT lv_total6 AT '.' INTO lv_int lv_dec.
    IF lv_dec IS INITIAL.
      lv_dec = '000000'.
    ENDIF.

    WHILE
       strlen( lv_int ) < 10.
      lv_int = |0{ lv_int }|.
    ENDWHILE.
    IF strlen( lv_int ) > 10.
      lv_int = lv_int + ( strlen( lv_int ) - 10 ).
    ENDIF.

    DATA lv_int10 TYPE string.

    lv_int10 = lv_int.
    IF strlen( lv_int10 ) > 10.
      lv_int10 = lv_int10 + ( strlen( lv_int10 ) - 10 ).
    ENDIF.

    lv_int = |{ lv_int10 WIDTH = 10 ALIGN = RIGHT PAD = '0' }|.

    " Asegurar exactamente 6 decimales
    WHILE strlen( lv_dec ) < 6.
      lv_dec = |{ lv_dec }0|.
    ENDWHILE.
    IF strlen( lv_dec ) > 6.
      lv_dec = lv_dec(6).
    ENDIF.

    lv_tt = |{ lv_int }.{ lv_dec }|.

    " fe = últimos 8 caracteres del SelloCFD
    IF lv_sello IS NOT INITIAL AND strlen( lv_sello ) >= 8.
      lv_off = strlen( lv_sello ) - 8.
      lv_fe  = lv_sello+lv_off(8).
    ENDIF.

    ev_tt  = lv_tt.
    ev_fe  = lv_fe.
    ev_url = |https://verificacfdi.facturaelectronica.sat.gob.mx/default.aspx?&id={ iv_uuid }&re={ lv_re }&rr={ lv_rr }&tt={ lv_tt }&fe={ lv_fe }|.

    " Limpia saltos/espacios por el literal multilínea (solo por estética)
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf IN ev_url WITH ''.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>newline IN ev_url WITH ''.
    CONDENSE ev_url NO-GAPS.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->BUILD_XML
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEAD                        TYPE        ZET_HEAD_40
* | [--->] IS_DET                         TYPE        ZET_DET_40(optional)
* | [<-->] CT_XML                         TYPE        TY_XML_TT(optional)
* | [<-()] RV_XML                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD build_xml.

    DATA: lv_xml  TYPE string,
          ls_head TYPE zet_head_40.

    " Copiar datos para validación
    ls_head = is_head.

    " Validar folio
    IF ls_head-folio_xml IS INITIAL.
*   ls_head-folio_xml = |SIN_FOLIO_{ sy-datum }|.
      ls_head-folio_xml = |SIN_ID_{ sy-datum }_{ sy-uname }|.
    ENDIF.

    "----------------------------------------------------
    " Cabecera
    "----------------------------------------------------
    me->build_cabecera(
      EXPORTING is_head = ls_head
      CHANGING  ct_xml  = ct_xml
    ).

    "----------------------------------------------------
    " Conceptos
    "----------------------------------------------------
    me->build_conceptos(
      CHANGING ct_xml = ct_xml
    ).

    "----------------------------------------------------
    " Impuestos totales
    "----------------------------------------------------
    me->build_impuestos_totales(
      EXPORTING
        is_head    = ls_head
        iv_version = '4.0'
      CHANGING
        ct_xml     = ct_xml
    ).

    "----------------------------------------------------
    " Cierre del comprobante
    "----------------------------------------------------
    me->close_tag( EXPORTING iv_tag = 'cfdi:Comprobante' CHANGING ct_xml = ct_xml ).

    " XML final
    rv_xml = lv_xml.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->BUILD_XML_IXML
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEAD                        TYPE        ZET_HEAD_40
* | [<-->] CT_XML                         TYPE        TY_XML_TT
* | [<-()] RV_XML                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD build_xml_ixml.

  "--------------------------------------------------------------
  " 1) Preparar datos de cabecera
  "--------------------------------------------------------------
  DATA ls_head TYPE zet_head_40.

  ls_head = is_head.

  IF ls_head-folio_xml IS INITIAL.
    ls_head-folio_xml = |SIN_ID_{ sy-datum }_{ sy-uname }|.
  ENDIF.

  "--------------------------------------------------------------
  " 2) Crear documento iXML y nodo raíz
  "--------------------------------------------------------------
  DATA: lo_ixml TYPE REF TO if_ixml,
        lo_doc  TYPE REF TO if_ixml_document,
        lo_root TYPE REF TO if_ixml_element.

  lo_ixml = cl_ixml=>create( ).
  lo_doc  = lo_ixml->create_document( ).

  "--------------------------------------------------------------
  " 3) Cabecera <cfdi:Comprobante>
  "--------------------------------------------------------------
  me->build_cabecera_ixml(
    EXPORTING
      is_head = ls_head
    CHANGING
      co_doc  = lo_doc
      co_root = lo_root ).

  "--------------------------------------------------------------
  " 4) Conceptos <cfdi:Conceptos>/<cfdi:Concepto>
  "--------------------------------------------------------------
  me->build_conceptos_ixml(
    CHANGING
      co_parent = lo_root ).

  "--------------------------------------------------------------
  " 5) Impuestos totales <cfdi:Impuestos>
  "--------------------------------------------------------------
  me->build_impuestos_totales_ixml(
    EXPORTING
      is_head   = ls_head
    CHANGING
      co_parent = lo_root ).

  "--------------------------------------------------------------
  " 6) FACTURA: NO COMPLEMENTOS
  "   (no llamamos build_complementos_ixml)
  "--------------------------------------------------------------

  "--------------------------------------------------------------
  " 7) Renderizar XML a STRING
  "--------------------------------------------------------------
  DATA: lo_stream_factory TYPE REF TO if_ixml_stream_factory,
        lo_ostream        TYPE REF TO if_ixml_ostream,
        lo_renderer       TYPE REF TO if_ixml_renderer,
        lv_xml            TYPE string.

  lo_stream_factory = lo_ixml->create_stream_factory( ).
  lo_ostream        = lo_stream_factory->create_ostream_cstring( lv_xml ).

  lo_renderer = lo_ixml->create_renderer(
                  document = lo_doc
                  ostream  = lo_ostream ).

  lo_renderer->render( ).

  rv_xml = lv_xml.

  "--------------------------------------------------------------
  " 8) Normalizar prolog XML para el PAC
  "    - quitar espacios al inicio
  "    - quitar cualquier <?xml ...?> que haya puesto iXML
  "    - agregar nuestra cabecera UTF-8
  "--------------------------------------------------------------
  " 8.1: quitar espacios iniciales
  SHIFT rv_xml LEFT DELETING LEADING space.

  " 8.2: quitar declaración XML previa (si existe)
  DATA(lv_body) = rv_xml.
  REPLACE FIRST OCCURRENCE OF REGEX '<\?xml.*\?>' IN lv_body WITH ''.

  " 8.3: quitar espacios después de borrar la declaración
  SHIFT lv_body LEFT DELETING LEADING space.

  " 8.4: armar XML final con cabecera correcta
  rv_xml = |<?xml version="1.0" encoding="UTF-8"?>{ lv_body }|.

  "--------------------------------------------------------------
  " 9) Llenar ct_xml para logs / monitor
  "--------------------------------------------------------------
  CLEAR ct_xml.
  APPEND VALUE ty_xml( linea = rv_xml ) TO ct_xml.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->CALL_TIMBRADO
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_XML                          TYPE        STRING
* | [<---] E_UUID                         TYPE        ZUUID
* | [<---] E_URL                          TYPE        ZQR40
* | [<---] E_XML_TIMB                     TYPE        STRING
* | [<---] E_ERR_XSTR                     TYPE        XSTRING
* | [<---] E_ERR_XML                      TYPE        STRING
* | [<---] E_ERR_MSG                      TYPE        STRING
* | [<---] E_ERR_CODE                     TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD call_timbrado.
    DATA: lv_apikey    TYPE string,
          l_string     TYPE string,
          l_xstring    TYPE xstring,
          xml_document TYPE REF TO if_ixml_document,
          xml_root     TYPE REF TO if_ixml_element,
          xml_element  TYPE REF TO if_ixml_element,
          name         TYPE string,
          namespace    TYPE string,
          ws_header    TYPE REF TO if_wsprotocol_ws_header,
          msg_error    TYPE string.

    DATA: ls_head       TYPE zet_head_40,
          va_xml_string TYPE string.

    CLEAR: e_uuid, e_url, e_xml_timb, e_err_xstr, e_err_xml, e_err_msg, e_err_code.

    " Head (ya cargado con SET_DATA)
    READ TABLE mt_head INTO ls_head INDEX 1.
    va_xml_string = i_xml.

    " API KEY por BUKRS
    SELECT SINGLE apikey
      FROM zfe_apikey_all
      INTO @lv_apikey
      WHERE bukrs = @ls_head-bukrs.
    IF sy-subrc <> 0 OR lv_apikey IS INITIAL.
      e_err_msg = 'API Key no configurada para la sociedad.'.
      RETURN.
    ENDIF.

    " ================== PROXIES / TIPOS ==================
    DATA: ws_timbrarpro TYPE REF TO zpro_co_iemision,
          ws_timbrardes TYPE REF TO ztest_co_iemision.

    DATA: st_input_p  TYPE zpro_emitir_comprobante_reques,
          ls_output   TYPE zpro_emitir_comprobante_respon,
          st_input_t  TYPE ztest_emitir_comprobante_reque,
          st_output_t TYPE ztest_emitir_comprobante_respo.

    " QA props (si las usas)
    DATA: it_properties_t TYPE TABLE OF ztest_transaction_property,
          st_properties_t TYPE ztest_transaction_property.

    CLEAR: st_input_p, st_input_t, ls_output, st_output_t.

    " ==============================================
    " Conversión de XML a XSTRING para enviar al PAC
    " ==============================================
    DATA lv_xml_xstr TYPE xstring.

    CALL FUNCTION 'SCMS_STRING_TO_XSTRING'
      EXPORTING
        text     = va_xml_string
        mimetype = 'text/xml; charset=UTF-8'
      IMPORTING
        buffer   = lv_xml_xstr.

    st_input_p-comprobante = lv_xml_xstr.
    st_input_t-comprobante = lv_xml_xstr.

    " ================== PRODUCTIVO / QA ==================
    IF sy-sysid = 'TPP'.
      " -------- PRODUCTIVO --------
      TRY.
          CREATE OBJECT ws_timbrarpro
            EXPORTING
              logical_port_name = 'ZPRO_CO_IEMISION_PORT'.

          ws_header ?= ws_timbrarpro->get_protocol( 'IF_WSPROTOCOL_WS_HEADER' ).

          CONCATENATE
            '<soapenv:Header>'
            '<cus:ApiKey  xmlns:cus="http://www.reachcore.com/CFDI/customHeaders">'
            lv_apikey
            '</cus:ApiKey>'
            '</soapenv:Header>'
            INTO l_string.
          l_xstring = cl_proxy_service=>cstring2xstring( l_string ).

          IF l_string IS NOT INITIAL.
            CALL FUNCTION 'SDIXML_XML_TO_DOM'
              EXPORTING
                xml           = l_xstring
              IMPORTING
                document      = xml_document
              EXCEPTIONS
                invalid_input = 1
                OTHERS        = 2.
            IF sy-subrc = 0 AND xml_document IS BOUND.
              xml_root = xml_document->get_root_element( ).
              xml_element ?= xml_root->get_first_child( ).
              WHILE xml_element IS BOUND.
                name      = xml_element->get_name( ).
                namespace = xml_element->get_namespace_uri( ).
                ws_header->set_request_header( EXPORTING name = name namespace = namespace dom = xml_element ).
                xml_element ?= xml_element->get_next( ).
              ENDWHILE.
            ENDIF.
          ENDIF.

          ws_timbrarpro->emitir_comprobante(
            EXPORTING  emitir_comprobante_request  = st_input_p
            IMPORTING  emitir_comprobante_response = ls_output ).

        CATCH cx_ai_system_fault INTO DATA(lx_sys_p).
          msg_error = lx_sys_p->get_text( ).
        CATCH cx_ai_application_fault INTO DATA(lx_app_p).
          msg_error = lx_app_p->get_text( ).
      ENDTRY.

    ELSE.
      " -------- QA / DESARROLLO --------
      TRY.
          CREATE OBJECT ws_timbrardes
            EXPORTING
              logical_port_name = 'ZTEST_CO_IEMISION_PORT'.

          ws_header ?= ws_timbrardes->get_protocol( 'IF_WSPROTOCOL_WS_HEADER' ).

          CONCATENATE
            '<soapenv:Header>'
            '<cus:ApiKey  xmlns:cus="http://www.reachcore.com/CFDI/customHeaders">'
            lv_apikey
            '</cus:ApiKey>'
            '</soapenv:Header>'
            INTO l_string.
          l_xstring = cl_proxy_service=>cstring2xstring( l_string ).

          IF l_string IS NOT INITIAL.
            CALL FUNCTION 'SDIXML_XML_TO_DOM'
              EXPORTING
                xml           = l_xstring
              IMPORTING
                document      = xml_document
              EXCEPTIONS
                invalid_input = 1
                OTHERS        = 2.
            IF sy-subrc = 0 AND xml_document IS BOUND.
              xml_root = xml_document->get_root_element( ).
              xml_element ?= xml_root->get_first_child( ).
              WHILE xml_element IS BOUND.
                name      = xml_element->get_name( ).
                namespace = xml_element->get_namespace_uri( ).
                ws_header->set_request_header( name = name namespace = namespace dom = xml_element ).
                xml_element ?= xml_element->get_next( ).
              ENDWHILE.
            ENDIF.
          ENDIF.

          " Propiedades QA (si aplica)
          CLEAR: it_properties_t, st_properties_t.
          st_properties_t-key   = 'TipoCFD'.
          st_properties_t-value = 'Factura'.
          APPEND st_properties_t TO it_properties_t.
          st_input_t-transaction_properties-transaction_property = it_properties_t.

          ws_timbrardes->emitir_comprobante(
            EXPORTING  emitir_comprobante_request  = st_input_t
            IMPORTING  emitir_comprobante_response = st_output_t ).

        CATCH cx_ai_system_fault INTO DATA(lx_sys_t).
          msg_error = lx_sys_t->get_text( ).
        CATCH cx_ai_application_fault INTO DATA(lx_app_t).
          msg_error = lx_app_t->get_text( ).
      ENDTRY.
    ENDIF.

    " ================== ERROR DEL PROXY ==================
    IF msg_error IS NOT INITIAL.
      e_err_msg = msg_error.
      RETURN.
    ENDIF.

    " ================== ERROR DEL PAC (InnerErrors) ==================
    CLEAR: e_err_xstr, e_err_xml, e_err_msg, e_err_code.
    IF ls_output-error-inner_errors IS NOT INITIAL.
      e_err_xstr = ls_output-error-inner_errors.
    ELSEIF st_output_t-error-inner_errors IS NOT INITIAL.
      e_err_xstr = st_output_t-error-inner_errors.
    ENDIF.

    IF e_err_xstr IS NOT INITIAL.
      CALL FUNCTION 'ECATT_CONV_XSTRING_TO_STRING'
        EXPORTING
          im_xstring  = e_err_xstr
          im_encoding = 'UTF-8'
        IMPORTING
          ex_string   = e_err_xml.

      DATA: lt_xml TYPE TABLE OF smum_xmltb,
            lt_ret TYPE TABLE OF bapiret2,
            ls_xml TYPE smum_xmltb.

      CALL FUNCTION 'SMUM_XML_PARSE'
        EXPORTING
          xml_input = e_err_xstr
        TABLES
          xml_table = lt_xml
          return    = lt_ret.

      LOOP AT lt_xml INTO ls_xml WHERE cname = 'Message' OR cname = 'Code'.
        IF ls_xml-cname = 'Message'.
          IF e_err_msg IS INITIAL.
            e_err_msg = ls_xml-cvalue.
          ELSE.
            CONCATENATE e_err_msg ls_xml-cvalue INTO e_err_msg SEPARATED BY ' | '.
          ENDIF.
        ELSEIF ls_xml-cname = 'Code'.
          IF e_err_code IS INITIAL.
            e_err_code = ls_xml-cvalue.
          ELSE.
            CONCATENATE e_err_code ls_xml-cvalue INTO e_err_code SEPARATED BY ','.
          ENDIF.
        ENDIF.
      ENDLOOP.

      RETURN.
    ENDIF.

    " ================== ARMAR RESPUESTA (XML, UUID, URL) ==================
    me->armar_respuesta_timbrado(
      EXPORTING
        is_output_prod = ls_output
        is_output_qa   = st_output_t
      IMPORTING
        e_xml_timb     = e_xml_timb
        e_uuid         = e_uuid
        e_url          = e_url
        e_trans_id     = DATA(lv_trans_id) ). " opcional

  ENDMETHOD.


