CLASS ZCL_CFDI40_NAST IMPLEMENTATION.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->ADD_ATTR
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_NAME                         TYPE        STRING
* | [--->] I_VAL                          TYPE        STRING
* | [<-->] CV_ATTR                        TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD add_attr.

    DATA: v   TYPE string,
          par TYPE string.

    v = me->trim( i_val ).
    IF v IS INITIAL.
      RETURN.
    ENDIF.

    CONCATENATE i_name '="' v '"' INTO par.

    IF cv_attr IS INITIAL.
      cv_attr = par.
    ELSE.
      CONCATENATE cv_attr par INTO cv_attr SEPARATED BY space.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->ANEXAR_XML_GOS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BUKRS                       TYPE        BUKRS
* | [--->] IV_BELNR                       TYPE        VBRK-VBELN
* | [--->] IV_GJAHR                       TYPE        GJAHR
* | [--->] IV_TIPO                        TYPE        CHAR2
* | [--->] IV_DESCRIPCION                 TYPE        SO_OBJ_DES(optional)
* | [--->] IV_XML_STR                     TYPE        STRING(optional)
* | [<---] EV_SUCCESS                     TYPE        ABAP_BOOL
* | [<---] EV_MESSAGE                     TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD anexar_xml_gos.
    DATA: lv_belnr10 TYPE vbrk-vbeln,
          lv_tipo    TYPE char2,
          lv_flag    TYPE flag,
          lv_msg     TYPE string.

    CLEAR: ev_success, ev_message.

    " --- Validaciones mínimas
    IF iv_bukrs IS INITIAL OR iv_belnr IS INITIAL OR iv_gjahr IS INITIAL.
      ev_success = abap_false.
      ev_message = 'Parámetros obligatorios vacíos (BUKRS/BELNR/GJAHR).'.
      RETURN.
    ENDIF.

    " --- VBELN a 10
    lv_belnr10 = iv_belnr.
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = lv_belnr10
      IMPORTING
        output = lv_belnr10.

    " --- Tipo en MAYÚSCULAS (default AL)
    lv_tipo = iv_tipo.
    TRANSLATE lv_tipo TO UPPER CASE.
    IF lv_tipo IS INITIAL.
      lv_tipo = 'AL'.
    ENDIF.

    " --- Llamada a la FM que hace el trabajo pesado
    TRY.
        CALL FUNCTION 'ZCFDI_40_ANEXA_XML_GOS'
          EXPORTING
            iv_bukrs       = iv_bukrs
            iv_belnr       = lv_belnr10
            iv_gjahr       = iv_gjahr
            iv_tipo        = lv_tipo
            iv_descripcion = iv_descripcion
            iv_xml_str     = iv_xml_str      " opcional
          IMPORTING
            ev_success     = lv_flag
            ev_message     = lv_msg.

        ev_success = COND abap_bool( WHEN lv_flag = 'X' THEN abap_true ELSE abap_false ).
        ev_message = lv_msg.

      CATCH cx_root INTO DATA(lx).
        ev_success = abap_false.
        ev_message = |Excepción al anexar XML GOS: { lx->get_text( ) }|.
    ENDTRY.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->ANEXA_XML
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_FACTURA                     TYPE        SWO_TYPEID
* | [--->] IV_DESCRIPCION                 TYPE        SO_OBJ_DES
* | [--->] IV_FILENAME                    TYPE        STRING
* | [--->] IV_XML_OVERRIDE                TYPE        STRING
* | [--->] IV_ORIGEN                      TYPE        CHAR3
* | [--->] IV_BUKRS                       TYPE        BUKRS
* | [--->] IV_GJAHR                       TYPE        GJAHR
* | [--->] IV_BORRA_PREV                  TYPE        ABAP_BOOL
* | [<-()] RV_OK                          TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD anexa_xml.

    DATA: p_type       TYPE swo_objtyp,
          p_key        TYPE swo_typeid,
          p_file       TYPE c LENGTH 100,
          p_desc       TYPE so_obj_des,
          lv_vbeln10   TYPE vbrk-vbeln,
          descripcion2 TYPE c LENGTH 50.

    " SAPoffice / GOS
    DATA: ls_fol_id   TYPE soodk,
          ls_obj_id   TYPE soodk,
          ls_obj_data TYPE sood1.

    DATA: it_objhead TYPE STANDARD TABLE OF soli,
          it_content TYPE STANDARD TABLE OF soli.

    " Fuentes de datos
    DATA: ls_xml40   TYPE zcfdi_40_xml,
          lt_log     TYPE TABLE OF zcfdi_xml_log,
          ls_log     TYPE zcfdi_xml_log,
          lv_xml_str TYPE string.

    DATA: lo_conv    TYPE REF TO cl_abap_conv_in_ce.
    DATA: lv_origen  TYPE string.

    " Aux para validar sufijo del nombre
    DATA: lv_len_name TYPE i,
          lv_last4    TYPE string,
          lv_last4_u  TYPE string.

    rv_ok = abap_false.

    " 1) Normaliza VBELN y arma datos base
    IF iv_factura IS INITIAL.
      RETURN.
    ENDIF.

    lv_vbeln10 = iv_factura.
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = lv_vbeln10
      IMPORTING
        output = lv_vbeln10.

    p_type = 'BUS2081'.
    p_key  = lv_vbeln10.

    IF iv_filename IS NOT INITIAL.
      p_file = iv_filename.
    ELSE.
      CONCATENATE 'CFDI_' lv_vbeln10 '.xml' INTO p_file.
    ENDIF.

    IF iv_descripcion IS INITIAL.
      descripcion2 = 'CFDI XML'.
    ELSE.
      CONCATENATE iv_descripcion 'XML' INTO descripcion2 SEPARATED BY space.
    ENDIF.
    p_desc = descripcion2.

    " 2) Borrar anexos previos si aplica (no bloquea si falla)
    IF iv_borra_prev = abap_true.
      CALL FUNCTION 'ZDELETE_ANEXO_XML'
        EXPORTING
          factura          = lv_vbeln10
        EXCEPTIONS
          factura_invalida = 1
          OTHERS           = 2.
    ENDIF.

    " 3) Resolver contenido según iv_origen
    lv_origen = iv_origen.
    TRANSLATE lv_origen TO UPPER CASE.

    CASE lv_origen.
      WHEN 'OVR'.
        IF iv_xml_override IS NOT INITIAL.
          lv_xml_str = iv_xml_override.
        ENDIF.

      WHEN 'LOG'.
        REFRESH lt_log.
        SELECT *
          FROM zcfdi_xml_log
          INTO TABLE lt_log
          WHERE belnr    = lv_vbeln10
            AND bukrs    = iv_bukrs
            AND gjahr    = iv_gjahr
            AND tipo_doc = 'RQ'.
        IF sy-subrc = 0.
          SORT lt_log BY created_on DESCENDING created_at DESCENDING.
          READ TABLE lt_log INDEX 1 INTO ls_log.
          IF sy-subrc = 0 AND ls_log-xml_req IS NOT INITIAL.
            TRY.
                lo_conv = cl_abap_conv_in_ce=>create(
                            input    = ls_log-xml_req
                            encoding = 'UTF-8' ).
                lo_conv->read( IMPORTING data = lv_xml_str ).
              CATCH cx_sy_codepage_converter_init
                    cx_sy_conversion_codepage
                    cx_parameter_invalid_range.
                RETURN.
            ENDTRY.
          ENDIF.
        ENDIF.

      WHEN 'ERT'.
        REFRESH lt_log.
        SELECT *
          FROM zcfdi_xml_log
          INTO TABLE lt_log
          WHERE belnr    = lv_vbeln10
            AND bukrs    = iv_bukrs
            AND gjahr    = iv_gjahr
            AND tipo_doc = 'ER'.
        IF sy-subrc = 0.
          SORT lt_log BY created_on DESCENDING created_at DESCENDING.
          READ TABLE lt_log INDEX 1 INTO ls_log.
          IF sy-subrc = 0 AND ls_log-xml_req IS NOT INITIAL.
            TRY.
                lo_conv = cl_abap_conv_in_ce=>create(
                            input    = ls_log-xml_req
                            encoding = 'UTF-8' ).
                lo_conv->read( IMPORTING data = lv_xml_str ).
              CATCH cx_sy_codepage_converter_init
                    cx_sy_conversion_codepage
                    cx_parameter_invalid_range.
                RETURN.
            ENDTRY.
          ENDIF.
        ENDIF.

      WHEN 'XML'.
        CLEAR ls_xml40.
        SELECT SINGLE * FROM zcfdi_40_xml INTO ls_xml40 WHERE factura = lv_vbeln10.
        IF sy-subrc = 0 AND ls_xml40-xml IS NOT INITIAL.
          lv_xml_str = ls_xml40-xml.
        ENDIF.
    ENDCASE.

    " 3.b) Fallbacks
    IF lv_xml_str IS INITIAL AND lv_origen <> 'LOG'.
      REFRESH lt_log.
      SELECT *
        FROM zcfdi_xml_log
        INTO TABLE lt_log
        WHERE belnr = lv_vbeln10
          AND bukrs = iv_bukrs
          AND gjahr = iv_gjahr.
      IF sy-subrc = 0.
        SORT lt_log BY created_on DESCENDING created_at DESCENDING.
        READ TABLE lt_log INDEX 1 INTO ls_log.
        IF sy-subrc = 0 AND ls_log-xml_req IS NOT INITIAL.
          TRY.
              lo_conv = cl_abap_conv_in_ce=>create(
                          input    = ls_log-xml_req
                          encoding = 'UTF-8' ).
              lo_conv->read( IMPORTING data = lv_xml_str ).
            CATCH cx_sy_codepage_converter_init
                  cx_sy_conversion_codepage
                  cx_parameter_invalid_range.
              RETURN.
          ENDTRY.
        ENDIF.
      ENDIF.
    ENDIF.

    IF lv_xml_str IS INITIAL AND lv_origen <> 'XML'.
      CLEAR ls_xml40.
      SELECT SINGLE * FROM zcfdi_40_xml INTO ls_xml40 WHERE factura = lv_vbeln10.
      IF sy-subrc = 0 AND ls_xml40-xml IS NOT INITIAL.
        lv_xml_str = ls_xml40-xml.
      ENDIF.
    ENDIF.

    IF lv_xml_str IS INITIAL.
      RETURN. " no hay nada que adjuntar
    ENDIF.

    " 4) STRING -> soli[] y cabecera de archivo
    REFRESH: it_content, it_objhead.
    CALL FUNCTION 'SO_STRING_TO_TAB'
      EXPORTING
        content_str = lv_xml_str
      TABLES
        content_tab = it_content.
    IF it_content IS INITIAL.
      RETURN.
    ENDIF.
    DATA(lv_len_namex) = strlen( p_file ).


    IF lv_len_namex >= 4.
      DATA(lv_last4x) = substring( val = p_file off = lv_len_namex - 4 len = 4 ).
      lv_last4_u = lv_last4x.
      TRANSLATE lv_last4_u TO UPPER CASE.
    ENDIF.

    IF lv_last4_u <> '.XML'.
      CONCATENATE p_file '.xml' INTO p_file.
    ENDIF.


    " Nombre de archivo en cabecera (&SO_FILENAME=...)
    APPEND VALUE soli( line = |&SO_FILENAME={ p_file }| ) TO it_objhead.

    " 5) Carpeta raíz Business Documents
    CALL FUNCTION 'SO_FOLDER_ROOT_ID_GET'
      EXPORTING
        region    = 'B'
      IMPORTING
        folder_id = ls_fol_id
      EXCEPTIONS
        OTHERS    = 1.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.
    " 6) Datos del objeto SAPoffice (NO llenar OBJNAM: es NUMC(12))
    CLEAR ls_obj_data.
    ls_obj_data-objsns   = 'O'.
    ls_obj_data-objla    = sy-langu.
    ls_obj_data-objdes   = p_desc.
    ls_obj_data-file_ext = 'xml'.                 " sin punto
    ls_obj_data-objlen   = strlen( lv_xml_str ).
    CLEAR ls_obj_data-objnam.                     " <- MUY IMPORTANTE

    " 7) Crear objeto SAPoffice (RAW)
    CALL FUNCTION 'SO_OBJECT_INSERT'
      EXPORTING
        folder_id        = ls_fol_id
        object_type      = 'RAW'
        object_hd_change = ls_obj_data
      IMPORTING
        object_id        = ls_obj_id
      TABLES
        objhead          = it_objhead   " debe incluir &SO_FILENAME=CFDI_...xml
        objcont          = it_content
      EXCEPTIONS
        OTHERS           = 1.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.


    " 8) Relación GOS (ATTA) sin COMMIT aquí
    DATA: ls_rolea     TYPE borident,
          ls_roleb     TYPE borident,
          lv_vbeln_pad TYPE vbeln.

    lv_vbeln_pad     = |{ lv_vbeln10 ALPHA = IN }|.
    ls_rolea-objtype = 'BUS2081'.
    ls_rolea-objkey  = lv_vbeln_pad.

    ls_roleb-objtype = 'MESSAGE'.
    ls_roleb-objkey  = |{ ls_obj_id-objtp }{ ls_obj_id-objyr }{ ls_obj_id-objno }|.

    CALL FUNCTION 'BINARY_RELATION_CREATE'
      EXPORTING
        obj_rolea      = ls_rolea
        obj_roleb      = ls_roleb
        relationtype   = 'ATTA'
      EXCEPTIONS
        no_model       = 1
        internal_error = 2
        unknown        = 3
        OTHERS         = 4.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    " (Opcional) En diálogo, confirma y refresca GUI fuera de update task
    " IF cl_system_transaction_state=>is_in_update_task( ) = abap_false.
    "   COMMIT WORK AND WAIT.
    "   cl_gui_cfw=>flush( ).
    " ENDIF.

    rv_ok = abap_true.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->APPEND_LINE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_LINE                        TYPE        STRING
* | [<-->] CT_XML                         TYPE        ANY TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD append_line.
    FIELD-SYMBOLS <tab> TYPE STANDARD TABLE.
    FIELD-SYMBOLS <row> TYPE any.
    FIELD-SYMBOLS <cmp> TYPE any.
    DATA lr TYPE REF TO data.
    ASSIGN ct_xml TO <tab>.
    IF sy-subrc <> 0. RETURN. ENDIF.
    CREATE DATA lr LIKE LINE OF <tab>.
    ASSIGN lr->* TO <row>.
    IF sy-subrc <> 0. RETURN. ENDIF.

    ASSIGN COMPONENT 'LINEA' OF STRUCTURE <row> TO <cmp>.
    IF sy-subrc <> 0 OR <cmp> IS NOT ASSIGNED.
      ASSIGN COMPONENT 'linea' OF STRUCTURE <row> TO <cmp>.
    ENDIF.
    IF sy-subrc <> 0 OR <cmp> IS NOT ASSIGNED.
      ASSIGN COMPONENT 'RAW' OF STRUCTURE <row> TO <cmp>.
    ENDIF.

    IF sy-subrc = 0 AND <cmp> IS ASSIGNED.
      <cmp> = iv_line.
      APPEND <row> TO <tab>.
    ENDIF.
  ENDMETHOD.


