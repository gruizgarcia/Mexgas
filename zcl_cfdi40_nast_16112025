* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->RECUPERAR_DATOS_CFDI_RECEPTOR
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_KUNNR                       TYPE        KUNNR
* | [--->] IV_VKORG                       TYPE        VKORG(optional)
* | [--->] IV_VTWEG                       TYPE        VTWEG(optional)
* | [--->] IV_SPART                       TYPE        SPART(optional)
* | [<---] EV_METPAG                      TYPE        STRING
* | [<---] EV_FORMAPAGO                   TYPE        STRING
* | [<---] EV_USOCFDI                     TYPE        STRING
* | [<---] EV_NOMBRE                      TYPE        STRING
* | [<---] EV_REGFISCAL                   TYPE        STRING
* | [<---] EV_DOMFISCAL                   TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD recuperar_datos_cfdi_receptor.
    "============================================================
    " Obtiene:
    "  - KVGR1..KVGR4 de KNVV (prioridad por VKORG/VTWEG/SPART)
    "  - Nombre (KNA1) y CP vigente (ADRC)
    " Normaliza forma de pago (2 dígitos) y aplica regla SAT PPD→'99'
    "============================================================

    "---- Variables KNVV
    DATA: lv_kvgr1 TYPE knvv-kvgr1,  " Uso CFDI
          lv_kvgr2 TYPE knvv-kvgr2,  " Método de pago (PUE/PPD)
          lv_kvgr3 TYPE knvv-kvgr3,  " Régimen fiscal
          lv_kvgr4 TYPE knvv-kvgr4.  " Forma de pago (01..99)

    DATA lv_got_knvv TYPE abap_bool VALUE abap_false.

    CLEAR: lv_kvgr1, lv_kvgr2, lv_kvgr3, lv_kvgr4.

    "---- 1) KNVV por área de ventas (si llega informada)
    IF iv_vkorg IS NOT INITIAL AND iv_vtweg IS NOT INITIAL AND iv_spart IS NOT INITIAL.
      SELECT SINGLE kvgr1, kvgr2, kvgr3, kvgr4
        FROM knvv
        INTO (@lv_kvgr1, @lv_kvgr2, @lv_kvgr3, @lv_kvgr4)
        WHERE kunnr = @iv_kunnr
          AND vkorg = @iv_vkorg
          AND vtweg = @iv_vtweg
          AND spart = @iv_spart.
      IF sy-subrc = 0.
        lv_got_knvv = abap_true.
      ENDIF.
    ENDIF.

    "---- 2) Fallback: cualquier KNVV con al menos un KVGR informado
    IF lv_got_knvv = abap_false.
      SELECT kvgr1, kvgr2, kvgr3, kvgr4
        FROM knvv
        WHERE kunnr = @iv_kunnr
          AND ( kvgr1 <> '' OR kvgr2 <> '' OR kvgr3 <> '' OR kvgr4 <> '' )
        INTO (@lv_kvgr1, @lv_kvgr2, @lv_kvgr3, @lv_kvgr4)
        UP TO 1 ROWS.
      ENDSELECT.
      IF sy-subrc = 0.
        lv_got_knvv = abap_true.
      ENDIF.
    ENDIF.

    "---- 3) Último recurso: cualquier registro KNVV del cliente
    IF lv_got_knvv = abap_false.
      SELECT kvgr1, kvgr2, kvgr3, kvgr4
        FROM knvv
        WHERE kunnr = @iv_kunnr
        INTO (@lv_kvgr1, @lv_kvgr2, @lv_kvgr3, @lv_kvgr4)
        UP TO 1 ROWS.
      ENDSELECT.
    ENDIF.

    "---- 4) Asignar salidas desde KVGR* y normalizar
    CLEAR: ev_usocfdi, ev_metpag, ev_regfiscal, ev_formapago.
    ev_usocfdi   = lv_kvgr1.   " KVGR1 → UsoCFDI
    ev_metpag    = lv_kvgr2.   " KVGR2 → Método (PUE/PPD)
    ev_regfiscal = lv_kvgr3.   " KVGR3 → Régimen fiscal
    ev_formapago = lv_kvgr4.   " KVGR4 → Forma de pago (01..99)

    TRANSLATE ev_usocfdi   TO UPPER CASE.
    TRANSLATE ev_metpag    TO UPPER CASE.
    TRANSLATE ev_regfiscal TO UPPER CASE.
    TRANSLATE ev_formapago TO UPPER CASE.

    " Forma de pago: solo dígitos y 2 posiciones
    IF ev_formapago IS NOT INITIAL.
      DATA(lv_fp) = CONV string( ev_formapago ).
      REPLACE ALL OCCURRENCES OF REGEX '[^0-9]' IN lv_fp WITH ''.
      CASE strlen( lv_fp ).
        WHEN 0. CLEAR ev_formapago.
        WHEN 1. ev_formapago = |0{ lv_fp }|.
        WHEN 2. ev_formapago = lv_fp.
        WHEN OTHERS. ev_formapago = lv_fp+0(2).
      ENDCASE.
    ENDIF.

    " Regla SAT: si es PPD y no hay forma, usar '99'
    IF ev_metpag = 'PPD' AND ev_formapago IS INITIAL.
      ev_formapago = '99'.
    ENDIF.

    "============================================================
    " COMPLEMENTO dentro del mismo método: Nombre y CP vigente
    "============================================================
    CLEAR: ev_nombre, ev_domfiscal.

    "---- 5) Nombre desde KNA1 (NAME1..NAME4)
    DATA: lv_name1 TYPE kna1-name1,
          lv_name2 TYPE kna1-name2,
          lv_name3 TYPE kna1-name3,
          lv_name4 TYPE kna1-name4,
          lv_adrnr TYPE kna1-adrnr.


    SELECT SINGLE name1, name2, name3, name4, adrnr, katr6
      FROM kna1
      INTO (@lv_name1, @lv_name2, @lv_name3, @lv_name4, @lv_adrnr, @ev_regfiscal)
      WHERE kunnr = @iv_kunnr.

    CONCATENATE lv_name1 lv_name2 lv_name3 lv_name4 INTO ev_nombre SEPARATED BY space.
    CONDENSE ev_nombre.

    "---- 6) CP vigente desde ADRC (más reciente con date_from <= hoy)
    IF lv_adrnr IS NOT INITIAL.
      DATA: lv_cp   TYPE adrc-post_code1,
            lv_pais TYPE adrc-country.

      SELECT post_code1, country
        FROM adrc
        WHERE addrnumber = @lv_adrnr
          AND date_from  <= @sy-datum
        ORDER BY date_from DESCENDING
        INTO (@lv_cp, @lv_pais)
        UP TO 1 ROWS.
      ENDSELECT.

      " Fallback: cualquier entrada del ADRNR si no hubo vigente
      IF lv_cp IS INITIAL.
        SELECT SINGLE post_code1, country
          FROM adrc
          INTO (@lv_cp, @lv_pais)
          WHERE addrnumber = @lv_adrnr.
      ENDIF.

      ev_domfiscal = lv_cp.

      " Normalización de CP (sin parametría)
      IF ev_domfiscal IS NOT INITIAL.
        REPLACE ALL OCCURRENCES OF REGEX '[^0-9]' IN ev_domfiscal WITH ''.
        IF lv_pais = 'MX'.
          CASE strlen( ev_domfiscal ).
            WHEN 4. ev_domfiscal = |0{ ev_domfiscal }|.
            WHEN 5. " ok
            WHEN OTHERS.
              IF strlen( ev_domfiscal ) > 5.
                ev_domfiscal = ev_domfiscal+0(5).
              ENDIF.
          ENDCASE.
        ELSE.
          " Para otros países no forzar longitud; solo limitar a 10
          IF strlen( ev_domfiscal ) > 10.
            ev_domfiscal = ev_domfiscal+0(10).
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->REFRESH_DET_FROM_Z
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BELNR                       TYPE        VBRK-VBELN
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD refresh_det_from_z.
    " Lee ZCFDI_DET_40 y vuelca IVA_PORCENTAJE al buffer me->mt_det
    DATA: lt_z TYPE TABLE OF zcfdi_det_40,
          ls_z TYPE zcfdi_det_40.

    SELECT * FROM zcfdi_det_40 INTO TABLE lt_z WHERE belnr = iv_belnr.
    IF sy-subrc <> 0 OR lt_z IS INITIAL.
      RETURN.
    ENDIF.

    FIELD-SYMBOLS:
      <d>         TYPE any,
      <f_matnr>   TYPE any,
      <f_noid>    TYPE any,
      <f_qty>     TYPE any,
      <f_unit>    TYPE any,
      <f_amt>     TYPE any,
      <f_objimp>  TYPE any,
      <f_tasa>    TYPE any,
      <f_ivaperc> TYPE any.

    LOOP AT me->mt_det ASSIGNING <d>.
      UNASSIGN: <f_matnr>,<f_noid>,<f_qty>,<f_unit>,<f_amt>,<f_objimp>,
      <f_tasa>,<f_ivaperc>.
      ASSIGN COMPONENT 'MATNR'            OF STRUCTURE <d> TO <f_matnr>.
      ASSIGN COMPONENT 'NOIDENTIFICACION' OF STRUCTURE <d> TO <f_noid>.
      ASSIGN COMPONENT 'CANTIDAD'         OF STRUCTURE <d> TO <f_qty>.
      IF <f_qty>  IS NOT ASSIGNED. ASSIGN COMPONENT 'FKIMG'  OF STRUCTURE <d> TO <f_qty>.  ENDIF.
      ASSIGN COMPONENT 'VALOR_UNITARIO'   OF STRUCTURE <d> TO <f_unit>.
      IF <f_unit> IS NOT ASSIGNED. ASSIGN COMPONENT 'VALOR_UNIT' OF STRUCTURE <d> TO <f_unit>. ENDIF.
      ASSIGN COMPONENT 'IMPORTE'          OF STRUCTURE <d> TO <f_amt>.
      IF <f_amt>  IS NOT ASSIGNED. ASSIGN COMPONENT 'NETWR'  OF STRUCTURE <d> TO <f_amt>.  ENDIF.
      ASSIGN COMPONENT 'OBJETOIMP'        OF STRUCTURE <d> TO <f_objimp>.
      ASSIGN COMPONENT 'TASAOCUOTA'       OF STRUCTURE <d> TO <f_tasa>.
      ASSIGN COMPONENT 'IVA_PORCENTAJE'   OF STRUCTURE <d> TO <f_ivaperc>.

      " 1) Match por MATNR (PROD_EKA) y fallback por NoIdentificacion
      READ TABLE lt_z INTO ls_z WITH KEY prod_eka = CONV zcfdi_det_40-prod_eka( <f_matnr> ).
      IF sy-subrc <> 0 AND <f_noid> IS ASSIGNED AND <f_noid> IS NOT INITIAL.
        READ TABLE lt_z INTO ls_z WITH KEY prod_eka = CONV zcfdi_det_40-prod_eka( <f_noid> ).
      ENDIF.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      " 2) Normaliza porcentaje -> tasa (0.16, 0.00, etc.)
      DATA(lv_rate) = CONV decfloat34( ls_z-iva_porcentaje ).
      IF lv_rate > 1.  lv_rate = lv_rate / 100. ENDIF.
      IF lv_rate < 0.  lv_rate = 0.            ENDIF.

      " 3) Escribe tasa en los campos estándar del buffer
      IF <f_ivaperc> IS ASSIGNED. <f_ivaperc> = lv_rate. ENDIF.
      IF <f_tasa>    IS ASSIGNED. <f_tasa>    = lv_rate. ENDIF.

      " 4) ObjetoImp: '02' si gravado (incluye 0%), '01' si exento
      IF <f_objimp> IS ASSIGNED.
        IF lv_rate >= 0.          " Para 0% sigue siendo 02 (no exento)
          <f_objimp> = '02'.
        ENDIF.
        IF lv_rate = 0 AND ls_z-importe_iva IS INITIAL.
          " Si explícitamente quieres marcar EXENTO (objeto 01), comenta el IF anterior y usa esto:
          " <f_objimp> = '01'.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->SANITIZAR_XML_FINAL
* +-------------------------------------------------------------------------------------------------+
* | [<-->] CT_XML                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD sanitizar_xml_final.

    IF ct_xml IS INITIAL.
      RETURN.
    ENDIF.

    " Quitar BOM
    DATA lv_bom TYPE c.
    lv_bom = cl_abap_conv_in_ce=>uccp( 'FEFF' ).
    REPLACE ALL OCCURRENCES OF lv_bom IN ct_xml WITH ''.

    " Quitar caracteres NULL
    DATA lv_null TYPE c.
    lv_null = cl_abap_conv_in_ce=>uccp( '0000' ).
    REPLACE ALL OCCURRENCES OF lv_null IN ct_xml WITH ''.

    " Quitar saltos de línea y tabs
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf   IN ct_xml WITH ''.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>newline IN ct_xml WITH ''.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>horizontal_tab IN ct_xml WITH ''.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>form_feed IN ct_xml WITH ''.

    " Quitar espacios al inicio y final
    SHIFT ct_xml LEFT DELETING LEADING space.
    SHIFT ct_xml RIGHT DELETING TRAILING space.

  ENDMETHOD.


