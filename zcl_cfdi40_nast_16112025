* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->CLEAN_FINAL_XML
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_XML                         TYPE        TY_XML_TT
* | [<-()] RV_XML                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD clean_final_xml.

    DATA: lv_xml_x TYPE string,
          lv_pos   TYPE i,
          lv_null  TYPE c LENGTH 1.

    " 1. Convertir tabla de líneas → string
    LOOP AT it_xml INTO DATA(ls_xml).
      lv_xml_x = lv_xml_x && ls_xml-linea.
    ENDLOOP.

    " 2. Cortar después del </cfdi:Comprobante>
    SEARCH lv_xml_x FOR '</cfdi:Comprobante>'.
    IF sy-subrc = 0.
      lv_pos   = sy-fdpos + strlen( '</cfdi:Comprobante>' ).
      lv_xml_x = lv_xml_x+0(lv_pos).
    ENDIF.

    " 3. Quitar caracteres NULL (0x00) = '#'
    lv_null = cl_abap_conv_in_ce=>uccp( '0000' ).
    REPLACE ALL OCCURRENCES OF lv_null IN lv_xml_x WITH ''.

    " 4. Regresar XML limpio
    rv_xml = lv_xml_x.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->CLEAN_XML_FRAGMENT
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_XML                         TYPE        STRING
* | [<-()] RV_CLEAN                       TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD clean_xml_fragment.

    DATA: lv_null TYPE c LENGTH 1.

    " Trabajo siempre sobre una copia
    rv_clean = iv_xml.

    " 1) Obtener el carácter Unicode U+0000 (char 0x0)
    lv_null = cl_abap_conv_in_ce=>uccp( '0000' ).

    " 2) Borrar todos los U+0000 del XML
    REPLACE ALL OCCURRENCES OF lv_null IN rv_clean WITH ''.

    " 3) (Opcional) Eliminar otros caracteres de control típicos
    "    si quieres seguir limpiando:
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>horizontal_tab
           IN rv_clean WITH ''.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf
           IN rv_clean WITH ''.

  ENDMETHOD.


