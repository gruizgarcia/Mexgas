* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_CFDI40_NAST->ARMAR_RESPUESTA_TIMBRADO
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_OUTPUT_PROD                 TYPE        ZPRO_EMITIR_COMPROBANTE_RESPON
* | [--->] IS_OUTPUT_QA                   TYPE        ZTEST_EMITIR_COMPROBANTE_RESPO
* | [<---] E_XML_TIMB                     TYPE        STRING
* | [<---] E_UUID                         TYPE        TY_CHAR36
* | [<---] E_URL                          TYPE        TY_CHAR255
* | [<---] E_TRANS_ID                     TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD armar_respuesta_timbrado.
    " IMPORTING  is_output_prod TYPE zpro_emitir_comprobante_respon
    "            is_output_qa   TYPE ztest_emitir_comprobante_respo
    " EXPORTING  e_xml_timb     TYPE string
    "            e_uuid         TYPE string
    "            e_url          TYPE string
    "            e_trans_id     TYPE string

    DATA lx        TYPE xstring.
    DATA lv_xmldec TYPE string.
    DATA lv_uuidrx TYPE string.
    DATA lx_res_q  TYPE xstring.
    DATA lx_res_p  TYPE xstring.
    DATA ls_prop   TYPE ztest_transaction_property.
    DATA lv_key    TYPE string.

    CLEAR: e_xml_timb, e_uuid, e_url, e_trans_id.

    " 1) XML timbrado desde RESULT (QA primero, luego PROD)
    IF is_output_qa-result IS NOT INITIAL.
      TRY.
          e_xml_timb = is_output_qa-result.   " STRING
        CATCH cx_sy_move_cast_error.
          lx_res_q = is_output_qa-result.     " XSTRING
          CALL FUNCTION 'ECATT_CONV_XSTRING_TO_STRING'
            EXPORTING
              im_xstring  = lx_res_q
              im_encoding = 'UTF-8'
            IMPORTING
              ex_string   = e_xml_timb.
      ENDTRY.
    ELSEIF is_output_prod-result IS NOT INITIAL.
      TRY.
          e_xml_timb = is_output_prod-result. " STRING
        CATCH cx_sy_move_cast_error.
          lx_res_p = is_output_prod-result.   " XSTRING
          CALL FUNCTION 'ECATT_CONV_XSTRING_TO_STRING'
            EXPORTING
              im_xstring  = lx_res_p
              im_encoding = 'UTF-8'
            IMPORTING
              ex_string   = e_xml_timb.
      ENDTRY.
    ENDIF.

    " 2) Si viene en Base64, decodificar
    IF e_xml_timb IS NOT INITIAL AND e_xml_timb NS '<'.
      CALL FUNCTION 'SCMS_BASE64_DECODE_STR'
        EXPORTING
          input  = e_xml_timb
        IMPORTING
          output = lv_xmldec
        EXCEPTIONS
          OTHERS = 1.
      IF sy-subrc = 0 AND lv_xmldec CS '<'.
        e_xml_timb = lv_xmldec.
      ENDIF.
    ENDIF.

    " 3) Saneado: quitar BOM UTF-8 y '#'
    IF e_xml_timb IS NOT INITIAL.
      CALL FUNCTION 'ECATT_CONV_STRING_TO_XSTRING'
        EXPORTING
          im_string   = e_xml_timb
          im_encoding = 'UTF-8'
        IMPORTING
          ex_xstring  = lx.

      CONSTANTS c_bom_utf8 TYPE xstring VALUE 'EFBBBF'.
      IF xstrlen( lx ) >= 3 AND lx(3) = c_bom_utf8.
        lx = lx+3.
      ENDIF.

      CALL FUNCTION 'ECATT_CONV_XSTRING_TO_STRING'
        EXPORTING
          im_xstring  = lx
          im_encoding = 'UTF-8'
        IMPORTING
          ex_string   = e_xml_timb.

      REPLACE ALL OCCURRENCES OF '#' IN e_xml_timb WITH ''.
      CONDENSE e_xml_timb NO-GAPS.
    ENDIF.

    " 4) UUID desde TimbreFiscalDigital
    IF e_xml_timb CS '<cfdi:Comprobante'.
      FIND REGEX 'TimbreFiscalDigital[^>]*\sUUID="([^"]+)"'
           IN e_xml_timb SUBMATCHES lv_uuidrx.
      IF lv_uuidrx IS INITIAL.
        FIND REGEX 'UUID="([0-9A-Fa-f-]{36})"'
             IN e_xml_timb SUBMATCHES lv_uuidrx.
      ENDIF.
      IF lv_uuidrx IS NOT INITIAL.
        e_uuid = lv_uuidrx(36).
      ENDIF.
    ENDIF.

    " 5) URL PDF desde props de QA (si existe)
    IF is_output_qa-transaction_properties-transaction_property IS NOT INITIAL.
      LOOP AT is_output_qa-transaction_properties-transaction_property INTO ls_prop.
        lv_key = ls_prop-key.
        TRANSLATE lv_key TO UPPER CASE.
        CONDENSE lv_key.
        IF lv_key = 'RESULT.PDFURL' OR lv_key = 'PDFURL' OR lv_key = 'URL_PDF' OR lv_key = 'RESULT.URL_PDF'.
          e_url = ls_prop-value.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.

    " 6) Transaction Id (si lo quieres guardar)
    IF is_output_qa-transaction_id IS NOT INITIAL.
      e_trans_id = is_output_qa-transaction_id.
    ELSEIF is_output_prod-transaction_id IS NOT INITIAL.
      e_trans_id = is_output_prod-transaction_id.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->ATTACH_FILE_ANY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BOR_TYPE                    TYPE        SIBFLPORB-OBJTYPE
* | [--->] IV_BOR_KEY                     TYPE        STRING
* | [--->] IV_FILENAME                    TYPE        STRING
* | [--->] IV_DESCRIPTION                 TYPE        STRING(optional)
* | [--->] IV_CONTENT_XSTR                TYPE        XSTRING(optional)
* | [--->] IV_CONTENT_STR                 TYPE        STRING(optional)
* | [--->] IT_CONTENT_SOLIX               TYPE        SOLIX_TAB(optional)
* | [--->] IV_APPSERVER_PATH              TYPE        STRING(optional)
* | [<-()] RV_OK                          TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD attach_file_any.
    DATA lv_key_conv TYPE vbrk-vbeln.
    lv_key_conv = iv_bor_key.  " ← conversión implícita de string a CHAR(10)
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = lv_key_conv
      IMPORTING
        output = lv_key_conv.

    " Adjunta un archivo al GOS (ATTA) del objeto BOR (por defecto BUS2081 – factura SD)

    DATA: lv_desc      TYPE so_obj_des,
          lv_ext3      TYPE sood1-file_ext,
          lv_total_len TYPE i.

    " --- SAPoffice / GOS
    DATA: ls_fol_id   TYPE soodk,
          ls_obj_id   TYPE soodk,
          ls_obj_data TYPE sood1,
          lt_objhead  TYPE STANDARD TABLE OF soli,
          lt_soli     TYPE STANDARD TABLE OF soli,    " contenido texto
          lt_solix    TYPE solix_tab,                 " contenido binario
          ls_object   TYPE borident,
          ls_note     TYPE borident,
          ls_folmem_k TYPE sofmk,
          lv_ep_note  TYPE borident-objkey.

    " --- Contenido buffers
    DATA: lv_xstr  TYPE xstring,
          lv_xline TYPE x LENGTH 8192.

    " --- Para SO_DOCUMENT_INSERT_API1 (binario)
    DATA: ls_doc_data   TYPE sodocchgi1.

    " --- Aux: extensión
    DATA: lt_parts TYPE STANDARD TABLE OF string WITH EMPTY KEY,
          lv_last  TYPE string.

    rv_ok = abap_false.

    " 0) Descripción y extensión (3 chars)
    lv_desc = COND so_obj_des( WHEN iv_description IS NOT INITIAL THEN iv_description ELSE iv_filename ).

    SPLIT iv_filename AT '.' INTO TABLE lt_parts.
    IF lines( lt_parts ) > 1.
      READ TABLE lt_parts INTO lv_last INDEX lines( lt_parts ).
      IF sy-subrc = 0 AND lv_last IS NOT INITIAL.
        lv_ext3 = lv_last(3).
      ELSE.
        lv_ext3 = 'BIN'.
      ENDIF.
    ELSE.
      lv_ext3 = 'BIN'.
    ENDIF.
    TRANSLATE lv_ext3 TO UPPER CASE.

    " 1) Resolver contenido (prioridad: SOLIX -> XSTRING -> PATH -> STRING)
    IF it_content_solix IS NOT INITIAL.
      lt_solix = it_content_solix.

    ELSEIF iv_content_xstr IS NOT INITIAL.
      lv_xstr = iv_content_xstr.

    ELSEIF iv_appserver_path IS NOT INITIAL.
      " Leer desde servidor de aplicación (binario)
      OPEN DATASET iv_appserver_path FOR INPUT IN BINARY MODE.
      IF sy-subrc <> 0.
        RETURN.
      ENDIF.
      DO.
        READ DATASET iv_appserver_path INTO lv_xline.
        IF sy-subrc <> 0.
          EXIT.
        ENDIF.
        lv_xstr = lv_xstr && lv_xline.
      ENDDO.
      CLOSE DATASET iv_appserver_path.

    ELSEIF iv_content_str IS NOT INITIAL.
      " texto: se convertirá a SOLI más abajo

    ELSE.
      " No hay contenido de entrada
      RETURN.
    ENDIF.

    " 2) Preparar contenido para SAPoffice
    IF lt_solix IS INITIAL AND lv_xstr IS NOT INITIAL.
      " Convertir XSTRING -> SOLIX
      CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
        EXPORTING
          buffer     = lv_xstr
        TABLES
          binary_tab = lt_solix.
    ENDIF.

    " 3) Carpeta raíz de Business Documents
    CALL FUNCTION 'SO_FOLDER_ROOT_ID_GET'
      EXPORTING
        region    = 'B'
      IMPORTING
        folder_id = ls_fol_id
      EXCEPTIONS
        OTHERS    = 1.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    IF lt_solix IS NOT INITIAL.
      CLEAR ls_doc_data.
      ls_doc_data-obj_langu = sy-langu.
      ls_doc_data-obj_descr = lv_desc.
      ls_doc_data-doc_size  = lines( lt_solix ) * 255.   " tamaño aprox.

      CALL FUNCTION 'SO_DOCUMENT_INSERT_API1'
        EXPORTING
          folder_id     = ls_fol_id
          document_data = ls_doc_data
        IMPORTING
          document_id   = ls_obj_id
        TABLES
          object_header = lt_objhead
          contents_hex  = lt_solix
        EXCEPTIONS
          OTHERS        = 1.
      IF sy-subrc <> 0.
        RETURN.
      ENDIF.

    ELSE.
      " Caso TEXTO (STRING)
      CALL FUNCTION 'SO_STRING_TO_TAB'
        EXPORTING
          content_str = iv_content_str
        TABLES
          content_tab = lt_soli.

      CLEAR ls_obj_data.
      ls_obj_data-objsns   = 'O'.
      ls_obj_data-objla    = sy-langu.
      ls_obj_data-objdes   = lv_desc.
      ls_obj_data-file_ext = lv_ext3.
      " Heurística Unicode como en tus ejemplos
      ls_obj_data-objlen   = lines( lt_soli ) * 510.

      CALL FUNCTION 'SO_OBJECT_INSERT'
        EXPORTING
          folder_id        = ls_fol_id
          object_type      = 'RAW'
          object_hd_change = ls_obj_data
        IMPORTING
          object_id        = ls_obj_id
        TABLES
          objhead          = lt_objhead
          objcont          = lt_soli
        EXCEPTIONS
          OTHERS           = 1.
      IF sy-subrc <> 0.
        RETURN.
      ENDIF.
    ENDIF.



    lv_key_conv = iv_bor_key.
    IF iv_bor_type = 'BUS2081' OR iv_bor_type = 'VBRK'.
      DATA lv_vbeln TYPE vbrk-vbeln.
      lv_vbeln = lv_key_conv.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = lv_vbeln
        IMPORTING
          output = lv_vbeln.
      lv_key_conv = lv_vbeln.
    ENDIF.

    ls_object-objtype = iv_bor_type.
    ls_object-objkey  = lv_key_conv.

    " Construir SOFM (nota) para el vínculo
    ls_folmem_k-foltp = ls_fol_id-objtp.
    ls_folmem_k-folyr = ls_fol_id-objyr.
    ls_folmem_k-folno = ls_fol_id-objno.
    ls_folmem_k-doctp = ls_obj_id-objtp.
    ls_folmem_k-docyr = ls_obj_id-objyr.
    ls_folmem_k-docno = ls_obj_id-objno.

    lv_ep_note      = CONV borident-objkey( ls_folmem_k ).
    ls_note-objtype = 'MESSAGE'.
    ls_note-objkey  = lv_ep_note.

    CALL FUNCTION 'BINARY_RELATION_CREATE'
      EXPORTING
        obj_rolea    = ls_object
        obj_roleb    = ls_note
        relationtype = 'ATTA'
      EXCEPTIONS
        OTHERS       = 1.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    " ► NACE: confirma el vínculo explícitamente
    CALL FUNCTION 'BINARY_RELATION_CREATE_COMMIT'
      EXCEPTIONS
        OTHERS = 1.

    rv_ok = abap_true.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->ATTACH_PDF_FROM_OTF
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_VBELN                       TYPE        VBRK-VBELN
* | [--->] IT_OTF                         TYPE        TY_T_ITCOO(optional)
* | [--->] IS_JOB_INFO                    TYPE        SSFCRESCL(optional)
* | [--->] IV_FILENAME                    TYPE        STRING(optional)
* | [--->] IV_DESCRIPTION                 TYPE        SO_OBJ_DES(optional)
* | [<---] EV_PDF_XSTR                    TYPE        XSTRING
* | [<---] EV_BIN_SIZE                    TYPE        I
* | [<-()] RV_OK                          TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD attach_pdf_from_otf.

    CONSTANTS: gc_bor_type TYPE sibflporb-objtype VALUE 'BUS2081'.

    DATA: lt_lines    TYPE STANDARD TABLE OF tline,
          lt_solix    TYPE solix_tab,
          lt_otf      TYPE ty_t_itcoo,
          lv_vbeln10  TYPE vbrk-vbeln,
          lv_bor_key  TYPE string,
          lv_filename TYPE string,
          lv_desc     TYPE string.

    rv_ok = abap_false.
    CLEAR: ev_pdf_xstr, ev_bin_size.

    " 1) Obtener OTF: prioridad it_otf; si no, tomar de is_job_info-otfdata
    IF it_otf IS NOT INITIAL.
      lt_otf = it_otf.
    ELSEIF is_job_info-otfdata IS NOT INITIAL.
      lt_otf = is_job_info-otfdata[].
    ELSE.
      RETURN. " No hay OTF
    ENDIF.

    " 2) Validación de clave y normalización VBELN a 10c (GOS/BUS2081)
    IF iv_vbeln IS INITIAL.
      RETURN.
    ENDIF.
    lv_vbeln10 = iv_vbeln.
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = lv_vbeln10
      IMPORTING
        output = lv_vbeln10.
    lv_bor_key = lv_vbeln10.

    " 3) Defaults de nombre/descripcion si no vienen
    lv_filename = COND string(
                    WHEN iv_filename IS NOT INITIAL
                      THEN iv_filename
                    ELSE |Factura_{ lv_vbeln10 }.pdf| ).
    lv_desc = COND so_obj_des(
                WHEN iv_description IS NOT INITIAL
                  THEN iv_description
                ELSE |PDF Factura { lv_vbeln10 }| ).

    " 4) OTF -> PDF (XSTRING) + tamaño aprox
    CALL FUNCTION 'CONVERT_OTF'
      EXPORTING
        format                = 'PDF'
        max_linewidth         = 132
      IMPORTING
        bin_filesize          = ev_bin_size
        bin_file              = ev_pdf_xstr
      TABLES
        otf                   = lt_otf
        lines                 = lt_lines
      EXCEPTIONS
        err_max_linewidth     = 1
        err_format            = 2
        err_conv_not_possible = 3
        OTHERS                = 4.
    IF sy-subrc <> 0 OR ev_pdf_xstr IS INITIAL.
      RETURN.
    ENDIF.

    " 5) XSTRING -> SOLIX y adjuntar al GOS (BUS2081)
    lt_solix = cl_document_bcs=>xstring_to_solix( ip_xstring = ev_pdf_xstr ).

    rv_ok = me->attach_file_any(
              iv_bor_type      = gc_bor_type      " GOS de factura SD
              iv_bor_key       = lv_bor_key     " SWO_TYPEID (VBELN 10c)
              iv_filename      = lv_filename
              iv_description   = lv_desc
              it_content_solix = lt_solix ).

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_CFDI40_NAST->BUILD_CABECERA
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEAD                        TYPE        ZET_HEAD_40
* | [<-->] CT_XML                         TYPE        ANY TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD build_cabecera.
    DATA: lv_attr        TYPE string,
          lv_fecha       TYPE string,
          lv_metpag      TYPE string,
          lv_usocfdi     TYPE string,
          lv_nombre      TYPE string,
          lv_regfiscal_r TYPE string,
          lv_domfiscal   TYPE string,
          lv_exportacion TYPE string,
          lv_tc_str      TYPE string,
          lv_cp_emisor   TYPE adrc-post_code1,
          lv_formapago   TYPE string.

    " === Fecha CFDI 4.0 → AAAA-MM-DDThh:mm:ss
    lv_fecha = |{ sy-datum+0(4) }-{ sy-datum+4(2) }-{ sy-datum+6(2) }T{ sy-uzeit+0(2) }:{ sy-uzeit+2(2) }:{ sy-uzeit+4(2) }|.

    " === Receptor (catálogos SAT) – con datos mínimos
    me->recuperar_datos_cfdi_receptor(
      EXPORTING
        iv_kunnr = is_head-kunnr
        iv_vkorg = is_head-vkorg      " <<< agregado
        iv_vtweg = is_head-vtweg      " <<< agregado
        iv_spart = is_head-spart      " <<< agregado
      IMPORTING
        ev_metpag    = lv_metpag
        ev_formapago = lv_formapago
        ev_usocfdi   = lv_usocfdi
        ev_nombre    = lv_nombre
        ev_regfiscal = lv_regfiscal_r
        ev_domfiscal = lv_domfiscal ).

    " === Completar desde is_head si la lectura anterior no trajo datos
    FIELD-SYMBOLS: <h_reg> TYPE any, <h_cp> TYPE any, <h_nom> TYPE any, <h_uso> TYPE any, <h_frm> TYPE any.
    ASSIGN COMPONENT 'REGIMENFISCALRECEPTOR'   OF STRUCTURE is_head TO <h_reg>.
    ASSIGN COMPONENT 'DOMICILIOFISCALRECEPTOR' OF STRUCTURE is_head TO <h_cp>.
    ASSIGN COMPONENT 'NOMBRE_RECEPTOR'         OF STRUCTURE is_head TO <h_nom>.
    ASSIGN COMPONENT 'USO_CFDI'                OF STRUCTURE is_head TO <h_uso>.
    ASSIGN COMPONENT 'FORMA_PAGO'              OF STRUCTURE is_head TO <h_frm>.

    IF lv_regfiscal_r IS INITIAL AND <h_reg> IS ASSIGNED AND <h_reg> IS NOT INITIAL.
      lv_regfiscal_r = <h_reg>.
    ENDIF.
    IF lv_domfiscal IS INITIAL AND <h_cp> IS ASSIGNED AND <h_cp> IS NOT INITIAL.
      lv_domfiscal = <h_cp>.
    ENDIF.
    IF lv_nombre IS INITIAL AND <h_nom> IS ASSIGNED AND <h_nom> IS NOT INITIAL.
      lv_nombre = <h_nom>.
    ENDIF.
    IF lv_usocfdi IS INITIAL AND <h_uso> IS ASSIGNED AND <h_uso> IS NOT INITIAL.
      lv_usocfdi = <h_uso>.
    ENDIF.
    IF lv_formapago IS INITIAL AND <h_frm> IS ASSIGNED AND <h_frm> IS NOT INITIAL.
      lv_formapago = <h_frm>.
    ENDIF.

    " === Normaliza CP receptor (sólo dígitos, a 5)
    REPLACE ALL OCCURRENCES OF REGEX '[^0-9]' IN lv_domfiscal WITH ''.
    IF strlen( lv_domfiscal ) = 4.
      lv_domfiscal = |0{ lv_domfiscal }|.
    ELSEIF strlen( lv_domfiscal ) > 5.
      lv_domfiscal = lv_domfiscal(5).
    ENDIF.

    " === Exportación requerido en 4.0; default '01'
    lv_exportacion = COND string( WHEN is_head-exportacion IS INITIAL THEN '01'
                                  ELSE CONV string( is_head-exportacion ) ).

    " === LugarExpedicion (CP emisor)
    CLEAR lv_cp_emisor.
    IF is_head-bukrs IS NOT INITIAL.
      SELECT SINGLE a~post_code1
        INTO lv_cp_emisor
        FROM t001 AS t
        INNER JOIN adrc AS a ON a~addrnumber = t~adrnr
        WHERE t~bukrs = is_head-bukrs.
    ENDIF.
    IF lv_cp_emisor IS INITIAL.
      lv_cp_emisor = CONV adrc-post_code1( is_head-lugar_exp ).
    ENDIF.
    REPLACE ALL OCCURRENCES OF REGEX '[^0-9]' IN lv_cp_emisor WITH ''.
    IF strlen( lv_cp_emisor ) = 4.
      lv_cp_emisor = |0{ lv_cp_emisor }|.
    ELSEIF strlen( lv_cp_emisor ) > 5.
      lv_cp_emisor = lv_cp_emisor(5).
    ENDIF.

    " === Decimales de moneda
    DATA lv_curr_dec TYPE i VALUE 2.
    FIELD-SYMBOLS <fs_waers> TYPE any.
    ASSIGN COMPONENT 'WAERS' OF STRUCTURE is_head TO <fs_waers>.
    IF <fs_waers> IS ASSIGNED AND <fs_waers> IS NOT INITIAL.
      SELECT SINGLE currdec INTO lv_curr_dec FROM tcurx WHERE currkey = <fs_waers>.
      IF sy-subrc <> 0 OR lv_curr_dec IS INITIAL. lv_curr_dec = 2. ENDIF.
    ENDIF.

    " === TipoCambio: sólo si moneda <> MXN
    CLEAR lv_tc_str.
    IF is_head-waers IS NOT INITIAL AND is_head-waers <> 'MXN'.
      lv_tc_str = |{ is_head-tipo_cambio DECIMALS = 6 }|.
      REPLACE ALL OCCURRENCES OF ',' IN lv_tc_str WITH '.'.
    ENDIF.

    " === Recalcular SubTotal e IVA TOTAL desde mt_det (mismas reglas que conceptos)
    DATA: lv_subtotal_p   TYPE p LENGTH 16 DECIMALS 2 VALUE 0,
          lv_tras_total_p TYPE p LENGTH 16 DECIMALS 2 VALUE 0.

    DATA: lv_last_vbeln TYPE vbrk-vbeln,
          lv_last_knumv TYPE konv-knumv.

    TYPES: BEGIN OF ty_mlan_cache, matnr TYPE matnr, taxm1 TYPE mlan-taxm1, END OF ty_mlan_cache.
    DATA: lt_mlan_cache TYPE HASHED TABLE OF ty_mlan_cache WITH UNIQUE KEY matnr,
          ls_mlan_cache TYPE ty_mlan_cache.

    FIELD-SYMBOLS:
      <d>        TYPE any,
      <f_qty>    TYPE any,   <f_unit>   TYPE any, <f_amt>   TYPE any,
      <f_tasa>   TYPE any,   <f_kpein>  TYPE any,
      <f_posnr>  TYPE any,   <f_vbeln>  TYPE any, <f_matnr> TYPE any,
      <f_ivap>   TYPE any,   <f_ivapct> TYPE any, <f_objimp> TYPE any.

    DATA: lv_qty    TYPE decfloat34,
          lv_unitp  TYPE decfloat34,
          lv_amt_in TYPE decfloat34,
          lv_tasa   TYPE decfloat34,
          lv_kpein  TYPE decfloat34,
          lv_base_p TYPE p LENGTH 16 DECIMALS 2,
          lv_iva_p  TYPE p LENGTH 16 DECIMALS 2.

    DATA: lt_konv_pos TYPE STANDARD TABLE OF konv WITH DEFAULT KEY,
          ls_konv     TYPE konv,
          lv_kw       TYPE decfloat34,
          lv_ka       TYPE decfloat34.

    LOOP AT mt_det ASSIGNING <d>.
      UNASSIGN: <f_qty>,<f_unit>,<f_amt>,<f_tasa>,<f_kpein>,<f_posnr>,<f_vbeln>,<f_matnr>,<f_ivap>,
      <f_ivapct>,<f_objimp>.
      ASSIGN COMPONENT 'CANTIDAD'       OF STRUCTURE <d> TO <f_qty>.
      IF <f_qty>  IS NOT ASSIGNED. ASSIGN COMPONENT 'FKIMG'  OF STRUCTURE <d> TO <f_qty>.  ENDIF.
      ASSIGN COMPONENT 'VALOR_UNITARIO' OF STRUCTURE <d> TO <f_unit>.
      IF <f_unit> IS NOT ASSIGNED. ASSIGN COMPONENT 'VALOR_UNIT' OF STRUCTURE <d> TO <f_unit>. ENDIF.
      IF <f_unit> IS NOT ASSIGNED. ASSIGN COMPONENT 'PUNIT'  OF STRUCTURE <d> TO <f_unit>. ENDIF.
      IF <f_unit> IS NOT ASSIGNED. ASSIGN COMPONENT 'KBETR'  OF STRUCTURE <d> TO <f_unit>. ENDIF.
      ASSIGN COMPONENT 'IMPORTE'        OF STRUCTURE <d> TO <f_amt>.
      IF <f_amt>  IS NOT ASSIGNED. ASSIGN COMPONENT 'DMBTR'  OF STRUCTURE <d> TO <f_amt>.  ENDIF.
      ASSIGN COMPONENT 'KPEIN'          OF STRUCTURE <d> TO <f_kpein>.
      ASSIGN COMPONENT 'TASAOCUOTA'     OF STRUCTURE <d> TO <f_tasa>.
      IF <f_tasa> IS NOT ASSIGNED. ASSIGN COMPONENT 'TASA' OF STRUCTURE <d> TO <f_tasa>. ENDIF.
      ASSIGN COMPONENT 'POSNR'          OF STRUCTURE <d> TO <f_posnr>.
      ASSIGN COMPONENT 'VBELN'          OF STRUCTURE <d> TO <f_vbeln>.
      ASSIGN COMPONENT 'MATNR'          OF STRUCTURE <d> TO <f_matnr>.
      ASSIGN COMPONENT 'IMPORTE_IVA'    OF STRUCTURE <d> TO <f_ivap>.
      ASSIGN COMPONENT 'IVA_PORCENTAJE' OF STRUCTURE <d> TO <f_ivapct>.
      ASSIGN COMPONENT 'OBJETOIMP'      OF STRUCTURE <d> TO <f_objimp>.

      CLEAR: lv_qty, lv_unitp, lv_amt_in, lv_tasa.
      IF <f_qty>  IS ASSIGNED AND <f_qty>  IS NOT INITIAL. lv_qty    = CONV decfloat34( <f_qty>  ). ENDIF.
      IF <f_unit> IS ASSIGNED AND <f_unit> IS NOT INITIAL. lv_unitp  = CONV decfloat34( <f_unit> ). ENDIF.
      IF <f_amt>  IS ASSIGNED AND <f_amt>  IS NOT INITIAL. lv_amt_in = CONV decfloat34( <f_amt>  ). ENDIF.
      IF <f_kpein> IS ASSIGNED AND <f_kpein> IS NOT INITIAL.
        lv_kpein = CONV decfloat34( <f_kpein> ).
        IF lv_kpein > 0. lv_unitp = lv_unitp / lv_kpein. ENDIF.
      ENDIF.

      " base: qty*unit; si queda 0 usar importe de línea
      lv_base_p = lv_qty * lv_unitp.
      IF lv_base_p = 0 AND lv_amt_in > 0. lv_base_p = lv_amt_in. ENDIF.

      " tasa priorizando IVA_PORCENTAJE
      IF <f_ivapct> IS ASSIGNED AND <f_ivapct> IS NOT INITIAL.
        lv_tasa = CONV decfloat34( <f_ivapct> ).
      ELSEIF <f_tasa> IS ASSIGNED AND <f_tasa> IS NOT INITIAL.
        lv_tasa = CONV decfloat34( <f_tasa> ).
      ELSE.
        lv_tasa = 0.
      ENDIF.
      IF lv_tasa > 1 AND lv_tasa <= 100. lv_tasa = lv_tasa / 100. ENDIF.
      IF lv_tasa < 0. lv_tasa = 0. ENDIF.

      " exento por material? (MLAN)
      DATA(lv_exento) = abap_false.
      IF <f_matnr> IS ASSIGNED AND <f_matnr> IS NOT INITIAL.
        ls_mlan_cache-matnr = <f_matnr>.
        READ TABLE lt_mlan_cache INTO ls_mlan_cache WITH TABLE KEY matnr = ls_mlan_cache-matnr.
        IF sy-subrc <> 0.
          DATA lv_matnr_db TYPE matnr.
          lv_matnr_db = <f_matnr>.
          CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
            EXPORTING
              input  = lv_matnr_db
            IMPORTING
              output = lv_matnr_db.
          SELECT SINGLE taxm1 INTO ls_mlan_cache-taxm1 FROM mlan WHERE matnr = lv_matnr_db AND aland = 'MX'.
          IF sy-subrc = 0. INSERT ls_mlan_cache INTO TABLE lt_mlan_cache. ENDIF.
        ENDIF.
        IF ls_mlan_cache-taxm1 = '0' OR ls_mlan_cache-taxm1 IS INITIAL. lv_exento = abap_true. ENDIF.
      ENDIF.

      " respeta OBJETOIMP si viene informado
      IF <f_objimp> IS ASSIGNED AND <f_objimp> = '01'.
        lv_exento = abap_true.
      ENDIF.

      CLEAR lv_iva_p.
      IF lv_exento = abap_true.
        lv_iva_p = 0.
      ELSEIF lv_tasa > 0.
        lv_iva_p = lv_base_p * lv_tasa.
      ELSEIF <f_ivap> IS ASSIGNED AND <f_ivap> IS NOT INITIAL AND lv_base_p > 0.
        lv_iva_p = CONV decfloat34( <f_ivap> ).
      ENDIF.

      IF lv_base_p > 0.
        lv_subtotal_p   = lv_subtotal_p   + lv_base_p.
        lv_tras_total_p = lv_tras_total_p + lv_iva_p.
      ENDIF.
    ENDLOOP.

    " === Formateo SubTotal/Total
    DATA(lv_subt_str) = |{ CONV decfloat34( lv_subtotal_p ) DECIMALS = lv_curr_dec }|.
    DATA(lv_tot_str)  = |{ CONV decfloat34( lv_subtotal_p + lv_tras_total_p ) DECIMALS = lv_curr_dec }|.
    REPLACE ALL OCCURRENCES OF ',' IN lv_subt_str WITH '.'.
    REPLACE ALL OCCURRENCES OF ',' IN lv_tot_str  WITH '.'.

    " === Datos del emisor
    DATA: lv_nom_emisor TYPE string,
          lv_reg_fiscal TYPE string,
          lv_version    TYPE string.

    lv_nom_emisor = me->get_param_value( iv_program = 'ZCFDI40_MONITOR_LOG' iv_param = 'EMISOR' iv_field = 'NOMBRE'         iv_bukrs = is_head-bukrs ).
    IF lv_nom_emisor IS INITIAL.
      SELECT SINGLE butxt INTO lv_nom_emisor FROM t001 WHERE bukrs = is_head-bukrs.
    ENDIF.
    lv_reg_fiscal = me->get_param_value( iv_program = 'ZCFDI40_MONITOR_LOG' iv_param = 'EMISOR' iv_field = 'REGIMENFISCAL'   iv_bukrs = is_head-bukrs ).
    lv_version    = me->get_param_value( iv_program = 'ZCFDI40_MONITOR_LOG' iv_param = 'CFDI'   iv_field = 'VERSION'         iv_bukrs = is_head-bukrs ).
    IF lv_version IS INITIAL. lv_version = '4.0'. ENDIF.

    " === Atributos de <cfdi:Comprobante>
    CLEAR lv_attr.
    me->add_attr( EXPORTING i_name = 'xsi:schemaLocation' i_val = 'http://www.sat.gob.mx/cfd/4 http://www.sat.gob.mx/sitio_internet/cfd/4/cfdv40.xsd' CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'xmlns:xsi'          i_val = 'http://www.w3.org/2001/XMLSchema-instance' CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'xmlns:cfdi'         i_val = 'http://www.sat.gob.mx/cfd/4'                CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Version'            i_val = lv_version                                   CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Fecha'              i_val = lv_fecha                                     CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Exportacion'        i_val = lv_exportacion                               CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'TipoDeComprobante'  i_val = CONV string( is_head-tipo_comp )             CHANGING cv_attr = lv_attr ).
    IF is_head-serie_xml IS NOT INITIAL.
      me->add_attr( EXPORTING i_name = 'Serie'            i_val = CONV string( is_head-serie_xml )             CHANGING cv_attr = lv_attr ).
    ENDIF.
    me->add_attr( EXPORTING i_name = 'Folio'              i_val = CONV string( is_head-belnr )                 CHANGING cv_attr = lv_attr ).

    IF is_head-metodo_pago IS NOT INITIAL.
      me->add_attr( EXPORTING i_name = 'MetodoPago' i_val = CONV string( is_head-metodo_pago ) CHANGING cv_attr = lv_attr ).
      CASE is_head-metodo_pago.
        WHEN 'PPD'.
          me->add_attr( EXPORTING i_name = 'FormaPago' i_val = '99' CHANGING cv_attr = lv_attr ).
        WHEN 'PUE'.
          IF lv_formapago IS NOT INITIAL AND lv_formapago <> '99'.
            IF lv_formapago CP '??'.
              me->add_attr( EXPORTING i_name = 'FormaPago' i_val = lv_formapago CHANGING cv_attr = lv_attr ).
            ENDIF.
          ENDIF.
      ENDCASE.
    ENDIF.

    me->add_attr( EXPORTING i_name = 'SubTotal'        i_val = lv_subt_str               CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Total'           i_val = lv_tot_str                CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Moneda'          i_val = CONV string( is_head-waers ) CHANGING cv_attr = lv_attr ).
    IF lv_tc_str IS NOT INITIAL.
      me->add_attr( EXPORTING i_name = 'TipoCambio'    i_val = lv_tc_str                 CHANGING cv_attr = lv_attr ).
    ENDIF.
    me->add_attr( EXPORTING i_name = 'LugarExpedicion' i_val = CONV string( lv_cp_emisor ) CHANGING cv_attr = lv_attr ).

    me->append_line( EXPORTING iv_line = |<cfdi:Comprobante { lv_attr }>| CHANGING ct_xml = ct_xml ).



    " Emisor
    CLEAR lv_attr.
    me->add_attr( EXPORTING i_name = 'Nombre'        i_val = lv_nom_emisor                  CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Rfc'           i_val = CONV string( is_head-rfc_emisor ) CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'RegimenFiscal' i_val = lv_reg_fiscal                   CHANGING cv_attr = lv_attr ).
    me->append_line( EXPORTING iv_line = |<cfdi:Emisor { lv_attr }/>| CHANGING ct_xml = ct_xml ).

    " Receptor
    CLEAR lv_attr.
    me->add_attr( EXPORTING i_name = 'Nombre'                  i_val = lv_nombre                           CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Rfc'                     i_val = CONV string( is_head-rfc_receptor ) CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'RegimenFiscalReceptor'   i_val = lv_regfiscal_r                      CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'DomicilioFiscalReceptor' i_val = lv_domfiscal                        CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'UsoCFDI'                 i_val = lv_usocfdi                          CHANGING cv_attr = lv_attr ).
    me->append_line( EXPORTING iv_line = |<cfdi:Receptor { lv_attr }/>| CHANGING ct_xml = ct_xml ).
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->BUILD_CABECERA_IXML
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEAD                        TYPE        ZET_HEAD_40
* | [<-->] CO_DOC                         TYPE REF TO IF_IXML_DOCUMENT
* | [<-->] CO_ROOT                        TYPE REF TO IF_IXML_ELEMENT
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD build_cabecera_ixml.

  "===========================================================
  " TODA TU LÓGICA ORIGINAL – SIN CAMBIOS
  "===========================================================

  DATA: lv_attr        TYPE string,
        lv_fecha       TYPE string,
        lv_metpag      TYPE string,
        lv_usocfdi     TYPE string,
        lv_nombre      TYPE string,
        lv_regfiscal_r TYPE string,
        lv_domfiscal   TYPE string,
        lv_exportacion TYPE string,
        lv_tc_str      TYPE string,
        lv_cp_emisor   TYPE string,
        lv_formapago   TYPE string.

  " === Fecha CFDI
  lv_fecha = |{ sy-datum+0(4) }-{ sy-datum+4(2) }-{ sy-datum+6(2) }T{ sy-uzeit+0(2) }:{ sy-uzeit+2(2) }:{ sy-uzeit+4(2) }|.

  " === Datos Receptor (como en tu método actual)
  me->recuperar_datos_cfdi_receptor(
    EXPORTING
      iv_kunnr = is_head-kunnr
      iv_vkorg = is_head-vkorg
      iv_vtweg = is_head-vtweg
      iv_spart = is_head-spart
    IMPORTING
      ev_metpag    = lv_metpag
      ev_formapago = lv_formapago
      ev_usocfdi   = lv_usocfdi
      ev_nombre    = lv_nombre
      ev_regfiscal = lv_regfiscal_r
      ev_domfiscal = lv_domfiscal ).

  " === Complementar con IS_HEAD si falta
  FIELD-SYMBOLS: <h_reg> TYPE any, <h_cp> TYPE any, <h_nom> TYPE any,
                 <h_uso> TYPE any, <h_frm> TYPE any.

  ASSIGN COMPONENT 'REGIMENFISCALRECEPTOR'   OF STRUCTURE is_head TO <h_reg>.
  ASSIGN COMPONENT 'DOMICILIOFISCALRECEPTOR' OF STRUCTURE is_head TO <h_cp>.
  ASSIGN COMPONENT 'NOMBRE_RECEPTOR'         OF STRUCTURE is_head TO <h_nom>.
  ASSIGN COMPONENT 'USO_CFDI'                OF STRUCTURE is_head TO <h_uso>.
  ASSIGN COMPONENT 'FORMA_PAGO'              OF STRUCTURE is_head TO <h_frm>.

  IF lv_regfiscal_r IS INITIAL AND <h_reg> IS ASSIGNED.
    lv_regfiscal_r = <h_reg>.
  ENDIF.
  IF lv_domfiscal IS INITIAL AND <h_cp> IS ASSIGNED.
    lv_domfiscal = <h_cp>.
  ENDIF.
  IF lv_nombre IS INITIAL AND <h_nom> IS ASSIGNED.
    lv_nombre = <h_nom>.
  ENDIF.
  IF lv_usocfdi IS INITIAL AND <h_uso> IS ASSIGNED.
    lv_usocfdi = <h_uso>.
  ENDIF.
  IF lv_formapago IS INITIAL AND <h_frm> IS ASSIGNED.
    lv_formapago = <h_frm>.
  ENDIF.

  " === Normaliza CP receptor
  REPLACE ALL OCCURRENCES OF REGEX '[^0-9]' IN lv_domfiscal WITH ''.
  IF strlen( lv_domfiscal ) = 4.
    lv_domfiscal = |0{ lv_domfiscal }|.
  ELSEIF strlen( lv_domfiscal ) > 5.
    lv_domfiscal = lv_domfiscal(5).
  ENDIF.

  " === Exportación
  lv_exportacion = COND string(
                     WHEN is_head-exportacion IS INITIAL THEN '01'
                     ELSE CONV string( is_head-exportacion ) ).

  " === Lugar de expedición
  CLEAR lv_cp_emisor.
  IF is_head-bukrs IS NOT INITIAL.
    SELECT SINGLE a~post_code1
      INTO lv_cp_emisor
      FROM t001 AS t
      INNER JOIN adrc AS a ON a~addrnumber = t~adrnr
      WHERE t~bukrs = is_head-bukrs.
  ENDIF.

  IF lv_cp_emisor IS INITIAL.
    lv_cp_emisor = CONV adrc-post_code1( is_head-lugar_exp ).
  ENDIF.

  REPLACE ALL OCCURRENCES OF REGEX '[^0-9]' IN lv_cp_emisor WITH ''.
  IF strlen( lv_cp_emisor ) = 4.
    lv_cp_emisor = |0{ lv_cp_emisor }|.
  ELSEIF strlen( lv_cp_emisor ) > 5.
    lv_cp_emisor = lv_cp_emisor(5).
  ENDIF.

  " === Moneda: decimales
  DATA lv_curr_dec TYPE i VALUE 2.
  FIELD-SYMBOLS <fs_waers> TYPE any.
  ASSIGN COMPONENT 'WAERS' OF STRUCTURE is_head TO <fs_waers>.
  IF <fs_waers> IS ASSIGNED AND <fs_waers> IS NOT INITIAL.
    SELECT SINGLE currdec INTO lv_curr_dec FROM tcurx WHERE currkey = <fs_waers>.
    IF sy-subrc <> 0. lv_curr_dec = 2. ENDIF.
  ENDIF.

  " === TipoCambio
  CLEAR lv_tc_str.
  IF is_head-waers <> 'MXN' AND is_head-waers IS NOT INITIAL.
    lv_tc_str = |{ is_head-tipo_cambio DECIMALS = 6 }|.
    REPLACE ALL OCCURRENCES OF ',' IN lv_tc_str WITH '.'.
  ENDIF.

  "===========================================================
  "   RE-CÁLCULO SUBTOTAL Y IVA (IGUAL QUE TU MÉTODO)
  "===========================================================

  CLEAR: mv_subtotal_p, mv_tras_total_p.

  DATA: lv_qty     TYPE decfloat34,
        lv_unitp   TYPE decfloat34,
        lv_amt_in  TYPE decfloat34,
        lv_tasa    TYPE decfloat34,
        lv_kpein   TYPE decfloat34,
        lv_base_p  TYPE decfloat34,
        lv_iva_p   TYPE decfloat34.

  FIELD-SYMBOLS:
    <d>        TYPE any,
    <f_qty>    TYPE any,
    <f_unit>   TYPE any,
    <f_amt>    TYPE any,
    <f_tasa>   TYPE any,
    <f_kpein>  TYPE any,
    <f_ivap>   TYPE any,
    <f_ivapct> TYPE any.

  LOOP AT mt_det ASSIGNING <d>.

    UNASSIGN: <f_qty>, <f_unit>, <f_amt>, <f_tasa>, <f_kpein>,
              <f_ivap>, <f_ivapct>.

    ASSIGN COMPONENT 'CANTIDAD' OF STRUCTURE <d> TO <f_qty>.
    IF <f_qty> IS NOT ASSIGNED. ASSIGN COMPONENT 'FKIMG' OF STRUCTURE <d> TO <f_qty>. ENDIF.

    ASSIGN COMPONENT 'VALOR_UNITARIO' OF STRUCTURE <d> TO <f_unit>.
    IF <f_unit> IS NOT ASSIGNED. ASSIGN COMPONENT 'VALOR_UNIT' OF STRUCTURE <d> TO <f_unit>. ENDIF.
    IF <f_unit> IS NOT ASSIGNED. ASSIGN COMPONENT 'PUNIT' OF STRUCTURE <d> TO <f_unit>. ENDIF.
    IF <f_unit> IS NOT ASSIGNED. ASSIGN COMPONENT 'KBETR' OF STRUCTURE <d> TO <f_unit>. ENDIF.

    ASSIGN COMPONENT 'IMPORTE' OF STRUCTURE <d> TO <f_amt>.
    IF <f_amt> IS NOT ASSIGNED. ASSIGN COMPONENT 'DMBTR' OF STRUCTURE <d> TO <f_amt>. ENDIF.

    ASSIGN COMPONENT 'KPEIN'      OF STRUCTURE <d> TO <f_kpein>.
    ASSIGN COMPONENT 'TASAOCUOTA' OF STRUCTURE <d> TO <f_tasa>.
    IF <f_tasa> IS NOT ASSIGNED. ASSIGN COMPONENT 'TASA' OF STRUCTURE <d> TO <f_tasa>. ENDIF.

    ASSIGN COMPONENT 'IMPORTE_IVA'    OF STRUCTURE <d> TO <f_ivap>.
    ASSIGN COMPONENT 'IVA_PORCENTAJE' OF STRUCTURE <d> TO <f_ivapct>.

    CLEAR: lv_qty, lv_unitp, lv_amt_in, lv_tasa, lv_base_p, lv_iva_p.

    IF <f_qty> IS ASSIGNED. lv_qty = <f_qty>. ENDIF.
    IF <f_unit> IS ASSIGNED. lv_unitp = <f_unit>. ENDIF.
    IF <f_kpein> IS ASSIGNED AND <f_kpein> > 0.
      lv_unitp = lv_unitp / <f_kpein>.
    ENDIF.
    IF <f_amt> IS ASSIGNED. lv_amt_in = <f_amt>. ENDIF.

    lv_base_p = lv_qty * lv_unitp.
    IF lv_base_p = 0 AND lv_amt_in > 0.
      lv_base_p = lv_amt_in.
    ENDIF.

    IF <f_ivapct> IS ASSIGNED AND <f_ivapct> IS NOT INITIAL.
      lv_tasa = <f_ivapct>.
    ELSEIF <f_tasa> IS ASSIGNED AND <f_tasa> IS NOT INITIAL.
      lv_tasa = <f_tasa>.
    ENDIF.

    IF lv_tasa > 1 AND lv_tasa <= 100. lv_tasa = lv_tasa / 100. ENDIF.
    IF lv_tasa < 0. lv_tasa = 0. ENDIF.

    IF lv_tasa > 0.
      lv_iva_p = lv_base_p * lv_tasa.
    ELSEIF <f_ivap> IS ASSIGNED.
      lv_iva_p = <f_ivap>.
    ENDIF.

    mv_subtotal_p   = mv_subtotal_p   + lv_base_p.
    mv_tras_total_p = mv_tras_total_p + lv_iva_p.

  ENDLOOP.

  " === Formato final totales
  DATA(lv_subt_str) = |{ CONV decfloat34( mv_subtotal_p ) DECIMALS = lv_curr_dec }|.
  DATA(lv_tot_str)  = |{ CONV decfloat34( mv_subtotal_p + mv_tras_total_p ) DECIMALS = lv_curr_dec }|.
  REPLACE ALL OCCURRENCES OF ',' IN lv_subt_str WITH '.'.
  REPLACE ALL OCCURRENCES OF ',' IN lv_tot_str WITH '.'.

  " === Datos emisor
  DATA lv_nom_emisor TYPE string.
  DATA lv_reg_fiscal TYPE string.
  DATA lv_version    TYPE string.

  lv_nom_emisor = me->get_param_value(
                    iv_program = 'ZCFDI40_MONITOR_LOG'
                    iv_param   = 'EMISOR'
                    iv_field   = 'NOMBRE'
                    iv_bukrs   = is_head-bukrs ).

  IF lv_nom_emisor IS INITIAL.
    SELECT SINGLE butxt INTO lv_nom_emisor FROM t001 WHERE bukrs = is_head-bukrs.
  ENDIF.

  lv_reg_fiscal = me->get_param_value(
                     iv_program = 'ZCFDI40_MONITOR_LOG'
                     iv_param   = 'EMISOR'
                     iv_field   = 'REGIMENFISCAL'
                     iv_bukrs   = is_head-bukrs ).

  lv_version = me->get_param_value(
                 iv_program = 'ZCFDI40_MONITOR_LOG'
                 iv_param   = 'CFDI'
                 iv_field   = 'VERSION'
                 iv_bukrs   = is_head-bukrs ).

  IF lv_version IS INITIAL.
    lv_version = '4.0'.
  ENDIF.


  "===========================================================
  "              AHORA SÍ: iXML Writer – XML REAL
  "===========================================================

  DATA lo_comprobante TYPE REF TO if_ixml_element.
  DATA lo_emisor      TYPE REF TO if_ixml_element.
  DATA lo_receptor    TYPE REF TO if_ixml_element.

  " Crear nodo raíz <cfdi:Comprobante> en CO_DOC
  lo_comprobante = co_doc->create_simple_element(
                     name   = 'cfdi:Comprobante'
                     parent = co_doc ).

  co_root = lo_comprobante.  " devolver root al caller

  " Namespaces
  lo_comprobante->set_attribute( name = 'xmlns:cfdi'
                                 value = 'http://www.sat.gob.mx/cfd/4' ).
  lo_comprobante->set_attribute( name = 'xmlns:xsi'
                                 value = 'http://www.w3.org/2001/XMLSchema-instance' ).
  lo_comprobante->set_attribute(
    name  = 'xsi:schemaLocation'
    value = 'http://www.sat.gob.mx/cfd/4 http://www.sat.gob.mx/sitio_internet/cfd/4/cfdv40.xsd' ).

  " Atributos CFDI
  lo_comprobante->set_attribute( name ='Version'           value = lv_version ).
  lo_comprobante->set_attribute( name ='Fecha'             value = lv_fecha   ).
  lo_comprobante->set_attribute( name ='Exportacion'       value = lv_exportacion ).
  lo_comprobante->set_attribute( name ='TipoDeComprobante' value = CONV string( is_head-tipo_comp ) ).
  lo_comprobante->set_attribute( name ='Folio'             value = CONV string( is_head-belnr ) ).
  lo_comprobante->set_attribute( name ='Moneda'            value = CONV string( is_head-waers ) ).
  lo_comprobante->set_attribute( name ='SubTotal'          value = lv_subt_str ).
  lo_comprobante->set_attribute( name ='Total'             value = lv_tot_str  ).
  lo_comprobante->set_attribute( name ='LugarExpedicion'   value = lv_cp_emisor ).

  IF is_head-serie_xml IS NOT INITIAL.
    lo_comprobante->set_attribute( name ='Serie'
                                   value = CONV string( is_head-serie_xml ) ).
  ENDIF.

  IF lv_tc_str IS NOT INITIAL.
    lo_comprobante->set_attribute( name = 'TipoCambio'
                                   value = lv_tc_str ).
  ENDIF.

  IF is_head-metodo_pago IS NOT INITIAL.
    lo_comprobante->set_attribute( name ='MetodoPago'
                                   value = CONV string( is_head-metodo_pago ) ).

    CASE is_head-metodo_pago.
      WHEN 'PPD'.
        lo_comprobante->set_attribute( name ='FormaPago' value ='99' ).

      WHEN 'PUE'.
        IF lv_formapago IS NOT INITIAL AND lv_formapago <> '99'.
          lo_comprobante->set_attribute( name = 'FormaPago'
                                         value = lv_formapago ).
        ENDIF.
    ENDCASE.
  ENDIF.

  "===========================================================
  "                      Emisor
  "===========================================================
  lo_emisor = co_doc->create_simple_element(
                name   = 'cfdi:Emisor'
                parent = lo_comprobante ).

  lo_emisor->set_attribute( name ='Nombre'        value = lv_nom_emisor ).
  lo_emisor->set_attribute( name ='Rfc'           value = CONV string( is_head-rfc_emisor ) ).
  lo_emisor->set_attribute( name ='RegimenFiscal' value = lv_reg_fiscal ).

  "===========================================================
  "                      Receptor
  "===========================================================
  lo_receptor = co_doc->create_simple_element(
                  name   = 'cfdi:Receptor'
                  parent = lo_comprobante ).

  lo_receptor->set_attribute( name ='Nombre'                  value = lv_nombre ).
  lo_receptor->set_attribute( name ='Rfc'                     value = CONV string( is_head-rfc_receptor ) ).
  lo_receptor->set_attribute( name ='RegimenFiscalReceptor'   value = lv_regfiscal_r ).
  lo_receptor->set_attribute( name ='DomicilioFiscalReceptor' value = lv_domfiscal ).
  lo_receptor->set_attribute( name ='UsoCFDI'                 value = lv_usocfdi ).

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->BUILD_COMPLEMENTOS_IXML
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEAD                        TYPE        ZET_HEAD_40
* | [<-->] CO_PARENT                      TYPE REF TO IF_IXML_ELEMENT
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD build_complementos_ixml.

  DATA lo_complemento TYPE REF TO if_ixml_element.

