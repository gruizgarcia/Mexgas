* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->ENSURE_DET_LOADED
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_BELNR                       TYPE        VBRK-VBELN(optional)
* | [--->] IV_BUKRS                       TYPE        BUKRS(optional)
* | [--->] IV_GJAHR                       TYPE        GJAHR(optional)
* | [<-()] RV_LOADED                      TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD ensure_det_loaded.
    " Garantiza que me->mt_det esté poblado (o al menos que tenga IVA_PORCENTAJE/TASAOCUOTA ajustado)
    "  - Si mt_det está vacío: carga desde ZCFDI_DET_40 (usando BELNR/[BUKRS,GJAHR] si se tienen)
    "  - Si mt_det ya tiene filas: sólo actualiza tasas/objetoImp desde ZCFDI_DET_40 por material / noIdentificación
    " Devuelve 'X' si mt_det queda con datos; blanco en caso contrario.

    DATA: lv_belnr10 TYPE vbrk-vbeln,
          lv_bukrs   TYPE bukrs,
          lv_gjahr   TYPE gjahr.

    DATA: lt_z TYPE TABLE OF zcfdi_det_40,
          ls_z TYPE zcfdi_det_40.

    rv_loaded = abap_false.

    "---- 1) Resolver llaves (de parámetros o de mt_head y, en último caso, de ZCFDI_HEAD_40)
    " VBELN
    IF iv_belnr IS NOT INITIAL.
      lv_belnr10 = iv_belnr.
    ELSE.
      FIELD-SYMBOLS <h> TYPE any.
      READ TABLE mt_head INDEX 1 ASSIGNING <h>.
      IF sy-subrc = 0 AND <h> IS ASSIGNED.
        FIELD-SYMBOLS <h_belnr> TYPE any.
        ASSIGN COMPONENT 'BELNR' OF STRUCTURE <h> TO <h_belnr>.
        IF <h_belnr> IS ASSIGNED AND <h_belnr> IS NOT INITIAL.
          lv_belnr10 = <h_belnr>.
        ENDIF.
      ENDIF.
    ENDIF.
    IF lv_belnr10 IS INITIAL.
      RETURN.
    ENDIF.
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = lv_belnr10
      IMPORTING
        output = lv_belnr10.

    " BUKRS/GJAHR
    lv_bukrs = iv_bukrs.
    lv_gjahr = iv_gjahr.
    IF lv_bukrs IS INITIAL OR lv_gjahr IS INITIAL.
      " 1a: intentar desde mt_head
      FIELD-SYMBOLS <h_any> TYPE any.
      READ TABLE mt_head INDEX 1 ASSIGNING <h_any>.
      IF sy-subrc = 0 AND <h_any> IS ASSIGNED.
        FIELD-SYMBOLS <h_bukrs> TYPE any.
        FIELD-SYMBOLS <h_gjahr> TYPE any.
        ASSIGN COMPONENT 'BUKRS' OF STRUCTURE <h_any> TO <h_bukrs>.
        ASSIGN COMPONENT 'GJAHR' OF STRUCTURE <h_any> TO <h_gjahr>.
        IF lv_bukrs IS INITIAL AND <h_bukrs> IS ASSIGNED AND <h_bukrs> IS NOT INITIAL.
          lv_bukrs = <h_bukrs>.
        ENDIF.
        IF lv_gjahr IS INITIAL AND <h_gjahr> IS ASSIGNED AND <h_gjahr> IS NOT INITIAL.
          lv_gjahr = <h_gjahr>.
        ENDIF.
      ENDIF.
    ENDIF.
    IF lv_bukrs IS INITIAL OR lv_gjahr IS INITIAL.
      " 1b: último recurso, leer cabecera Z por el VBELN
      SELECT SINGLE bukrs gjahr
        INTO (lv_bukrs, lv_gjahr)
        FROM zcfdi_head_40
        WHERE belnr = lv_belnr10.
    ENDIF.

    "---- 2) Leer ZCFDI_DET_40
    CLEAR lt_z.
    IF lv_bukrs IS NOT INITIAL AND lv_gjahr IS NOT INITIAL.
      SELECT * FROM zcfdi_det_40 INTO TABLE lt_z
       WHERE belnr = lv_belnr10
         AND bukrs = lv_bukrs
         AND gjahr = lv_gjahr.
      IF sy-subrc <> 0.
        " si no hay por las 3 llaves, intenta sólo por BELNR
        SELECT * FROM zcfdi_det_40 INTO TABLE lt_z WHERE belnr = lv_belnr10.
      ENDIF.
    ELSE.
      SELECT * FROM zcfdi_det_40 INTO TABLE lt_z WHERE belnr = lv_belnr10.
    ENDIF.
    IF lt_z IS INITIAL AND me->mt_det IS INITIAL.
      RETURN.
    ENDIF.

    "---- 3) Si mt_det está vacío: poblar desde Z (MOVE-CORRESPONDING + normalizaciones)
    IF me->mt_det IS INITIAL AND lt_z IS NOT INITIAL.
      DATA ls_dst TYPE zet_det_40.
      LOOP AT lt_z INTO ls_z.
        CLEAR ls_dst.
        MOVE-CORRESPONDING ls_z TO ls_dst.

        " Normalizar IVA_PORCENTAJE -> TASAOCUOTA/IVA_PORCENTAJE (0.16 / 0.00)
        DATA(lv_rate) = CONV decfloat34( ls_z-iva_porcentaje ).
        IF lv_rate > 1. lv_rate = lv_rate / 100. ENDIF.
        IF lv_rate < 0. lv_rate = 0. ENDIF.

        FIELD-SYMBOLS <fd_rate> TYPE any.
        ASSIGN COMPONENT 'IVA_PORCENTAJE' OF STRUCTURE ls_dst TO <fd_rate>.
        IF <fd_rate> IS ASSIGNED. <fd_rate> = lv_rate. ENDIF.
        ASSIGN COMPONENT 'TASAOCUOTA' OF STRUCTURE ls_dst TO <fd_rate>.
        IF <fd_rate> IS ASSIGNED. <fd_rate> = lv_rate. ENDIF.

        " ObjetoImp: '02' gravado (incluye 0%), '01' exento si aplica
        FIELD-SYMBOLS <fd_obj> TYPE any.
        ASSIGN COMPONENT 'OBJETOIMP' OF STRUCTURE ls_dst TO <fd_obj>.
        IF <fd_obj> IS ASSIGNED.
          IF lv_rate >= 0. <fd_obj> = '02'. ENDIF.
          IF lv_rate = 0 AND ls_z-importe_iva IS INITIAL.
            " Si tu regla de exento aplica, descomenta:
            " <fd_obj> = '01'.
          ENDIF.
        ENDIF.

        APPEND ls_dst TO me->mt_det.
      ENDLOOP.
    ENDIF.

    "---- 4) Si mt_det ya tenía datos: actualizar tasas/objetoImp desde Z por MATNR / NoIdentificacion
    IF me->mt_det IS NOT INITIAL AND lt_z IS NOT INITIAL.
      FIELD-SYMBOLS:
        <d>        TYPE any,
        <f_matnr>  TYPE any,
        <f_noid>   TYPE any,
        <f_rate>   TYPE any,
        <f_tasa>   TYPE any,
        <f_objimp> TYPE any.

      LOOP AT me->mt_det ASSIGNING <d>.
        UNASSIGN: <f_matnr>, <f_noid>, <f_rate>, <f_tasa>, <f_objimp>.
        ASSIGN COMPONENT 'MATNR'            OF STRUCTURE <d> TO <f_matnr>.
        ASSIGN COMPONENT 'NOIDENTIFICACION' OF STRUCTURE <d> TO <f_noid>.
        ASSIGN COMPONENT 'IVA_PORCENTAJE'   OF STRUCTURE <d> TO <f_rate>.
        ASSIGN COMPONENT 'TASAOCUOTA'       OF STRUCTURE <d> TO <f_tasa>.
        ASSIGN COMPONENT 'OBJETOIMP'        OF STRUCTURE <d> TO <f_objimp>.

        CLEAR ls_z.
        IF <f_matnr> IS ASSIGNED AND <f_matnr> IS NOT INITIAL.
          READ TABLE lt_z INTO ls_z WITH KEY prod_eka = CONV zcfdi_det_40-prod_eka( <f_matnr> ).
        ENDIF.
        IF sy-subrc <> 0 AND <f_noid> IS ASSIGNED AND <f_noid> IS NOT INITIAL.
          READ TABLE lt_z INTO ls_z WITH KEY prod_eka = CONV zcfdi_det_40-prod_eka( <f_noid> ).
        ENDIF.
        IF sy-subrc <> 0.
          CONTINUE.
        ENDIF.

        DATA(lv_rate2) = CONV decfloat34( ls_z-iva_porcentaje ).
        IF lv_rate2 > 1. lv_rate2 = lv_rate2 / 100. ENDIF.
        IF lv_rate2 < 0. lv_rate2 = 0. ENDIF.

        IF <f_rate> IS ASSIGNED. <f_rate> = lv_rate2. ENDIF.
        IF <f_tasa> IS ASSIGNED. <f_tasa> = lv_rate2. ENDIF.

        IF <f_objimp> IS ASSIGNED.
          IF lv_rate2 >= 0. <f_objimp> = '02'. ENDIF.
          IF lv_rate2 = 0 AND ls_z-importe_iva IS INITIAL.
            " Si tu regla de exento aplica, descomenta:
            " <f_objimp> = '01'.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ENDIF.

    rv_loaded = xsdbool( me->mt_det IS NOT INITIAL ).

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->FORMAT_TASA6
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_RATE                        TYPE        DECFLOAT34
* | [<-()] RV_TASA6                       TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD format_tasa6.
    " Firma sugerida:
    " IMPORTING iv_rate  TYPE decfloat34  " puede venir 16, 8, 0.16, etc.
    " RETURNING VALUE(rv_tasa6) TYPE string.

    DATA lv TYPE decfloat34.
    lv = iv_rate.

    " Si viene en porcentaje (16/8), conviértelo
    IF lv > 1 AND lv <= 100.
      lv = lv / 100.
    ENDIF.

    " Clamp de tasas típicas para evitar 0.159999/0.160001
    IF lv > '0.159999' AND lv < '0.160001'.
      lv = '0.16'.
    ENDIF.
    IF lv > '0.079999' AND lv < '0.080001'.
      lv = '0.08'.
    ENDIF.
    IF lv > '0.000000' AND lv < '0.000001'.
      lv = 0.
    ENDIF.

    rv_tasa6 = |{ lv DECIMALS = 6 }|.
    REPLACE ALL OCCURRENCES OF ',' IN rv_tasa6 WITH '.'.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->GET_PARAM_VALUE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_PROGRAM                     TYPE        PROGRAMM(optional)
* | [--->] IV_PARAM                       TYPE        ZPARAM(optional)
* | [--->] IV_FIELD                       TYPE        ZFIELD(optional)
* | [--->] IV_BUKRS                       TYPE        BUKRS(optional)
* | [<---] ES_ROW                         TYPE        ZSULP_PARAMETROS
* | [<-()] RV_VALUE                       TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_param_value.
    DATA: lt_rows TYPE STANDARD TABLE OF zsulp_parametros,
          ls_row  TYPE zsulp_parametros.

    CLEAR rv_value.

    SELECT *
      INTO TABLE lt_rows
      FROM zsulp_parametros
      WHERE ( programa  = iv_program )
        AND ( parametro = iv_param   )
        AND ( field     = iv_field   )
        AND ( bukrs     = iv_bukrs   ).

    IF sy-subrc = 0.
      READ TABLE lt_rows INDEX 1 INTO ls_row.
      IF sy-subrc = 0.
        rv_value = ls_row-value.
      ENDIF.
    ENDIF.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_CFDI40_NAST->NORM_FORMAPAGO
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_FORMA                       TYPE        STRING
* | [<-()] RV_FORMA                       TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD norm_formapago.
    rv_forma = iv_forma.
    " Si es un solo dígito (p.ej. '1'), pad a 2 ('01')
    IF rv_forma CP '[0-9]' AND strlen( rv_forma ) = 1.
      rv_forma = |0{ rv_forma }|.
    ENDIF.
    " Mantén otros casos como '03', '28', '99', 'NA', etc.
  ENDMETHOD.


