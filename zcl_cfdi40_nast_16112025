* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->PERSIST_ZCFDI_TABLES
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_UUID                        TYPE        ZUUID(optional)
* | [--->] IV_URL                         TYPE        ZQR40(optional)
* | [--->] IV_XML_TIMB_STR                TYPE        STRING(optional)
* | [--->] IV_XML_TIMB_X                  TYPE        XSTRING(optional)
* | [<-()] RV_OK                          TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD persist_zcfdi_tables.
    "---------------------------------------------------------------
    " IMPORTING (referencia):
    "   iv_uuid         TYPE string OPTIONAL
    "   iv_url          TYPE string OPTIONAL
    "   iv_xml_timb_x   TYPE xstring OPTIONAL
    "   iv_xml_timb_str TYPE string  OPTIONAL
    "---------------------------------------------------------------

    DATA: ls_head_src TYPE zet_head_40,
          ls_head_db  TYPE zcfdi_head_40,
          ls_det_db   TYPE zcfdi_det_40,
          lv_belnr10  TYPE vbrk-vbeln,
          lv_xml_x    TYPE xstring,
          lv_xml_s    TYPE string.

    FIELD-SYMBOLS: <fh>          TYPE any,
                   <fs_xml_head> TYPE xstring,
                   <fs_buzei>    TYPE any,
                   <src_posnr>   TYPE any,
                   <d>           TYPE zet_det_40.

    "========================
    " 1) Origen desde MT_HEAD
    "========================
    READ TABLE mt_head INTO ls_head_src INDEX 1.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    lv_belnr10 = |{ ls_head_src-belnr ALPHA = IN }|.

    CLEAR ls_head_db.
    ls_head_db = CORRESPONDING zcfdi_head_40( ls_head_src ).
    ls_head_db-mandt = sy-mandt.
    ls_head_db-belnr = lv_belnr10.

    "========================
    " 2) XML timbrado (xstring/string)
    "========================
    IF iv_xml_timb_x IS NOT INITIAL.
      lv_xml_x = iv_xml_timb_x.
    ELSEIF iv_xml_timb_str IS NOT INITIAL.
      CALL FUNCTION 'SCMS_STRING_TO_XSTRING'
        EXPORTING
          text   = iv_xml_timb_str
        IMPORTING
          buffer = lv_xml_x.
    ENDIF.

    IF iv_xml_timb_str IS NOT INITIAL.
      lv_xml_s = iv_xml_timb_str.
    ELSEIF lv_xml_x IS NOT INITIAL.
      CALL FUNCTION 'ECATT_CONV_XSTRING_TO_STRING'
        EXPORTING
          im_xstring  = lv_xml_x
          im_encoding = 'UTF-8'
        IMPORTING
          ex_string   = lv_xml_s.
    ENDIF.


    " Guardar XML timbrado en el campo existente
    IF lv_xml_x IS NOT INITIAL.
      ASSIGN COMPONENT 'XML_TIMB'     OF STRUCTURE ls_head_db TO <fs_xml_head>.
      IF sy-subrc <> 0. ASSIGN COMPONENT 'XML_TIMBRADO' OF STRUCTURE ls_head_db TO <fs_xml_head>. ENDIF.
      IF sy-subrc <> 0. ASSIGN COMPONENT 'XML'          OF STRUCTURE ls_head_db TO <fs_xml_head>. ENDIF.
      IF sy-subrc = 0 AND <fs_xml_head> IS ASSIGNED.
        <fs_xml_head> = lv_xml_x.
      ENDIF.
    ENDIF.

    "=========================================
    " 3) Completar HEAD con atributos del XML
    "=========================================
    IF lv_xml_s IS NOT INITIAL.

      DATA lv_val TYPE string.

      " --- Comprobante ---
      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bVersion="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'VERSION' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bSerie="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'SERIE_XML' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bFolio="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'FOLIO_XML' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bLugarExpedicion="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'LUGAR_EXP' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bTipoDeComprobante="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'TIPO_COMP' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val(1). ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bSubTotal="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'SUBTOTAL' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bDescuento="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'DESCUENTO' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bTotal="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'TOTAL' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bMoneda="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'WAERS'     OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
        ASSIGN COMPONENT 'MONEDAXML' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bTipoCambio="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'TIPO_CAMBIO'   OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
        ASSIGN COMPONENT 'TIPOCAMBIOXML' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bMetodoPago="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'METODO_PAGO' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bFormaPago="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'FORMA_PAGO' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val(2). ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bExportacion="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'EXPORTACION' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      CLEAR lv_val.
      FIND REGEX '<cfdi:Comprobante[^>]*\bNoCertificado="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'NOCERTIFICADO' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      " Fecha del comprobante -> FECHAFACT + BLDAT/UZEIT
      DATA: lv_fecha_iso TYPE string,
            lv_y         TYPE string, lv_m TYPE string, lv_d TYPE string,
            lv_h         TYPE string, lv_n TYPE string, lv_s TYPE string,
            lv_bldat     TYPE string, lv_uzeit TYPE string.
      CLEAR: lv_fecha_iso, lv_y, lv_m, lv_d, lv_h, lv_n, lv_s, lv_bldat, lv_uzeit.
      FIND REGEX '<cfdi:Comprobante[^>]*\bFecha="([^"]+)"' IN lv_xml_s SUBMATCHES lv_fecha_iso.
      IF sy-subrc = 0 AND lv_fecha_iso IS NOT INITIAL.
        ASSIGN COMPONENT 'FECHAFACT' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_fecha_iso. ENDIF.
        FIND REGEX '([0-9]{4})(-?)([0-9]{2})(-?)([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})'
             IN lv_fecha_iso SUBMATCHES lv_y lv_m lv_d lv_h lv_n lv_s.
        IF sy-subrc = 0.
          CONCATENATE lv_y lv_m lv_d INTO lv_bldat.
          CONCATENATE lv_h lv_n lv_s INTO lv_uzeit.
          ASSIGN COMPONENT 'BLDAT' OF STRUCTURE ls_head_db TO <fh>.
          IF sy-subrc = 0. <fh> = lv_bldat. ENDIF.
          ASSIGN COMPONENT 'UZEIT' OF STRUCTURE ls_head_db TO <fh>.
          IF sy-subrc = 0. <fh> = lv_uzeit. ENDIF.
        ENDIF.
      ENDIF.

      " --- Receptor ---
      CLEAR lv_val.
      FIND REGEX '<cfdi:Receptor[^>]*\bRegimenFiscalReceptor="([^"]+)"' IN lv_xml_s SUBMATCHES lv_val.
      IF sy-subrc = 0 AND lv_val IS NOT INITIAL.
        ASSIGN COMPONENT 'REGIMENFISCALRECEPTOR' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_val. ENDIF.
      ENDIF.

      " --- TFD 1.1 ---
      DATA: lv_uuid            TYPE string,
            lv_sello_sat       TYPE string,
            lv_sello_cfd       TYPE string,
            lv_no_cert_sat     TYPE string,
            lv_rfc_prov_certif TYPE string,
            lv_fecha_tfd_raw   TYPE string,
            lv_fecha_tfd       TYPE string,
            lv_hora_tfd        TYPE string.

      FIND REGEX '<tfd:TimbreFiscalDigital[^>]*\bUUID="([^"]+)"' IN lv_xml_s SUBMATCHES lv_uuid.
      IF sy-subrc = 0 AND lv_uuid IS NOT INITIAL.
        ASSIGN COMPONENT 'UUID' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_uuid. ENDIF.
      ELSEIF iv_uuid IS NOT INITIAL.
        ASSIGN COMPONENT 'UUID' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = iv_uuid. ENDIF.
        lv_uuid = iv_uuid.
      ENDIF.

      FIND REGEX '<tfd:TimbreFiscalDigital[^>]*\bSelloSAT="([^"]+)"' IN lv_xml_s SUBMATCHES lv_sello_sat.
      IF sy-subrc = 0 AND lv_sello_sat IS NOT INITIAL.
        ASSIGN COMPONENT 'SELLO_SAT' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_sello_sat. ENDIF.
      ENDIF.

      FIND REGEX '<tfd:TimbreFiscalDigital[^>]*\bSelloCFD="([^"]+)"' IN lv_xml_s SUBMATCHES lv_sello_cfd.
      IF sy-subrc = 0 AND lv_sello_cfd IS NOT INITIAL.
        ASSIGN COMPONENT 'SELLO_CFD' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_sello_cfd. ENDIF.
      ENDIF.

      FIND REGEX '<tfd:TimbreFiscalDigital[^>]*\bNoCertificadoSAT="([^"]+)"' IN lv_xml_s SUBMATCHES lv_no_cert_sat.
      IF sy-subrc = 0 AND lv_no_cert_sat IS NOT INITIAL.
        ASSIGN COMPONENT 'NOCERTIFICADOSAT' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_no_cert_sat. ENDIF.
      ENDIF.

      FIND REGEX '<tfd:TimbreFiscalDigital[^>]*\bRfcProvCertif="([^"]+)"' IN lv_xml_s SUBMATCHES lv_rfc_prov_certif.
      IF sy-subrc = 0 AND lv_rfc_prov_certif IS NOT INITIAL.
        ASSIGN COMPONENT 'RFCPROVCERTIF' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_rfc_prov_certif. ENDIF.
      ENDIF.

      CLEAR: lv_fecha_tfd_raw, lv_y, lv_m, lv_d, lv_h, lv_n, lv_s, lv_fecha_tfd, lv_hora_tfd.
      FIND REGEX '<tfd:TimbreFiscalDigital[^>]*\bFechaTimbrado="([^"]+)"' IN lv_xml_s SUBMATCHES lv_fecha_tfd_raw.
      IF sy-subrc = 0 AND lv_fecha_tfd_raw IS NOT INITIAL.
        FIND REGEX '([0-9]{4})(-?)([0-9]{2})(-?)([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})'
             IN lv_fecha_tfd_raw SUBMATCHES lv_y lv_m lv_d lv_h lv_n lv_s.
        IF sy-subrc = 0.
          CONCATENATE lv_y lv_m lv_d INTO lv_fecha_tfd.
          CONCATENATE lv_h lv_n lv_s INTO lv_hora_tfd.
        ENDIF.
        ASSIGN COMPONENT 'FECHA_TIMBRADO' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0 AND lv_fecha_tfd IS NOT INITIAL. <fh> = lv_fecha_tfd. ENDIF.
        ASSIGN COMPONENT 'HORA_TIMBRADO'  OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0 AND lv_hora_tfd  IS NOT INITIAL. <fh> = lv_hora_tfd.  ENDIF.
        ASSIGN COMPONENT 'FECHATIMBRADOS' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_fecha_tfd_raw. ENDIF.
      ENDIF.

      " --- Cadena Original del TFD ---
      IF lv_uuid            IS NOT INITIAL AND
         lv_fecha_tfd_raw   IS NOT INITIAL AND
         lv_rfc_prov_certif IS NOT INITIAL AND
         lv_sello_cfd       IS NOT INITIAL AND
         lv_no_cert_sat     IS NOT INITIAL.

        DATA(lv_cadena) = '||1.1|' && lv_uuid && '|' &&
                           lv_fecha_tfd_raw && '|' &&
                           lv_rfc_prov_certif && '|' &&
                           lv_sello_cfd && '|' &&
                           lv_no_cert_sat && '||'.
        ASSIGN COMPONENT 'CADENA_ORIGINAL' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_cadena. ENDIF.
      ENDIF.

      "================================================================
      " 3.1) Construir URL QR SAT (formato oficial) y escribir en HEAD
      "================================================================
      DATA: lv_rfc_emisor   TYPE string,
            lv_rfc_receptor TYPE string,
            lv_total_df     TYPE decfloat34,
            lv_total_str    TYPE string,
            lv_int          TYPE string,
            lv_dec          TYPE string,
            lv_int10        TYPE string,
            lv_tt           TYPE string,
            lv_fe           TYPE string,
            lv_url          TYPE string,
            off10           TYPE i,
            off8            TYPE i.

      ASSIGN COMPONENT 'RFC_EMISOR'   OF STRUCTURE ls_head_db TO <fh>.
      IF sy-subrc = 0 AND <fh> IS ASSIGNED. lv_rfc_emisor   = CONV string( <fh> ). ENDIF.
      ASSIGN COMPONENT 'RFC_RECEPTOR' OF STRUCTURE ls_head_db TO <fh>.
      IF sy-subrc = 0 AND <fh> IS ASSIGNED. lv_rfc_receptor = CONV string( <fh> ). ENDIF.
      TRANSLATE lv_rfc_emisor   TO UPPER CASE.
      TRANSLATE lv_rfc_receptor TO UPPER CASE.

      CLEAR: lv_total_df, lv_total_str.
      ASSIGN COMPONENT 'TOTAL' OF STRUCTURE ls_head_db TO <fh>.
      IF sy-subrc = 0 AND <fh> IS ASSIGNED AND <fh> IS NOT INITIAL.
        TRY.
            lv_total_df = CONV decfloat34( <fh> ).
          CATCH cx_root.
            lv_total_str = CONV string( <fh> ).
            REPLACE ALL OCCURRENCES OF ',' IN lv_total_str WITH '.'.
            TRY. lv_total_df = lv_total_str. CATCH cx_root. lv_total_df = 0. ENDTRY.
        ENDTRY.
      ENDIF.

      lv_total_str = |{ lv_total_df DECIMALS = 6 }|.
      REPLACE ALL OCCURRENCES OF ',' IN lv_total_str WITH '.'.

      SPLIT lv_total_str AT '.' INTO lv_int lv_dec.
      IF lv_dec IS INITIAL. lv_dec = '000000'. ENDIF.
      WHILE strlen( lv_dec ) < 6.
        lv_dec = lv_dec && '0'.
      ENDWHILE.
      IF strlen( lv_dec ) > 6.
        lv_dec = lv_dec(6).
      ENDIF.

      " >>> CORRECCIÓN: subcadena dinámica (últimos 10)
      lv_int10 = lv_int.
      IF strlen( lv_int10 ) > 10.
        off10 = strlen( lv_int10 ) - 10.
        lv_int10 = lv_int10+off10(10).
      ENDIF.
      lv_int10 = |{ lv_int10 WIDTH = 10 ALIGN = RIGHT PAD = '0' }|.

      lv_tt = lv_int10 && '.' && lv_dec.

      " fe = últimos 8 de SelloCFD
      IF lv_sello_cfd IS INITIAL.
        ASSIGN COMPONENT 'SELLO_CFD' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0 AND <fh> IS ASSIGNED. lv_sello_cfd = CONV string( <fh> ). ENDIF.
      ENDIF.
      IF strlen( lv_sello_cfd ) >= 8.
        " >>> CORRECCIÓN: subcadena dinámica (últimos 8)
        off8 = strlen( lv_sello_cfd ) - 8.
        lv_fe = lv_sello_cfd+off8(8).
      ELSE.
        lv_fe = lv_sello_cfd.
      ENDIF.

      IF lv_uuid IS INITIAL.
        ASSIGN COMPONENT 'UUID' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0 AND <fh> IS ASSIGNED. lv_uuid = CONV string( <fh> ). ENDIF.
      ENDIF.

      IF lv_uuid IS NOT INITIAL AND
         lv_rfc_emisor IS NOT INITIAL AND
         lv_rfc_receptor IS NOT INITIAL AND
         lv_tt IS NOT INITIAL AND
         lv_fe IS NOT INITIAL.

        lv_url = |https://verificacfdi.facturaelectronica.sat.gob.mx/default.aspx?&id={ lv_uuid }| &&
                 |&re={ lv_rfc_emisor }&rr={ lv_rfc_receptor }&tt={ lv_tt }&fe={ lv_fe }|.

        ASSIGN COMPONENT 'QR' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = lv_url. ENDIF.
      ELSEIF iv_url IS NOT INITIAL.
        ASSIGN COMPONENT 'QR' OF STRUCTURE ls_head_db TO <fh>.
        IF sy-subrc = 0. <fh> = iv_url. ENDIF.
      ENDIF.

    ENDIF. " fin parseo XML + armado QR

    " Estatus mínimos
    IF ls_head_db-uuid IS INITIAL AND iv_uuid IS NOT INITIAL.
      ASSIGN COMPONENT 'UUID' OF STRUCTURE ls_head_db TO <fh>.
      IF sy-subrc = 0. <fh> = iv_uuid. ENDIF.
    ENDIF.
    ls_head_db-fecha_timbrado = sy-datum.
    ls_head_db-hora_timbrado  = sy-uzeit.
    ls_head_db-status         = COND char1( WHEN ls_head_db-uuid IS INITIAL THEN 'E' ELSE 'T' ).

    "=========================================
    " 4) Persistencia del HEADER
    "=========================================
    MODIFY zcfdi_head_40 FROM ls_head_db.

    "=========================================
    " 5) Persistencia del DETALLE desde MT_DET
    "=========================================
    DELETE FROM zcfdi_det_40
      WHERE bukrs = ls_head_db-bukrs
        AND belnr = ls_head_db-belnr
        AND gjahr = ls_head_db-gjahr.

    LOOP AT mt_det ASSIGNING <d>.
      CLEAR ls_det_db.
      ls_det_db = CORRESPONDING zcfdi_det_40( <d> ).

      IF ls_det_db-mandt IS INITIAL. ls_det_db-mandt = sy-mandt.         ENDIF.
      IF ls_det_db-bukrs IS INITIAL. ls_det_db-bukrs = ls_head_db-bukrs. ENDIF.
      IF ls_det_db-belnr IS INITIAL. ls_det_db-belnr = ls_head_db-belnr. ENDIF.
      IF ls_det_db-gjahr IS INITIAL. ls_det_db-gjahr = ls_head_db-gjahr. ENDIF.

      ASSIGN COMPONENT 'BUZEI' OF STRUCTURE ls_det_db TO <fs_buzei>.
      IF sy-subrc = 0 AND <fs_buzei> IS INITIAL.
        ASSIGN COMPONENT 'POSNR' OF STRUCTURE <d> TO <src_posnr>.
        IF sy-subrc = 0 AND <src_posnr> IS ASSIGNED.
          <fs_buzei> = <src_posnr>.
        ENDIF.
      ENDIF.

      INSERT zcfdi_det_40 FROM ls_det_db.
    ENDLOOP.

  ENDMETHOD.


