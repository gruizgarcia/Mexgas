CLASS ZCL_CFDI40_NAST IMPLEMENTATION.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->ADD_ATTR
* +-------------------------------------------------------------------------------------------------+
* | [--->] I_NAME                         TYPE        STRING
* | [--->] I_VAL                          TYPE        STRING
* | [<-->] CV_ATTR                        TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD add_attr.

    DATA: v   TYPE string,
          par TYPE string.

    v = me->trim( i_val ).
    IF v IS INITIAL.
      RETURN.
    ENDIF.

    CONCATENATE i_name '="' v '"' INTO par.

    IF cv_attr IS INITIAL.
      cv_attr = par.
    ELSE.
      CONCATENATE cv_attr par INTO cv_attr SEPARATED BY space.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->APPEND_LINE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_LINE                        TYPE        STRING
* | [<-->] CT_XML                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD append_line.
    ct_xml = ct_xml && iv_line && cl_abap_char_utilities=>newline.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_CFDI40_NAST->BUILD_CABECERA
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEAD                        TYPE        ZET_HEAD_40
* | [<-->] CT_XML                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD build_cabecera.

    DATA: lv_attr      TYPE string,
          lv_fecha     TYPE string,
          lv_metpag    TYPE string,
          lv_usocfdi   TYPE string,
          lv_nombre    TYPE string,
          lv_regfiscal TYPE string,
          lv_domfiscal TYPE string.


    CLEAR: lv_attr.

    " Formato correcto de fecha CFDI 4.0 → AAAA-MM-DDThh:mm:ss
    lv_fecha = |{ sy-datum+0(4) }-{ sy-datum+4(2) }-{ sy-datum+6(2) }T{ sy-uzeit+0(2) }:{ sy-uzeit+2(2) }:{ sy-uzeit+4(2) }|.



    me->recuperar_datos_cfdi_receptor(
      EXPORTING
        iv_kunnr   = is_head-kunnr
      IMPORTING
        ev_metpag  = lv_metpag
        ev_usocfdi = lv_usocfdi
        ev_nombre  = lv_nombre
        ev_regfiscal =  lv_regfiscal
        ev_domfiscal = lv_domfiscal
    ).


*  " Validar folio
*  IF is_head-folio_xml IS INITIAL.
*    is_head-folio_xml = |SIN_ID_{ sy-datum }|.
*  ENDIF.

    " Atributos del nodo <cfdi:Comprobante>
    me->add_attr( EXPORTING i_name = 'xsi:schemaLocation'
                            i_val  = 'http://www.sat.gob.mx/cfd/4 http://www.sat.gob.mx/sitio_internet/cfd/4/cfdv40.xsd'
                            CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'xmlns:xsi'         i_val = 'http://www.w3.org/2001/XMLSchema-instance' CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'xmlns:cfdi'        i_val = 'http://www.sat.gob.mx/cfd/4'                CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Fecha'             i_val = lv_fecha                                    CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'MetodoPago'        i_val = CONV string( is_head-metodo_pago )          CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Exportacion'       i_val = CONV string( is_head-exportacion )          CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'TipoDeComprobante' i_val = CONV string( is_head-tipo_comp )            CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Serie'             i_val = CONV string( is_head-serie_xml )            CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Folio'             i_val = CONV string( is_head-folio_xml )            CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'SubTotal'          i_val = |{ is_head-subtotal DECIMALS = 2 }|         CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Total'             i_val = |{ is_head-total DECIMALS = 2 }|            CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Moneda'            i_val = CONV string( is_head-waers )                CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'TipoCambio'        i_val = |{ is_head-tipo_cambio DECIMALS = 5 }|      CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'LugarExpedicion'   i_val = CONV string( is_head-lugar_exp )            CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Version'           i_val = '4.0'                                        CHANGING cv_attr = lv_attr ).

    " Abrir nodo <cfdi:Comprobante>
    me->append_line( EXPORTING iv_line = |<cfdi:Comprobante { lv_attr }>| && '>' CHANGING ct_xml = ct_xml ).



    " Nodo <cfdi:Emisor>
    CLEAR lv_attr.
    me->add_attr( EXPORTING i_name = 'Nombre'        i_val = CONV string( is_head-nombre_emisor ) CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Rfc'           i_val = CONV string( is_head-rfc_emisor )    CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'RegimenFiscal' i_val = CONV string( is_head-regimen_fiscal ) CHANGING cv_attr = lv_attr ).
    me->append_line( EXPORTING iv_line = |<cfdi:Emisor { lv_attr }>| && '>' CHANGING ct_xml = ct_xml ).
    me->append_line( EXPORTING iv_line = '</cfdi:Emisor>' CHANGING ct_xml = ct_xml ).

    " Nodo <cfdi:Receptor>
    CLEAR lv_attr.
    me->add_attr( EXPORTING i_name = 'Nombre'                   i_val = CONV string( lv_nombre ) CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'Rfc'                      i_val = CONV string( is_head-rfc_receptor )    CHANGING cv_attr = lv_attr ).
    me->add_attr( EXPORTING i_name = 'RegimenFiscalReceptor'   i_val = CONV string( lv_regfiscal )  CHANGING cv_attr = lv_attr ).
    DATA(lv_lugar_exp) = |{ CONV i( is_head-lugar_exp ) }|.
    me->add_attr( EXPORTING i_name = 'DomicilioFiscalReceptor' i_val = lv_domfiscal      CHANGING cv_attr = lv_attr ).


    me->add_attr( EXPORTING i_name = 'UsoCFDI'                 i_val = CONV string( lv_usocfdi )         CHANGING cv_attr = lv_attr ).
    me->append_line( EXPORTING iv_line = |<cfdi:Receptor { lv_attr }>| && '>' CHANGING ct_xml = ct_xml ).
    me->append_line( EXPORTING iv_line = '</cfdi:Receptor>' CHANGING ct_xml = ct_xml ).

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_CFDI40_NAST->BUILD_CONCEPTOS
* +-------------------------------------------------------------------------------------------------+
* | [<-->] CT_XML                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD build_conceptos.
    CONSTANTS:
              c_01(2) VALUE '01',
              c_02(2) VALUE '02'.

    DATA: lt_conver TYPE STANDARD TABLE OF zequival_40,
          lw_conver TYPE zequival_40,
          lv_attr   TYPE string,
          objetoimp TYPE string.

    FIELD-SYMBOLS: <fs_det> TYPE zet_det_mgs.

    " Recuperar equivalencias
    SELECT * FROM zequival_40 INTO CORRESPONDING FIELDS OF TABLE lt_conver.
    IF lt_conver IS INITIAL OR mt_det IS INITIAL.
      RETURN.
    ENDIF.

    SORT lt_conver BY zmaterial.

    " Abrir nodo <cfdi:Conceptos>
    me->append_line( EXPORTING iv_line = '<cfdi:Conceptos>' CHANGING ct_xml = ct_xml ).

    LOOP AT mt_det ASSIGNING <fs_det>.
      CLEAR lv_attr.

      " Buscar equivalencia por material
      READ TABLE lt_conver INTO lw_conver WITH KEY zmaterial = <fs_det>-prod_eka BINARY SEARCH.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      " Atributos del concepto
      me->add_attr( EXPORTING i_name = 'ClaveProdServ'   i_val = CONV string( lw_conver-clave_sat )     CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'Cantidad'        i_val = |{ <fs_det>-cantidad DECIMALS = 2 }|   CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'ClaveUnidad'     i_val = CONV string( lw_conver-unidad_sat )    CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'Descripcion'     i_val = CONV string( lw_conver-descrip )       CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'ValorUnitario'   i_val = |{ <fs_det>-valor_unit DECIMALS = 2 }| CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'Importe'         i_val = |{ <fs_det>-valor_unit * <fs_det>-cantidad DECIMALS = 2 }| CHANGING cv_attr = lv_attr ).
      IF <fs_det>-importe_iva > 0.
        CLEAR objetoimp.
        objetoimp = c_02.
      ELSE.
        objetoimp = c_01.
      ENDIF.

      me->add_attr( EXPORTING i_name = 'ObjetoImp'       i_val = objetoimp CHANGING cv_attr = lv_attr ).

      " Abrir nodo <cfdi:Concepto>
      me->append_line( EXPORTING iv_line = |<cfdi:Concepto { lv_attr }>| && '>' CHANGING ct_xml = ct_xml ).

      " Nodo <cfdi:Impuestos> por concepto
      me->append_line( EXPORTING iv_line = '<cfdi:Impuestos>' CHANGING ct_xml = ct_xml ).
      me->append_line( EXPORTING iv_line = '<cfdi:Traslados>' CHANGING ct_xml = ct_xml ).

      CLEAR lv_attr.
      me->add_attr( EXPORTING i_name = 'Base'        i_val = |{ <fs_det>-importe_iva DECIMALS = 2 }| CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'Impuesto'    i_val = '002' CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'TipoFactor'  i_val = 'Tasa' CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'TasaOCuota'  i_val = '0.160000' CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'Importe'     i_val = |{ <fs_det>-importe_iva DECIMALS = 2 }| CHANGING cv_attr = lv_attr ).

      me->empty_attr( EXPORTING iv_tag = 'cfdi:Traslado' iv_attr = lv_attr CHANGING ct_xml = ct_xml ).

      me->append_line( EXPORTING iv_line = '</cfdi:Traslados>' CHANGING ct_xml = ct_xml ).
      me->append_line( EXPORTING iv_line = '</cfdi:Impuestos>' CHANGING ct_xml = ct_xml ).

      " Cierre del concepto
      me->append_line( EXPORTING iv_line = '</cfdi:Concepto>' CHANGING ct_xml = ct_xml ).
    ENDLOOP.

    " Cierre nodo <cfdi:Conceptos>
    me->append_line( EXPORTING iv_line = '</cfdi:Conceptos>' CHANGING ct_xml = ct_xml ).

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_CFDI40_NAST->BUILD_IMPUESTOS_TOTALES
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEAD                        TYPE        ZET_HEAD_40
* | [--->] IV_VERSION                     TYPE        CHAR4
* | [<-->] CT_XML                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD build_impuestos_totales.

    DATA: lv_attr    TYPE string,
          lv_importe TYPE string,
          lv_base    TYPE string.

    CLEAR: lv_attr, lv_importe, lv_base.

    " Validar que haya impuestos trasladados
    IF iv_version = '4.0' AND is_head-total_iva > 0.

      " TotalImpuestosTrasladados
      lv_importe = |{ is_head-total_iva DECIMALS = 2 }|.
      me->add_attr( EXPORTING i_name = 'TotalImpuestosTrasladados'
                              i_val  = lv_importe
                              CHANGING cv_attr = lv_attr ).

      " Abrir nodo <cfdi:Impuestos>
      me->append_line( EXPORTING iv_line = |<cfdi:Impuestos { lv_attr }>| && '>' CHANGING ct_xml = ct_xml ).

      " Nodo <cfdi:Traslados>
      me->append_line( EXPORTING iv_line = '<cfdi:Traslados>' CHANGING ct_xml = ct_xml ).

      " Atributos del traslado
      lv_base = |{ is_head-subtotal DECIMALS = 2 }|.

      CLEAR lv_attr.
      me->add_attr( EXPORTING i_name = 'Base'        i_val = lv_base      CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'Impuesto'    i_val = '002'        CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'TipoFactor'  i_val = 'Tasa'       CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'TasaOCuota'  i_val = '0.160000'   CHANGING cv_attr = lv_attr ).
      me->add_attr( EXPORTING i_name = 'Importe'     i_val = lv_importe   CHANGING cv_attr = lv_attr ).

      " Nodo vacío <cfdi:Traslado ... />
      me->empty_attr( EXPORTING iv_tag = 'cfdi:Traslado' iv_attr = lv_attr CHANGING ct_xml = ct_xml ).

      " Cierre de nodos
      me->append_line( EXPORTING iv_line = '</cfdi:Traslados>' CHANGING ct_xml = ct_xml ).
      me->append_line( EXPORTING iv_line = '</cfdi:Impuestos>' CHANGING ct_xml = ct_xml ).

    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->BUILD_XML
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_HEAD                        TYPE        ZET_HEAD_40
* | [<-()] RV_XML                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD build_xml.

    DATA: lv_xml  TYPE string,
          ls_head TYPE zet_head_40.

    " Copiar datos para validación
    ls_head = is_head.

    " Validar folio
    IF ls_head-folio_xml IS INITIAL.
*      ls_head-folio_xml = |SIN_FOLIO_{ sy-datum }|.
      ls_head-folio_xml = |SIN_ID_{ sy-datum }_{ sy-uname }|.
    ENDIF.

    " Cabecera
    me->build_cabecera(
      EXPORTING is_head = ls_head
      CHANGING  ct_xml  = lv_xml
    ).

    " Conceptos
    me->build_conceptos( CHANGING ct_xml = lv_xml ).

    " Impuestos totales
    me->build_impuestos_totales(
      EXPORTING
        is_head    = ls_head
        iv_version = '4.0'
      CHANGING
        ct_xml     = lv_xml
    ).

    " Cierre del comprobante
    me->append_line( EXPORTING iv_line = '</cfdi:Comprobante>' CHANGING ct_xml = lv_xml ).

    " Retornar XML completo
    me->sanitizar_xml_final( CHANGING ct_xml = lv_xml ).

    rv_xml = lv_xml.

  ENDMETHOD.


