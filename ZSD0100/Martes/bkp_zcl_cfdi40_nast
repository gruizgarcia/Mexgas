    METHODS constructor .
    METHODS TimbrarXml 
    IMPORTING
        !is_head      TYPE zet_head_40.
    
    METHODS sanitizar_xml_final
      CHANGING
        !ct_xml TYPE string .
    METHODS set_data
      IMPORTING
