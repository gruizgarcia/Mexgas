* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->GET_XML_SAT_SAP
* +-------------------------------------------------------------------------------------------------+
* | [--->] T_HEAD_CFDI                    TYPE        ZST_HEAD_40
* | [--->] T_DET_CFDI                     TYPE        ZST_DET_40
* | [--->] I_ADDENDA                      TYPE        CHAR1
* | [--->] I_PEDIDO                       TYPE        VBELN_VA
* | [<---] E_UUID                         TYPE        ZUUID
* | [<---] E_ERROR                        TYPE        STRING
* | [<---] E_URL                          TYPE        ZQR40
* | [<-->] PO_LOGGER                      TYPE REF TO ZCL_LOGGER(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_xml_sat_sap.
    " Inicialización de valores
    CLEAR: e_uuid, e_error, e_url.

    " Validación básica
    IF t_head_cfdi IS INITIAL OR t_det_cfdi IS INITIAL.
      e_error = 'Datos CFDI incompletos'.
      RETURN.
    ENDIF.

    " Cargar datos en atributos internos
    me->set_data(
      EXPORTING
      t_head_cfdi = t_head_cfdi
      t_det_cfdi  = t_det_cfdi

      i_pedido    = i_pedido
    ).

    " Generar XML y obtener UUID/URL
    TRY.
        me->generate(
          IMPORTING
            e_uuid = e_uuid
            e_url  = e_url
        ).
      CATCH cx_sy_conversion_error INTO DATA(lx_error).
        e_error = lx_error->get_text( ).
    ENDTRY.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->OPEN_TAG
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_TAG                         TYPE        STRING
* | [--->] IV_ATTR                        TYPE        STRING
* | [<-->] CT_XML                         TYPE        ANY TABLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD open_tag.
    DATA lv TYPE string.
    DATA la TYPE string.
    la = me->trim( iv_attr ).
    CONCATENATE '<' iv_tag INTO lv.
    IF la IS NOT INITIAL.
      CONCATENATE lv la INTO lv SEPARATED BY space.
    ENDIF.
    CONCATENATE lv '>' INTO lv.
*    me->append_line( EXPORTING iv_line = lv CHANGING ct_xml = ct_xml ).
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->RECUPERAR_DATOS_CFDI_RECEPTOR
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_KUNNR                       TYPE        KUNNR
* | [<---] EV_METPAG                      TYPE        STRING
* | [<---] EV_USOCFDI                     TYPE        STRING
* | [<---] EV_NOMBRE                      TYPE        STRING
* | [<---] EV_REGFISCAL                   TYPE        STRING
* | [<---] EV_DOMFISCAL                   TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD recuperar_datos_cfdi_receptor.


    DATA: lv_zterm   TYPE knvv-zterm,
          lv_katr6   TYPE kna1-katr6,
          lv_name1   TYPE kna1-name1,
          lv_pstlz   TYPE kna1-pstlz,
          lv_usocfdi TYPE knvv-kvgr1.

    " Recuperar método de pago desde KNVV
    SELECT SINGLE zterm kvgr1
      INTO (lv_zterm  , lv_usocfdi)
      FROM knvv
      WHERE kunnr = iv_kunnr.

    " Recuperar uso CFDI y nombre desde KNA1
    SELECT SINGLE pstlz katr6 name1
      INTO (lv_pstlz , lv_katr6, lv_name1)
      FROM kna1
      WHERE kunnr = iv_kunnr.



    " Asignar resultados
    ev_metpag    = lv_zterm.
    ev_usocfdi   = lv_usocfdi.
    ev_nombre    = lv_name1.
    ev_regfiscal = lv_katr6.
    ev_domfiscal = lv_pstlz.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->SANITIZAR_XML_FINAL
* +-------------------------------------------------------------------------------------------------+
* | [<-->] CT_XML                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD sanitizar_xml_final.

    " Elimina cierres duplicados como >> que pueden invalidar el XML
    REPLACE ALL OCCURRENCES OF '>>' IN ct_xml WITH '>'.

    " Elimina espacios innecesarios antes de cierre de etiquetas
    REPLACE ALL OCCURRENCES OF ' >' IN ct_xml WITH '>'.

    " Opcional: eliminar saltos de línea dobles si el PAC lo requiere
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>newline && cl_abap_char_utilities=>newline
      IN ct_xml WITH cl_abap_char_utilities=>newline.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->SET_DATA
* +-------------------------------------------------------------------------------------------------+
* | [--->] T_HEAD_CFDI                    TYPE        ZST_HEAD_40
* | [--->] T_DET_CFDI                     TYPE        ZST_DET_40
* | [--->] I_PEDIDO                       TYPE        VBELN_VA
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD set_data.
    mt_head    = t_head_cfdi.
*    mt_det     = t_det_cfdi.
    mt_det = VALUE #( FOR ls IN t_det_cfdi
                  ( CORRESPONDING zet_det_mgs( ls ) ) ).
    mv_pedido  = i_pedido.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_CFDI40_NAST->TRIM
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_TEXT                        TYPE        ANY
* | [<-()] RV_TEXT                        TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD trim.
    DATA lv TYPE string.
    lv = iv_text.
    SHIFT lv LEFT  DELETING LEADING space.
    SHIFT lv RIGHT DELETING TRAILING space.
    rv_text = lv.
  ENDMETHOD.
ENDCLASS.